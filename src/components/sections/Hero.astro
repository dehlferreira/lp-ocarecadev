---
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import heroPerfil from "../../assets/images/hero-perfil.webp";
---

<section
  id="hero"
  class="hero-section section-fade-bottom"
  style="--fade-to: #050709;"
>
  <!-- Efeitos de Luz de Fundo Neon -->
  <div class="neon-light light-1"></div>
  <div class="neon-light light-2"></div>

  <!-- Grade Tecnológica Sutil no Background (Estilo Linear/Vercel) -->
  <div class="hero-tech-grid" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-content">
      <!-- Pill Badge de Status (Estilo Raycast/Vercel) -->
      <div class="hero-badge" id="hero-badge">
        <span class="badge-pulse">
          <span class="pulse-dot"></span>
          <span class="pulse-ring"></span>
        </span>
        <span class="badge-text">Disponível para novos projetos</span>
        <span class="badge-separator" aria-hidden="true">•</span>
        <span class="badge-highlight">Alta Conversão</span>
      </div>

      <h1 class="hero-title" id="hero-title">
        Seu site não precisa só ser bonito.
        Precisa fazer o visitante <span class="text-neon">agir</span>
      </h1>
      <p class="hero-subtitle" id="hero-subtitle">
        Landing pages estratégicas para apresentar sua oferta com clareza, gerar interesse e levar mais pessoas até o seu WhatsApp.
      </p>
      <div class="hero-ctas" id="hero-ctas">
        <Button
          type="primary"
          href="#pricing"
          id="btn-hero-primary"
          class="btn-large btn-cta-primary"
          data-track-event="select_content"
          data-track-location="hero_primary"
          data-track-item="cta_quero_landing_page"
        >
          <span>Quero uma landing page para meu negócio</span>
          <svg
            class="cta-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </Button>
        <Button
          type="ghost"
          href="#como-funciona"
          class="btn-large btn-cta-ghost"
          data-track-event="select_content"
          data-track-location="hero_secondary"
          data-track-item="cta_ver_como_funciona"
        >
          <svg
            class="cta-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle><polygon
              points="10 8 16 12 10 16 10 8"
              fill="currentColor"
              stroke="none"></polygon>
          </svg>
          <span>Ver como funciona</span>
        </Button>
      </div>
    </div>
    <div class="hero-visual" id="hero-image">
      <div class="hero-visual-wrapper">
        <!-- Aura de iluminação sutil atrás do perfil -->
        <div class="hero-img-aura" aria-hidden="true"></div>

        <Image
          src={heroPerfil}
          alt="André, especialista em Landing Pages"
          class="hero-img"
          widths={[380, 560, 760, 1120]}
          sizes="(max-width: 767px) 380px, (max-width: 1024px) 500px, 560px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Micro-Card Flutuante 1: PageSpeed (Estilo Stripe/Fintech) -->
        <div class="hero-float-badge badge-speed" aria-hidden="true">
          <div class="float-icon-box speed-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="float-svg">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div class="float-info">
            <span class="float-num">100/100</span>
            <span class="float-label">PageSpeed Mobile</span>
          </div>
        </div>

        <!-- Micro-Card Flutuante 2: Conversão WhatsApp -->
        <div class="hero-float-badge badge-conversion" aria-hidden="true">
          <div class="float-icon-box conv-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="float-svg">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
          </div>
          <div class="float-info">
            <span class="float-num">+42%</span>
            <span class="float-label">Mais Cliques no Whats</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100svh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem 0 2rem;
    overflow: hidden;
    background-color: #010101;

    /* Scroll-driven dissolve defaults (opacity + transform only) */
    --hero-opacity: 1;
    --hero-scale: 1;
    --hero-translate-y: 0px;
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    /* Dissolve — driven by JS custom properties (compositor-only) */
    opacity: var(--hero-opacity);
    transform: scale(var(--hero-scale)) translateY(var(--hero-translate-y));
    will-change: opacity, transform;
    transform-origin: center top;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 7rem 0 3rem;
    }
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Textos */
  .hero-content {
    text-align: left;
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.25rem;
      line-height: 1.08;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  .text-gradient {
    color: transparent;
    background-image: linear-gradient(
      to right,
      var(--color-primary-neon),
      #00a666
    );
    background-clip: text;
    -webkit-background-clip: text;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
    max-width: 500px;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: 1.15rem;
    }
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  /* Ícones dentro dos CTAs */
  .hero-ctas :global(.btn) {
    gap: 0.6rem;
  }

  .hero-ctas :global(.cta-icon) {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  /* Micro-interação: seta desliza ao passar o mouse */
  .hero-ctas :global(.btn-cta-primary .cta-icon) {
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .hero-ctas :global(.btn-cta-primary:hover .cta-icon) {
    transform: translateX(5px);
  }

  /* Ícone "play" cresce levemente no hover */
  .hero-ctas :global(.btn-cta-ghost .cta-icon) {
    color: var(--color-primary-neon);
    transition: transform 0.3s ease;
  }

  .hero-ctas :global(.btn-cta-ghost:hover .cta-icon) {
    transform: scale(1.12);
  }

  /* Mobile: botões full-width e alinhados (tap targets maiores) */
  @media (max-width: 767px) {
    .hero-ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .hero-ctas :global(.btn) {
      width: 100%;
    }
    .hero-ctas :global(.btn-large) {
      font-size: 0.9375rem !important;
      padding: 11px 20px !important;
    }
  }

  :global(.btn-large) {
    font-size: 1rem !important;
    padding: 13px 24px !important;
  }

  @media (min-width: 768px) {
    :global(.btn-large) {
      font-size: 1.125rem !important;
      padding: 16px 32px !important;
    }
  }

  /* Imagem visual e Wrapper para micro-cards */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
    display: flex;
    justify-content: center;
  }

  .hero-img {
    width: 100%;
    height: auto;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 16px 36px rgba(0, 0, 0, 0.65));
    -webkit-mask-image: linear-gradient(to bottom, #000000 80%, rgba(0, 0, 0, 0.45) 92%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000000 80%, rgba(0, 0, 0, 0.45) 92%, transparent 100%);
  }

  /* Aura de luz esmeralda orgânica atrás da foto */
  .hero-img-aura {
    position: absolute;
    top: 18%;
    left: 15%;
    right: 15%;
    bottom: 15%;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.25) 0%, rgba(0, 166, 102, 0.08) 55%, transparent 75%);
    filter: blur(52px);
    border-radius: 50%;
    z-index: 1;
    pointer-events: none;
    animation: aura-glow 6s ease-in-out infinite alternate;
  }

  @keyframes aura-glow {
    0% {
      opacity: 0.6;
      transform: scale(0.94);
    }
    100% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  /* ─── Micro-Cards Flutuantes de Autoridade (Estilo Stripe/Fintech) ─── */
  .hero-float-badge {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.9rem;
    background: rgba(11, 15, 23, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 16px 32px -6px rgba(0, 0, 0, 0.75), 0 0 24px -2px rgba(0, 255, 157, 0.14);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: none;
    user-select: none;
  }

  .float-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    flex-shrink: 0;
  }

  .speed-box {
    background: rgba(0, 255, 157, 0.14);
    color: var(--color-primary-neon);
    border: 1px solid rgba(0, 255, 157, 0.3);
  }

  .conv-box {
    background: rgba(56, 189, 248, 0.14);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .float-svg {
    width: 17px;
    height: 17px;
  }

  .float-info {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .float-num {
    font-size: 0.9375rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .float-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* Posicionamento no Desktop com elevação sutil */
  @media (min-width: 768px) {
    .badge-speed {
      top: 10%;
      right: -12px;
      animation: float-card-speed 6s ease-in-out infinite alternate;
    }

    .badge-conversion {
      bottom: 12%;
      left: -18px;
      animation: float-card-conv 7.5s ease-in-out infinite alternate;
    }
  }

  @media (min-width: 1024px) {
    .badge-speed {
      top: 12%;
      right: -24px;
    }

    .badge-conversion {
      bottom: 14%;
      left: -28px;
    }
  }

  /* Mobile: fixar dentro dos limites da imagem para estabilidade de layout (G3) */
  @media (max-width: 767px) {
    .hero-float-badge {
      padding: 0.42rem 0.68rem;
      gap: 0.5rem;
      border-radius: 11px;
    }

    .float-icon-box {
      width: 26px;
      height: 26px;
    }

    .float-svg {
      width: 14px;
      height: 14px;
    }

    .float-num {
      font-size: 0.8125rem;
    }

    .float-label {
      font-size: 0.625rem;
    }

    .badge-speed {
      top: 12px;
      right: 8px;
      animation: float-card-speed 6s ease-in-out infinite alternate;
    }

    .badge-conversion {
      bottom: 14px;
      left: 8px;
      animation: float-card-conv 7.5s ease-in-out infinite alternate;
    }
  }

  @keyframes float-card-speed {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(-8px) rotate(0.6deg);
    }
  }

  @keyframes float-card-conv {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(8px) rotate(-0.6deg);
    }
  }

  /* ─── Pill Badge com Neon Pulse (Estilo Raycast/Vercel) ─── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
    border-radius: 9999px;
    background: rgba(0, 255, 157, 0.05);
    border: 1px solid rgba(0, 255, 157, 0.22);
    box-shadow: 0 0 20px -4px rgba(0, 255, 157, 0.18), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    width: fit-content;
  }

  @media (hover: hover) {
    .hero-badge:hover {
      border-color: rgba(0, 255, 157, 0.45);
      box-shadow: 0 0 26px -2px rgba(0, 255, 157, 0.32), inset 0 1px 1px rgba(255, 255, 255, 0.2);
      transform: translateY(-1px);
    }
  }

  .badge-pulse {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-primary-neon);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-primary-neon);
  }

  .pulse-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background-color: var(--color-primary-neon);
    opacity: 0.7;
    animation: badge-ring-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes badge-ring-ping {
    0% {
      transform: scale(0.8);
      opacity: 0.8;
    }
    70%, 100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }

  .badge-text {
    color: #e6edf3;
    letter-spacing: -0.01em;
  }

  .badge-separator {
    color: rgba(255, 255, 255, 0.25);
    font-size: 0.7rem;
  }

  .badge-highlight {
    color: var(--color-primary-neon);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* ─── Destaque no texto "agir" ─── */
  .hero-title .text-neon {
    position: relative;
    display: inline-block;
    text-shadow: 0 0 20px rgba(0, 255, 157, 0.45), 0 0 40px rgba(0, 255, 157, 0.2);
    animation: text-neon-pulse 4s ease-in-out infinite alternate;
  }

  @keyframes text-neon-pulse {
    0% {
      text-shadow: 0 0 16px rgba(0, 255, 157, 0.35), 0 0 32px rgba(0, 255, 157, 0.15);
    }
    100% {
      text-shadow: 0 0 28px rgba(0, 255, 157, 0.65), 0 0 54px rgba(0, 255, 157, 0.3);
    }
  }

  /* ─── Tech Grid de Background (Estilo Linear/Supabase) ─── */
  .hero-tech-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.032) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.032) 1px, transparent 1px);
    background-size: 32px 32px;
    mask-image: radial-gradient(ellipse 65% 55% at 50% 35%, black 20%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 65% 55% at 50% 35%, black 20%, transparent 85%);
    pointer-events: none;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .hero-tech-grid {
      background-size: 44px 44px;
      background-image:
        linear-gradient(to right, rgba(255, 255, 255, 0.038) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.038) 1px, transparent 1px);
    }
  }

  /* Efeitos de Luz */
  .neon-light {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: screen;
    filter: blur(128px);
    opacity: 0.2;
    z-index: 1;
    transition: translate 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Mobile: simplifica luzes neon para economizar GPU */
  @media (max-width: 767px) {
    .neon-light {
      filter: blur(60px);
      animation: none !important;
      opacity: 0.1;
      translate: none;
    }
  }

  .light-1 {
    top: -10%;
    left: -10%;
    width: 500px;
    height: 500px;
    background-color: var(--color-primary-neon);
    translate: calc(var(--mouse-x) * -100px) calc(var(--mouse-y) * -100px);
    animation: float-neon 12s ease-in-out infinite alternate;
  }

  .light-2 {
    top: 5%;
    left: 5%;
    width: 400px;
    height: 400px;
    background-color: #00a666;
    translate: calc(var(--mouse-x) * 100px) calc(var(--mouse-y) * 100px);
    animation: float-neon 15s ease-in-out infinite alternate-reverse;
  }

  @keyframes float-neon {
    0% {
      transform: scale(1) translate(0, 0);
    }
    50% {
      transform: scale(1.2) translate(100px, -100px);
    }
    100% {
      transform: scale(0.8) translate(-100px, 100px);
    }
  }

  /* Respeito estrito a Acessibilidade e Movimento Reduzido (G2) */
  @media (prefers-reduced-motion: reduce) {
    .hero-img-aura,
    .badge-speed,
    .badge-conversion,
    .pulse-ring,
    .hero-title .text-neon,
    .light-1,
    .light-2 {
      animation: none !important;
    }
    .pulse-ring {
      display: none;
    }
  }
</style>
