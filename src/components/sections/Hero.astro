---
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import heroPerfil from "../../assets/images/hero-perfil-v2.webp";
---

<section
  id="hero"
  class="hero-section section-fade-bottom"
  style="--fade-to: #050709;"
>
  <!-- Spotlight Beam no topo da Hero (iluminação focal premium estilo Vercel/Linear) -->
  <div class="hero-spotlight" aria-hidden="true"></div>

  <!-- Aurora Tech Mesh Glow (Luzes Esmeralda Orgânicas) -->
  <div class="aurora-mesh" aria-hidden="true">
    <div class="aurora-orb orb-1"></div>
    <div class="aurora-orb orb-2"></div>
    <div class="aurora-orb orb-3"></div>
  </div>

  <!-- Matriz Tecnológica de Micropontos no Background -->
  <div class="hero-tech-grid" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-content">
      <!-- Pill Badge de Status (Estilo Raycast/Vercel) -->
      <div class="hero-badge" id="hero-badge">
        <span class="badge-pulse">
          <span class="pulse-dot"></span>
          <span class="pulse-ring"></span>
        </span>
        <span class="badge-text">Disponível para novos projetos</span>
        <span class="badge-separator" aria-hidden="true">•</span>
        <span class="badge-highlight">Alta Conversão</span>
      </div>

      <h1 class="hero-title" id="hero-title">
        Seu site não precisa só ser bonito.
        Precisa fazer o visitante <span class="text-neon">agir</span>
      </h1>
      <p class="hero-subtitle" id="hero-subtitle">
        Landing pages estratégicas para apresentar sua oferta com clareza, gerar interesse e levar mais pessoas até o seu WhatsApp.
      </p>
      <div class="hero-ctas" id="hero-ctas">
        <Button
          type="primary"
          href="#pricing"
          id="btn-hero-primary"
          class="btn-large btn-cta-primary"
          data-track-event="select_content"
          data-track-location="hero_primary"
          data-track-item="cta_quero_landing_page"
        >
          <span>Quero uma landing page para meu negócio</span>
          <svg
            class="cta-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </Button>
        <Button
          type="ghost"
          href="#como-funciona"
          class="btn-large btn-cta-ghost"
          data-track-event="select_content"
          data-track-location="hero_secondary"
          data-track-item="cta_ver_como_funciona"
        >
          <svg
            class="cta-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"></circle><polygon
              points="10 8 16 12 10 16 10 8"
              fill="currentColor"
              stroke="none"></polygon>
          </svg>
          <span>Ver como funciona</span>
        </Button>
      </div>
    </div>
    <div class="hero-visual" id="hero-image">
      <div class="hero-visual-wrapper">
        <!-- Aura e halo central de iluminação esmeralda atrás do perfil -->
        <div class="hero-img-aura" aria-hidden="true"></div>
        <div class="hero-img-core-glow" aria-hidden="true"></div>

        <!-- Painéis Tech HUD Flutuantes Atrás do Especialista (Profundidade 3D) -->
        <div class="hero-hud hud-left" aria-hidden="true">
          <div class="hud-top">
            <span class="hud-tag">CONVERSÃO</span>
            <span class="hud-pulse-dot"></span>
          </div>
          <svg class="hud-chart" viewBox="0 0 110 32" fill="none">
            <path d="M0 26 L22 20 L44 24 L68 12 L90 15 L110 4" stroke="#00FF9D" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M0 26 L22 20 L44 24 L68 12 L90 15 L110 4 L110 32 L0 32 Z" fill="url(#hud-grad-1)" opacity="0.25"></path>
            <defs>
              <linearGradient id="hud-grad-1" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#00FF9D"></stop>
                <stop offset="100%" stop-color="#00FF9D" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
          </svg>
          <div class="hud-bottom">
            <span class="hud-val">+182%</span>
            <span class="hud-desc">Leads WhatsApp</span>
          </div>
        </div>

        <div class="hero-hud hud-right" aria-hidden="true">
          <div class="hud-top">
            <span class="hud-tag">WEB VITALS</span>
            <span class="hud-pulse-dot active"></span>
          </div>
          <div class="hud-metrics">
            <div class="hud-metric-row">
              <span class="hud-m-label">LCP</span>
              <div class="hud-m-bar"><div class="hud-m-fill fill-lcp"></div></div>
              <span class="hud-m-val">0.6s</span>
            </div>
            <div class="hud-metric-row">
              <span class="hud-m-label">INP</span>
              <div class="hud-m-bar"><div class="hud-m-fill fill-inp"></div></div>
              <span class="hud-m-val">28ms</span>
            </div>
            <div class="hud-metric-row">
              <span class="hud-m-label">SCORE</span>
              <div class="hud-m-bar"><div class="hud-m-fill fill-score"></div></div>
              <span class="hud-m-val">100</span>
            </div>
          </div>
        </div>

        <Image
          src={heroPerfil}
          alt="André, especialista em Landing Pages"
          class="hero-img"
          widths={[380, 560, 760, 1120]}
          sizes="(max-width: 767px) 380px, (max-width: 1024px) 500px, 560px"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <!-- Micro-Card Flutuante 1: PageSpeed (Estilo Stripe/Fintech) -->
        <div class="hero-float-badge badge-speed" aria-hidden="true">
          <div class="float-icon-box speed-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="float-svg">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </div>
          <div class="float-info">
            <span class="float-num">100/100</span>
            <span class="float-label">PageSpeed Mobile</span>
          </div>
        </div>

        <!-- Micro-Card Flutuante 2: Conversão WhatsApp -->
        <div class="hero-float-badge badge-conversion" aria-hidden="true">
          <div class="float-icon-box conv-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="float-svg">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
              <polyline points="17 6 23 6 23 12"></polyline>
            </svg>
          </div>
          <div class="float-info">
            <span class="float-num">+42%</span>
            <span class="float-label">Mais Cliques no Whats</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100svh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem 0 2rem;
    overflow: hidden;
    background-color: #010101;

    /* Scroll-driven dissolve defaults (opacity + transform only) */
    --hero-opacity: 1;
    --hero-scale: 1;
    --hero-translate-y: 0px;
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
    /* Dissolve — driven by JS custom properties (compositor-only) */
    opacity: var(--hero-opacity);
    transform: scale(var(--hero-scale)) translateY(var(--hero-translate-y));
    will-change: opacity, transform;
    transform-origin: center top;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding: 7rem 0 3rem;
    }
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Mobile: scroll nativo 100% fluido sem recálculo síncrono de CSS variables */
  @media (max-width: 767px) {
    .hero-grid {
      opacity: 1 !important;
      transform: none !important;
      will-change: auto !important;
    }
  }

  /* Textos */
  .hero-content {
    text-align: left;
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.25rem;
      line-height: 1.08;
    }
  }

  @media (min-width: 1200px) {
    .hero-title {
      font-size: 3.5rem;
    }
  }

  .text-gradient {
    color: transparent;
    background-image: linear-gradient(
      to right,
      var(--color-primary-neon),
      #00a666
    );
    background-clip: text;
    -webkit-background-clip: text;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
    max-width: 500px;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: 1.15rem;
    }
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  /* Ícones dentro dos CTAs */
  .hero-ctas :global(.btn) {
    gap: 0.6rem;
  }

  .hero-ctas :global(.cta-icon) {
    width: 1.15em;
    height: 1.15em;
    flex-shrink: 0;
  }

  /* Micro-interação: seta desliza ao passar o mouse */
  .hero-ctas :global(.btn-cta-primary .cta-icon) {
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .hero-ctas :global(.btn-cta-primary:hover .cta-icon) {
    transform: translateX(5px);
  }

  /* Ícone "play" cresce levemente no hover */
  .hero-ctas :global(.btn-cta-ghost .cta-icon) {
    color: var(--color-primary-neon);
    transition: transform 0.3s ease;
  }

  .hero-ctas :global(.btn-cta-ghost:hover .cta-icon) {
    transform: scale(1.12);
  }

  /* Mobile: botões full-width e alinhados (tap targets maiores) */
  @media (max-width: 767px) {
    .hero-ctas {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .hero-ctas :global(.btn) {
      width: 100%;
    }
    .hero-ctas :global(.btn-large) {
      font-size: 0.9375rem !important;
      padding: 11px 20px !important;
    }
  }

  :global(.btn-large) {
    font-size: 1rem !important;
    padding: 13px 24px !important;
  }

  @media (min-width: 768px) {
    :global(.btn-large) {
      font-size: 1.125rem !important;
      padding: 16px 32px !important;
    }
  }

  /* Imagem visual e Wrapper para micro-cards */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-visual-wrapper {
    position: relative;
    width: 100%;
    max-width: 500px;
    display: flex;
    justify-content: center;
  }

  .hero-img {
    width: 100%;
    height: auto;
    position: relative;
    z-index: 10;
    filter: drop-shadow(0 16px 36px rgba(0, 0, 0, 0.65)) drop-shadow(0 0 24px rgba(0, 255, 157, 0.12));
    -webkit-mask-image: linear-gradient(to bottom, #000000 85%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000000 85%, transparent 100%);
  }

  /* Aura de luz esmeralda orgânica atrás da foto - dosagem suave e elegante */
  .hero-img-aura {
    position: absolute;
    top: 8%;
    left: 8%;
    right: 8%;
    bottom: 10%;
    background: radial-gradient(
      ellipse at 50% 45%,
      rgba(0, 255, 157, 0.38) 0%,
      rgba(0, 200, 120, 0.2) 38%,
      rgba(0, 71, 46, 0.1) 60%,
      transparent 75%
    );
    filter: blur(52px);
    border-radius: 50%;
    z-index: 5;
    pointer-events: none;
    animation: aura-glow 4.8s ease-in-out infinite alternate;
  }

  /* Núcleo de luz concentrado suave (Backlight / Rim-Light Halo) atrás do André */
  .hero-img-core-glow {
    position: absolute;
    top: 10%;
    left: 50%;
    width: 320px;
    height: 320px;
    transform: translateX(-50%);
    background: radial-gradient(
      circle,
      rgba(0, 255, 157, 0.46) 0%,
      rgba(0, 230, 140, 0.25) 35%,
      rgba(0, 166, 102, 0.1) 58%,
      transparent 72%
    );
    filter: blur(42px);
    border-radius: 50%;
    z-index: 6;
    pointer-events: none;
    mix-blend-mode: screen;
    animation: core-glow-pulse 4.2s ease-in-out infinite alternate;
  }

  @keyframes aura-glow {
    0% {
      opacity: 0.55;
      transform: scale(0.95);
    }
    100% {
      opacity: 0.85;
      transform: scale(1.05);
    }
  }

  @keyframes core-glow-pulse {
    0% {
      opacity: 0.6;
      transform: translateX(-50%) scale(0.95);
    }
    100% {
      opacity: 0.85;
      transform: translateX(-50%) scale(1.04);
    }
  }

  /* ─── Painéis Tech HUD Flutuantes Atrás do Especialista (z-index: 7) ─── */
  .hero-hud {
    position: absolute;
    z-index: 7;
    background: rgba(8, 14, 11, 0.76);
    border: 1px solid rgba(0, 255, 157, 0.22);
    border-radius: 12px;
    padding: 0.65rem 0.85rem;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.8), 0 0 24px -4px rgba(0, 255, 157, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  .hud-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
  }

  .hud-tag {
    font-size: 0.5625rem;
    font-weight: 700;
    color: var(--color-primary-neon);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hud-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary-neon);
    box-shadow: 0 0 6px var(--color-primary-neon);
  }

  .hud-pulse-dot.active {
    background: #38bdf8;
    box-shadow: 0 0 6px #38bdf8;
  }

  .hud-chart {
    width: 110px;
    height: 32px;
    display: block;
    margin-bottom: 0.3rem;
  }

  .hud-bottom {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .hud-val {
    font-size: 0.875rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .hud-desc {
    font-size: 0.625rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .hud-metrics {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 105px;
  }

  .hud-metric-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hud-m-label {
    font-size: 0.5625rem;
    font-weight: 700;
    color: var(--color-text-secondary);
    width: 32px;
  }

  .hud-m-bar {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
  }

  .hud-m-fill {
    height: 100%;
    border-radius: 2px;
    background: var(--color-primary-neon);
  }

  .fill-lcp { width: 92%; }
  .fill-inp { width: 96%; }
  .fill-score { width: 100%; background: #38bdf8; }

  .hud-m-val {
    font-size: 0.625rem;
    font-weight: 700;
    color: #ffffff;
    width: 24px;
    text-align: right;
  }

  /* Posicionamento no Desktop com profundidade */
  @media (min-width: 768px) {
    .hud-left {
      top: 18%;
      left: -32px;
      animation: float-hud-l 8s ease-in-out infinite alternate;
    }

    .hud-right {
      top: 36%;
      right: -36px;
      z-index: 12;
      animation: float-hud-r 9.5s ease-in-out infinite alternate;
    }
  }

  @media (min-width: 1024px) {
    .hud-left {
      top: 20%;
      left: -48px;
    }

    .hud-right {
      top: 38%;
      right: -52px;
      z-index: 12;
    }
  }

  @keyframes float-hud-l {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(6px, -10px, 0);
    }
  }

  @keyframes float-hud-r {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-6px, 10px, 0);
    }
  }

  /* ─── Micro-Cards Flutuantes de Autoridade (Estilo Stripe/Fintech) ─── */
  .hero-float-badge {
    position: absolute;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.9rem;
    background: rgba(11, 15, 23, 0.84);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    box-shadow: 0 16px 32px -6px rgba(0, 0, 0, 0.75), 0 0 24px -2px rgba(0, 255, 157, 0.14);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    pointer-events: none;
    user-select: none;
  }

  .float-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    flex-shrink: 0;
  }

  .speed-box {
    background: rgba(0, 255, 157, 0.14);
    color: var(--color-primary-neon);
    border: 1px solid rgba(0, 255, 157, 0.3);
  }

  .conv-box {
    background: rgba(56, 189, 248, 0.14);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .float-svg {
    width: 17px;
    height: 17px;
  }

  .float-info {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .float-num {
    font-size: 0.9375rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .float-label {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  /* Posicionamento no Desktop com elevação sutil */
  @media (min-width: 768px) {
    .badge-speed {
      top: 10%;
      right: -12px;
      animation: float-card-speed 6s ease-in-out infinite alternate;
    }

    .badge-conversion {
      bottom: 12%;
      left: -18px;
      animation: float-card-conv 7.5s ease-in-out infinite alternate;
    }
  }

  @media (min-width: 1024px) {
    .badge-speed {
      top: 12%;
      right: -24px;
    }

    .badge-conversion {
      bottom: 14%;
      left: -28px;
    }
  }

  /* Mobile: fixar dentro dos limites da imagem para estabilidade de layout (G3) */
  @media (max-width: 767px) {
    .hero-float-badge {
      padding: 0.42rem 0.68rem;
      gap: 0.5rem;
      border-radius: 11px;
    }

    .float-icon-box {
      width: 26px;
      height: 26px;
    }

    .float-svg {
      width: 14px;
      height: 14px;
    }

    .float-num {
      font-size: 0.8125rem;
    }

    .float-label {
      font-size: 0.625rem;
    }

    .badge-speed {
      top: 12px;
      right: 8px;
      animation: float-card-speed 6s ease-in-out infinite alternate;
    }

    .badge-conversion {
      bottom: 14px;
      left: 8px;
      animation: float-card-conv 7.5s ease-in-out infinite alternate;
    }
  }

  @keyframes float-card-speed {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(-8px) rotate(0.6deg);
    }
  }

  @keyframes float-card-conv {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    100% {
      transform: translateY(8px) rotate(-0.6deg);
    }
  }

  /* ─── Pill Badge com Neon Pulse (Estilo Raycast/Vercel) ─── */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    margin-bottom: 1.25rem;
    border-radius: 9999px;
    background: rgba(0, 255, 157, 0.05);
    border: 1px solid rgba(0, 255, 157, 0.22);
    box-shadow: 0 0 20px -4px rgba(0, 255, 157, 0.18), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
    width: fit-content;
  }

  @media (hover: hover) {
    .hero-badge:hover {
      border-color: rgba(0, 255, 157, 0.45);
      box-shadow: 0 0 26px -2px rgba(0, 255, 157, 0.32), inset 0 1px 1px rgba(255, 255, 255, 0.2);
      transform: translateY(-1px);
    }
  }

  .badge-pulse {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 8px;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background-color: var(--color-primary-neon);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--color-primary-neon);
  }

  .pulse-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background-color: var(--color-primary-neon);
    opacity: 0.7;
    animation: badge-ring-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes badge-ring-ping {
    0% {
