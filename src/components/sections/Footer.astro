---
import { Image } from "astro:assets";
import logoHorizontal from "../../assets/images/logo-ocareca-horizontal.webp";
---

<footer class="footer-section">
  <div class="container text-center">
    <div class="logo">
      <a href="/" aria-label="OCARECADEV Página Inicial">
        <Image
          src={logoHorizontal}
          alt="OCARECADEV Logo"
          style="height: 30px; width: auto;"
        />
      </a>
    </div>
    <div class="footer-links">
      <a href="/politica-de-privacidade" class="footer-link">Política de Privacidade</a>
    </div>
    <p class="copyright">
      &copy; {new Date().getFullYear()} OCARECADEV. Todos os direitos reservados.
      Transformando cliques em clientes.
    </p>
    <div class="privacy-controls">
      <button type="button" data-open-cookie-preferences>Preferências de cookies</button>
      <span>Política de privacidade em breve</span>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    padding: 4rem 0;
    margin-top: 4rem;
    position: relative;
  }

  @media (min-width: 768px) {
    .footer-section {
      padding: 6rem 0;
    }
  }

  /* Linha divisória com gradiente */
  .footer-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.02) 20%,
      rgba(255, 255, 255, 0.15) 50%,
      rgba(255, 255, 255, 0.02) 80%,
      transparent 100%
    );
  }

  .text-center {
    text-align: center;
  }

  .logo {
    display: inline-block;
    margin-bottom: 1rem;
  }

  .logo a {
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .logo a:hover {
    opacity: 0.85;
  }

  .footer-links {
    margin-bottom: 1rem;
  }

  .footer-link {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-primary-neon);
    text-shadow: 0 0 8px rgba(0, 255, 157, 0.4);
    text-decoration: none;
  }

  .copyright {
    color: var(--color-text-secondary);
    font-size: 0.875rem;
  }

  .privacy-controls {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
  }

  .privacy-controls button {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    text-decoration: underline;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .privacy-controls button:hover {
    color: var(--color-primary-neon);
    text-shadow: 0 0 8px rgba(0, 255, 157, 0.4);
    text-decoration: none;
  }
</style>
