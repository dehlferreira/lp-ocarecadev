---
import GlassCard from '../ui/GlassCard.astro';

const faqs = [
  {
    q: 'Já tenho Instagram. Ainda preciso de uma landing page?',
    a: 'O Instagram é ótimo para atrair atenção, mas é limitado para explicar uma oferta completa e fechar. Na landing page, o visitante não se distrai com notificações ou concorrentes: ele encontra sua proposta de valor clara e um botão direto para conversar com você no WhatsApp.',
  },
  {
    q: 'Preciso anunciar para a página funcionar?',
    a: 'Não obrigatoriamente. Uma landing page bem estruturada potencializa qualquer tráfego que você já receba, seja do link da bio do Instagram, indicação de clientes, Google Meu Negócio ou abordagens diretas. Quando você decidir investir em anúncios (Google ou Meta), a página já estará pronta para converter esse tráfego em contatos.',
  },
  {
    q: 'Vocês também fazem os textos da página?',
    a: 'Sim. Nós estruturamos toda a copy (redação persuasiva) com base no seu público, nos seus diferenciais e no objetivo da página. Você só precisa nos passar as informações essenciais sobre o seu negócio e validar o conteúdo antes da publicação.',
  },
  {
    q: 'Domínio e hospedagem estão incluídos?',
    a: 'O domínio (ex.: suaempresa.com.br) é registrado em seu nome para garantir que a propriedade seja sempre sua (custa em média R$ 40/ano no Registro.br). Nós cuidamos de toda a configuração técnica e a hospedagem é feita em infraestrutura moderna, ultrarrápida e com SSL gratuito.',
  },
  {
    q: 'Por que não fazer sozinho no Wix, Canva ou WordPress?',
    a: 'Ferramentas visuais genéricas costumam gerar páginas lentas, pesadas e que quebram no celular. Além disso, a ferramenta não resolve a estratégia: nossa entrega combina código limpo de altíssima velocidade com redação e UX orientadas a fazer o visitante entender e agir.',
  },
  {
    q: 'Qual a diferença entre o Express e a Landing que Vende?',
    a: 'O Express é voltado para quem precisa entrar no ar rápido, utilizando uma estrutura validada com personalização ágil de marca e conteúdo. A Landing que Vende é um projeto 100% estratégico e aprofundado, construído sob medida com copy específica para sua oferta e tracking detalhado de comportamento.',
  },
  {
    q: 'Depois que a página estiver pronta, ela é minha?',
    a: 'Sim, 100% sua. Não cobramos mensalidades obrigatórias de manutenção nem retemos seu projeto. O código e o domínio pertencem exclusivamente ao seu negócio.',
  },
  {
    q: 'O que vocês precisam de mim para começar?',
    a: 'Apenas de um alinhamento inicial: o que você vende, para quem, quais são seus principais diferenciais e seu número de WhatsApp de atendimento. A partir daí, cuidamos da estrutura, redação, design e publicação técnica.',
  },
  {
    q: 'Em quanto tempo minha página fica pronta?',
    a: 'No plano OCARECADEV Express, entregamos em até 48 horas úteis após o envio das informações básicas. Na Landing que Vende e no Site Profissional, o prazo médio é de 5 a 10 dias úteis, dependendo do escopo e do tempo de alinhamento.',
  },
];
---

<section id="faq" class="section-faq section-fade-top section-fade-bottom">
  <div class="container container--narrow">
    <div class="section-header">
      <h2 class="section-title scroll-animate">Perguntas Frequentes</h2>
    </div>

    <div class="faq-grid">
      {faqs.map((faq, i) => (
        <GlassCard as="details" class={`faq-item scroll-animate ${i % 2 === 0 ? 'anim-left' : 'anim-right'}`} padding="0">
          <summary class="faq-summary">
            <h3>{faq.q}</h3>
            <span class="faq-chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p class="faq-answer__text">{faq.a}</p>
          </div>
        </GlassCard>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-item').forEach((item) => {
    if (!(item instanceof HTMLDetailsElement)) return;

    const summary = item.querySelector('.faq-summary');
    const answer = item.querySelector('.faq-answer');
    if (!summary || !answer) return;

    const closeAnswer = () => {
      item.classList.remove('is-open');

      const finishClosing = (event: Event) => {
        if ((event as TransitionEvent).propertyName !== 'grid-template-rows') return;
        answer.removeEventListener('transitionend', finishClosing);
        item.open = false;
      };

      answer.addEventListener('transitionend', finishClosing);
      window.setTimeout(() => {
        if (!item.classList.contains('is-open')) item.open = false;
      }, 400);
    };

    summary.addEventListener('click', (event) => {
      event.preventDefault();

      if (item.open) {
        closeAnswer();
        return;
      }

      item.open = true;
      requestAnimationFrame(() => item.classList.add('is-open'));
    });
  });
</script>

<style>
  .section-faq {
    padding: 4rem 0;
    position: relative;
    background-color: #010101;
  }

  @media (min-width: 768px) {
    .section-faq {
      padding: 6rem 0;
    }
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 2.5rem;
    }
  }

  .faq-grid {
    display: grid;
    gap: 1.5rem;
  }

  :global(.faq-item) {
    overflow: hidden;
  }

  :global(.faq-summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 2rem;
    cursor: pointer;
    list-style: none;
  }

  :global(.faq-summary::marker) {
    content: '';
  }

  :global(.faq-summary::-webkit-details-marker) {
    display: none;
  }

  :global(.faq-chevron) {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--color-primary-neon);
    transition: transform 0.35s ease;
  }

  :global(.faq-chevron svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  :global(.faq-item.is-open .faq-chevron) {
    transform: rotate(180deg);
  }

  :global(.faq-item) h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  :global(.faq-answer) {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    opacity: 0;
    transition: grid-template-rows 0.35s ease, opacity 0.2s ease;
  }

  :global(.faq-item.is-open .faq-answer) {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
  }

  :global(.faq-answer__text) {
    min-height: 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    margin: 0;
    padding: 0 2rem 1.5rem;
  }

  :global(.faq-summary:focus-visible) {
    outline: 2px solid var(--color-primary-neon);
    outline-offset: -2px;
  }

  @media (max-width: 767px) {
    .section-header {
      margin-bottom: 2rem;
    }
    .section-title {
      font-size: 1.65rem;
    }
    :global(.faq-item) {
      border-radius: 12px;
    }
    :global(.faq-summary) {
      padding: 1.25rem;
    }
    :global(.faq-item) h3 {
      font-size: 1.05rem;
    }
    :global(.faq-answer__text) {
      padding: 0 1.25rem 1.25rem;
    }
  }
</style>
