---
import GlassCard from '../ui/GlassCard.astro';
---

<section id="faq" class="section-faq section-fade-top section-fade-bottom">
  <div class="container container--narrow">
    <div class="section-header">
      <h2 class="section-title scroll-animate">Ainda com dúvidas?</h2>
    </div>

    <div class="faq-grid">
      <GlassCard as="details" class="faq-item scroll-animate anim-left delay-100" padding="0">
        <summary class="faq-summary">
          <h3>Preciso entender de tecnologia?</h3>
          <span class="faq-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p class="faq-answer__text">Não. Nós cuidamos de tudo.</p>
        </div>
      </GlassCard>

      <GlassCard as="details" class="faq-item scroll-animate anim-right delay-200" padding="0">
        <summary class="faq-summary">
          <h3>Em quanto tempo fica pronto?</h3>
          <span class="faq-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p class="faq-answer__text">A partir de 48h no plano Express.</p>
        </div>
      </GlassCard>

      <GlassCard as="details" class="faq-item scroll-animate anim-left delay-300" padding="0">
        <summary class="faq-summary">
          <h3>Vou conseguir editar depois?</h3>
          <span class="faq-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p class="faq-answer__text">Sim, você terá acesso.</p>
        </div>
      </GlassCard>

      <GlassCard as="details" class="faq-item scroll-animate anim-right delay-400" padding="0">
        <summary class="faq-summary">
          <h3>Isso realmente funciona?</h3>
          <span class="faq-chevron" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6" /></svg>
          </span>
        </summary>
        <div class="faq-answer">
          <p class="faq-answer__text">Funciona quando é feito da forma certa — e é isso que fazemos.</p>
        </div>
      </GlassCard>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-item').forEach((item) => {
    if (!(item instanceof HTMLDetailsElement)) return;

    const summary = item.querySelector('.faq-summary');
    const answer = item.querySelector('.faq-answer');
    if (!summary || !answer) return;

    const closeAnswer = () => {
      item.classList.remove('is-open');

      const finishClosing = (event: Event) => {
        if ((event as TransitionEvent).propertyName !== 'grid-template-rows') return;
        answer.removeEventListener('transitionend', finishClosing);
        item.open = false;
      };

      answer.addEventListener('transitionend', finishClosing);
      window.setTimeout(() => {
        if (!item.classList.contains('is-open')) item.open = false;
      }, 400);
    };

    summary.addEventListener('click', (event) => {
      event.preventDefault();

      if (item.open) {
        closeAnswer();
        return;
      }

      item.open = true;
      requestAnimationFrame(() => item.classList.add('is-open'));
    });
  });
</script>

<style>
  .section-faq {
    padding: 4rem 0;
    position: relative;
    background-color: #010101;
  }

  @media (min-width: 768px) {
    .section-faq {
      padding: 6rem 0;
    }
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 2.5rem;
    }
  }

  .faq-grid {
    display: grid;
    gap: 1.5rem;
  }

  :global(.faq-item) {
    overflow: hidden;
  }

  :global(.faq-summary) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 2rem;
    cursor: pointer;
    list-style: none;
  }

  :global(.faq-summary::marker) {
    content: '';
  }

  :global(.faq-summary::-webkit-details-marker) {
    display: none;
  }

  :global(.faq-chevron) {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--color-primary-neon);
    transition: transform 0.35s ease;
  }

  :global(.faq-chevron svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  :global(.faq-item.is-open .faq-chevron) {
    transform: rotate(180deg);
  }

  :global(.faq-item) h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
  }

  :global(.faq-answer) {
    display: grid;
    grid-template-rows: minmax(0, 0fr);
    opacity: 0;
    transition: grid-template-rows 0.35s ease, opacity 0.2s ease;
  }

  :global(.faq-item.is-open .faq-answer) {
    grid-template-rows: minmax(0, 1fr);
    opacity: 1;
  }

  :global(.faq-answer__text) {
    min-height: 0;
    overflow: hidden;
    color: var(--color-text-secondary);
    margin: 0;
    padding: 0 2rem 1.5rem;
  }

  :global(.faq-summary:focus-visible) {
    outline: 2px solid var(--color-primary-neon);
    outline-offset: -2px;
  }

  @media (max-width: 767px) {
    .section-header {
      margin-bottom: 2rem;
    }
    .section-title {
      font-size: 1.65rem;
    }
    :global(.faq-item) {
      border-radius: 12px;
    }
    :global(.faq-summary) {
      padding: 1.25rem;
    }
    :global(.faq-item) h3 {
      font-size: 1.05rem;
    }
    :global(.faq-answer__text) {
      padding: 0 1.25rem 1.25rem;
    }
  }
</style>
