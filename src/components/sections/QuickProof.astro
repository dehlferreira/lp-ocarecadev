---
import Icon from '../ui/Icon.astro';
---

<section id="prova-rapida" class="section-quick-proof section-fade-bottom">
  <!-- Conector Luminoso de Transição Fluida -->
  <div class="transition-beam" aria-hidden="true"></div>
  <div class="transition-ambient-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="quick-proof-wrapper" id="quick-proof-card">
      <div class="quick-proof-header">
        <span class="proof-badge">
          <span class="badge-dot"></span>
          Validação Real
        </span>
        <h2 class="quick-proof-title">Não precisa acreditar só no que o Careca está dizendo</h2>
        <p class="quick-proof-sub">Quem já contratou conta como foi a experiência:</p>
      </div>

      <div class="quick-proof-grid">
        <!-- Depoimento 1: Grupo Carrera Consórcio -->
        <div class="teaser-card">
          <div class="teaser-meta">
            <span class="teaser-author">Grupo Carrera Consórcio</span>
            <span class="teaser-channel">
              <Icon name="instagram" size={14} stroke={2} />
              Instagram
            </span>
          </div>
          <blockquote class="teaser-quote">
            &ldquo;Ficou <strong>extraordinário</strong>! Parabéns pelo capricho e pela entrega rápida.&rdquo;
          </blockquote>
        </div>

        <!-- Depoimento 2: Vinicius Oliveira -->
        <div class="teaser-card">
          <div class="teaser-meta">
            <span class="teaser-author">Vinicius Oliveira</span>
            <span class="teaser-channel">
              <Icon name="whatsapp" size={14} stroke={2} />
              WhatsApp
            </span>
          </div>
          <blockquote class="teaser-quote">
            &ldquo;Ficou top, valeu pela agilidade. Já vou colocar as campanhas no ar hoje mesmo.&rdquo;
          </blockquote>
        </div>
      </div>

      <div class="quick-proof-cta">
        <a href="#social-proof" class="btn-teaser-link" data-track-event="select_content" data-track-location="quick_proof_teaser">
          <span>Ver todos os áudios e feedbacks reais</span>
          <Icon name="arrow-right" size={15} stroke={2.5} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .section-quick-proof {
    background-color: #0A0A0A;
    padding: 4rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .section-quick-proof {
      padding: 6rem 0;
    }
  }

  /* Conector de Transição Fluida */
  .transition-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 157, 0.04) 15%,
      rgba(0, 255, 157, 0.45) 50%,
      rgba(0, 255, 157, 0.04) 85%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  .transition-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 800px;
    height: 90px;
    background: radial-gradient(
      ellipse 60% 70px at 50% 0%,
      rgba(0, 255, 157, 0.14) 0%,
      rgba(0, 255, 157, 0.03) 55%,
      transparent 100%
    );
    z-index: 10;
    pointer-events: none;
  }

  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .quick-proof-wrapper {
    background: rgba(14, 18, 23, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5);
    text-align: center;
    position: relative;
    z-index: 4;
  }

  .quick-proof-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 157, 0.45), transparent);
  }

  .proof-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.25);
    color: var(--color-primary-neon);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.85rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary-neon);
  }

  .quick-proof-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  @media (min-width: 768px) {
    .quick-proof-title {
      font-size: 1.85rem;
    }
  }

  .quick-proof-sub {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0 auto 1.75rem;
    max-width: 600px;
  }

  .quick-proof-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    text-align: left;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 768px) {
    .quick-proof-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
  }

  .teaser-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.2s ease;
  }

  .teaser-card:hover {
    border-color: rgba(0, 255, 157, 0.25);
  }

  .teaser-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .teaser-author {
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
  }

  .teaser-channel {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .teaser-quote {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    font-style: italic;
  }

  .teaser-quote strong {
    color: var(--color-primary-neon);
    font-style: normal;
  }

  .quick-proof-cta {
    display: flex;
    justify-content: center;
  }

  .btn-teaser-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary-neon);
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: rgba(0, 255, 157, 0.06);
    border: 1px solid rgba(0, 255, 157, 0.2);
    transition: all 0.2s ease;
  }

  .btn-teaser-link:hover {
    background: rgba(0, 255, 157, 0.12);
    border-color: rgba(0, 255, 157, 0.4);
    transform: translateY(-1px);
  }

  /* Animação com efeito de mola disparada quando 40% da seção aparece */
  .quick-proof-wrapper.card-spring-ready {
    opacity: 0;
    visibility: hidden;
    transform: translateX(130px);
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease, visibility 0.45s ease;
    will-change: transform, opacity;
  }

  .quick-proof-wrapper.card-spring-ready.is-spring-in {
    opacity: 1;
    visibility: visible;
    animation: spring-bounce-in-right 0.95s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
  }

  @keyframes spring-bounce-in-right {
    0% {
      opacity: 0;
      visibility: visible;
      transform: translateX(140px) scale(0.96);
    }
    25% {
      opacity: 1;
    }
    45% {
      /* Batida na mola com compressão à esquerda (ultrapassa o centro) */
      transform: translateX(-38px) scale(1.02);
    }
    63% {
      /* Recuo elástico da mola para a direita */
      transform: translateX(16px) scale(0.99);
    }
    77% {
      /* Segundo rebote elástico */
      transform: translateX(-8px) scale(1.004);
    }
    89% {
      /* Amortecimento */
      transform: translateX(3px) scale(0.998);
    }
    96% {
      transform: translateX(-1px);
    }
    100% {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
    }
  }

  @media (max-width: 767px) {
    .quick-proof-wrapper.card-spring-ready {
      transform: translateX(80px);
    }

    .quick-proof-wrapper.card-spring-ready.is-spring-in {
      animation: spring-bounce-in-right-mobile 0.9s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }

    @keyframes spring-bounce-in-right-mobile {
      0% {
        opacity: 0;
        visibility: visible;
        transform: translateX(90px);
      }
      25% {
        opacity: 1;
      }
      45% {
        transform: translateX(-24px);
      }
      63% {
        transform: translateX(11px);
      }
      77% {
        transform: translateX(-5px);
      }
      89% {
        transform: translateX(2px);
      }
      100% {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-proof-wrapper.card-spring-ready,
    .quick-proof-wrapper.card-spring-ready.is-spring-in {
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const setupQuickProofSpring = () => {
    // Respeita preferência por redução de movimento (G2)
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const section = document.getElementById('prova-rapida');
    const card = document.getElementById('quick-proof-card');
    if (!section || !card) return;

    // Prepara o card para animação (inicia oculto até atingir 40% de visibilidade)
    card.classList.add('card-spring-ready');

    let isTriggered = false;

    const checkAndTrigger = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const sectionHeight = section.offsetHeight;

      // Quantos pixels do topo da seção já entraram na janela
      const visibleFromTop = windowHeight - rect.top;
      const triggerThreshold = sectionHeight * 0.4;
      const resetThreshold = sectionHeight * 0.32;

      // Se desceu o scroll e 40% da seção apareceu: aciona animação de mola
      if (visibleFromTop >= triggerThreshold && rect.bottom > 0) {
        if (!isTriggered) {
          isTriggered = true;
          card.classList.add('is-spring-in');
        }
      } else if (visibleFromTop < resetThreshold || rect.top > windowHeight + 60) {
        // Se subiu/voltou o scroll: desfaz a animação suavemente
        if (isTriggered) {
          isTriggered = false;
          card.classList.remove('is-spring-in');
        }
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          checkAndTrigger();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Checagem imediata caso a página já tenha sido carregada no ponto
    checkAndTrigger();
  };

  setupQuickProofSpring();
  document.addEventListener('astro:page-load', setupQuickProofSpring);
</script>
