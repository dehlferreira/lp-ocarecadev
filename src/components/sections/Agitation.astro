---
import FrustrationChart from "../ui/FrustrationChart.astro";
import Icon from "../ui/Icon.astro";
---

<section id="agitacao" class="section-agitation scrolly-section section-fade-bottom">
  <div
    class="scrolly scrolly--4"
    style="--scrolly-track: 300vh; --scrolly-track-mobile: 220vh;"
  >
    <div class="scrolly__stage">
      <div class="container">
        <!-- Ordem do scroll: texto → dores → gráfico → punchline (SPEC-009) -->
        <div class="agitation-content">
          <div class="ag-text">
            <p class="agitation-big scrolly-step s-1">
              Você investiu tempo, dinheiro…
              <span class="agitation-big-sub">
                e no fim, tem só uma página parada na internet.
              </span>
            </p>

            <ul class="agitation-words scrolly-step s-2">
              <li>Sem retorno.</li>
              <li>Sem previsibilidade.</li>
              <li>Sem controle.</li>
            </ul>
          </div>

          <div class="frustration-img-container scrolly-step from-scale s-3">
            <FrustrationChart compact />
          </div>

          <p class="agitation-highlight scrolly-step from-scale s-4">
            <span class="highlight-icon">
              <Icon name="arrow-right" size={20} stroke={2.5} />
            </span>
            <span>
              Isso não é um site. É um <span class="text-neon">custo</span>.
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-agitation {
    background-color: #010101;
  }

  .agitation-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .agitation-content {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      grid-template-rows: auto auto;
      align-items: center;
      gap: 1.5rem 3.5rem;
      text-align: left;
    }

    .ag-text {
      grid-column: 1;
      grid-row: 1;
    }

    .frustration-img-container {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .agitation-highlight {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .ag-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .ag-text {
      align-items: flex-start;
      gap: 1.75rem;
    }
  }

  .agitation-big {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0;
  }

  .agitation-big-sub {
    display: block;
    margin-top: 0.35rem;
  }

  @media (min-width: 768px) {
    .agitation-big {
      font-size: 2.5rem;
      line-height: 1.2;
    }
    .agitation-big-sub {
      margin-top: 0.5rem;
    }
  }

  .agitation-words {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 0.75rem;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  .agitation-words li {
    position: relative;
    padding-left: 0.85rem;
  }

  .agitation-words li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(255, 92, 92, 0.85);
  }

  @media (min-width: 768px) {
    .agitation-words {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      font-size: 1.5rem;
    }
    .agitation-words li {
      padding-left: 1rem;
    }
  }

  .frustration-img-container {
    width: 100%;
    max-width: 320px;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .frustration-img-container {
      max-width: 560px;
    }
  }

  .agitation-highlight {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-primary);
    display: inline-flex;
    align-items: flex-start;
    gap: 0.55rem;
    text-align: left;
    margin: 0;
    max-width: 100%;
  }

  .highlight-icon {
    display: inline-flex;
    color: var(--color-primary-neon);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  @media (min-width: 768px) {
    .agitation-highlight {
      font-size: 1.75rem;
      gap: 0.6rem;
    }
  }

  /* Mobile: comprime tudo para caber no palco pinado (100svh) */
  @media (max-width: 767px) {
    .agitation-content {
      gap: 0.85rem;
    }
    .ag-text {
      gap: 0.65rem;
    }
    .agitation-big {
      font-size: 1.2rem;
    }
    .agitation-words {
      font-size: 0.875rem;
      gap: 0.25rem 0.6rem;
    }
    .frustration-img-container {
      max-width: min(100%, 280px);
    }
    .agitation-highlight {
      font-size: 1rem;
      justify-content: center;
      text-align: center;
    }
  }
</style>
