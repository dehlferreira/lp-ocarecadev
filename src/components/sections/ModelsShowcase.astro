---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import thumbOficina from '../../assets/images/modelo-oficina.webp';
import thumbClinica from '../../assets/images/modelo-clinica.webp';
import thumbPet from '../../assets/images/modelo-petshop.webp';
import thumbSalao from '../../assets/images/modelo-salao.webp';
import thumbTatuagem from '../../assets/images/modelo-tatuagem.webp';
import thumbAdvocacia from '../../assets/images/modelo-advocacia.webp';
import thumbOdonto from '../../assets/images/modelo-odonto-v2.webp';

const models = [
  {
    niche: 'Oficina premium',
    name: 'Modelo Oficina',
    focus: 'Luxo e performance automotiva',
    placeholderName: 'Oficina',
    url: 'https://lp-modelo-oficina-motorgarage.vercel.app/',
    image: thumbOficina,
  },
  {
    niche: 'Clínica estética',
    name: 'Modelo Clínica estética',
    focus: 'Harmonização facial e corporal',
    placeholderName: 'Clínica estética',
    url: 'https://lp-modelo-clinica-estetica.vercel.app/',
    image: thumbClinica,
  },
  {
    niche: 'Pet shop e veterinária',
    name: 'Modelo Pet',
    focus: 'Cuidado para o melhor amigo',
    placeholderName: 'Pet',
    url: 'https://lp-modelo-petshop.vercel.app/',
    image: thumbPet,
  },
  {
    niche: 'Salão de beleza',
    name: 'Modelo Salão',
    focus: 'Visagismo e estética minimalista',
    placeholderName: 'Salão',
    url: 'https://lp-modelo-salao-studio.vercel.app/',
    image: thumbSalao,
  },
  {
    niche: 'Estúdio de tatuagem',
    name: 'Modelo Tatuagem',
    focus: 'Estilo e marcas permanentes',
    placeholderName: 'Tatuagem',
    url: 'https://lp-modelo-studio-tatuagem.vercel.app/',
    image: thumbTatuagem,
  },
  {
    niche: 'Advocacia',
    name: 'Modelo Advocacia',
    focus: 'Proteção patrimonial e estratégia',
    placeholderName: 'Advocacia',
    url: 'https://lp-modelo-advocacia.vercel.app/',
    image: thumbAdvocacia,
  },
  {
    niche: 'Odontologia e lentes',
    name: 'Modelo Odonto',
    focus: 'Sorriso e lentes de contato',
    placeholderName: 'Odonto',
    url: 'https://lp-modelo-odonto.vercel.app/',
    image: thumbOdonto,
  },
];
---

<section id="modelos" class="section-models" aria-labelledby="modelos-title">
  <!-- Conector Luminoso de Transição Fluida -->
  <div class="transition-beam" aria-hidden="true"></div>
  <div class="transition-ambient-glow" aria-hidden="true"></div>

  <div class="container">
    <header class="models-header">
      <p class="models-eyebrow scroll-animate anim-rise-sm">Alguns modelos disponíveis no OCARECADEV Express</p>
      <h2 id="modelos-title" class="models-title scroll-animate anim-rise-sm">Veja possibilidades para o seu negócio</h2>
      <p class="models-subtitle scroll-animate anim-rise-sm">
        Exemplos visuais para você enxergar como diferentes segmentos ganham uma presença digital mais profissional.
      </p>
      <div class="models-scope-note scroll-animate anim-rise-sm">
        <span class="scope-pill scope-pill--express"><strong>EXPRESS:</strong> Implementação ágil sobre modelo estruturado</span>
        <span class="scope-pill scope-pill--custom"><strong>LANDING QUE VENDE:</strong> Projeto 100% estratégico, personalizado e sob medida</span>
      </div>
    </header>

    <p class="models-hint scroll-animate anim-rise-sm">Use as setas para ver os outros modelos</p>

    <div class="models-carousel-container">
      <button
        type="button"
        class="models-arrow models-arrow--prev"
        id="modelos-prev"
        aria-label="Modelo anterior"
      >
        <span class="models-arrow-icon models-arrow-icon--prev">
          <Icon name="arrow-right" size={20} />
        </span>
      </button>

      <ul class="models-track" id="modelos-track">
      {models.map((model, i) => (
        <li class="models-slide">
          <article class="model-card glass-panel scroll-animate anim-rise-sm delay-${(i + 1) * 100}" tabindex="0">
            {model.image ? (
              <div class="model-thumb model-thumb--image">
                <Image
                  src={model.image}
                  alt={`Demonstração visual do ${model.name} (${model.niche})`}
                  width={800}
                  height={500}
                  loading="lazy"
                  decoding="async"
                  class="model-thumb-img"
                />
              </div>
            ) : (
              <div
                class="model-thumb"
                role="img"
                aria-label={`Placeholder do modelo ${model.placeholderName}, imagem provisória`}
              >
                <Icon name="layout-template" size={36} />
                <span class="model-thumb-brand" aria-hidden="true">OCARECADEV</span>
              </div>
            )}
            <p class="model-niche">{model.niche}</p>
            <h3 class="model-name">{model.name}</h3>
            <p class="model-focus">{model.focus}</p>
            {model.url ? (
              <a
                href={model.url}
                target="_blank"
                rel="noopener noreferrer"
                class="model-action-btn"
                aria-label={`Ver demonstração do ${model.name} (abre em nova aba)`}
                data-track-event="select_content"
                data-track-location="models_showcase"
                data-track-item={model.name}
              >
                <span>Ver modelo</span>
                <Icon name="external-link" size={14} />
              </a>
            ) : (
              <p class="model-status">Em breve</p>
            )}
          </article>
        </li>
      ))}
    </ul>

      <button
        type="button"
        class="models-arrow models-arrow--next"
        id="modelos-next"
        aria-label="Próximo modelo"
      >
        <Icon name="arrow-right" size={20} />
      </button>
    </div>
  </div>
</section>

<style>
  .section-models {
    position: relative;
    padding: 4rem 0;
    background: #0a0a0a;
  }

  /* Conector de Transição Fluida */
  .transition-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 157, 0.04) 15%,
      rgba(0, 255, 157, 0.45) 50%,
      rgba(0, 255, 157, 0.04) 85%,
      transparent 100%
    );
    z-index: 10;
    pointer-events: none;
  }

  .transition-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 800px;
    height: 250px;
    background: radial-gradient(
      ellipse at top center,
      rgba(0, 255, 157, 0.07) 0%,
      transparent 70%
    );
    z-index: 6;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .section-models {
      padding: 6rem 0;
    }
  }

  .models-header {
    max-width: 860px;
    margin: 0 auto 1.75rem;
    text-align: center;
  }

  .models-eyebrow {
    margin: 0 0 0.75rem;
    color: var(--color-primary-neon);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .models-title {
    margin: 0 0 0.85rem;
    color: var(--color-text-primary);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.15;
  }

  .models-subtitle {
    margin: 0 auto 1.25rem;
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    max-width: 680px;
  }

  .models-scope-note {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .scope-pill strong {
    color: #ffffff;
  }

  .scope-pill--custom strong {
    color: var(--color-primary-neon);
  }

  .scope-divider {
    color: rgba(255, 255, 255, 0.2);
  }

  @media (min-width: 768px) {
    .models-title {
      font-size: 2.6rem;
    }
  }

  .models-hint {
    display: none;
    margin: 0 auto 1.25rem;
    text-align: center;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  @media (min-width: 768px) {
    .models-hint {
      display: block;
    }
  }

  .models-carousel-container {
    position: relative;
    width: 100%;
  }

  .models-arrow {
    display: none;
    position: absolute;
    top: calc(50% - 1.5rem);
    transform: translateY(-50%);
    z-index: 20;
    width: 3.25rem;
    height: 3.25rem;
    min-width: 48px;
    min-height: 48px;
    place-items: center;
    border: 1px solid rgba(0, 255, 157, 0.3);
    border-radius: 50%;
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text-primary);
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), 0 0 12px rgba(0, 255, 157, 0.1);
    transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease, color 0.2s ease;
  }

  @media (min-width: 768px) {
    .models-arrow {
      display: grid;
    }
  }

  .models-arrow--prev {
    left: 0.25rem;
  }

  .models-arrow--next {
    right: 0.25rem;
  }

  @media (min-width: 1280px) {
    .models-arrow--prev {
      left: -1.25rem;
    }

    .models-arrow--next {
      right: -1.25rem;
    }
  }

  .models-arrow:hover {
    border-color: var(--color-primary-neon);
    background: rgba(15, 25, 20, 0.95);
    color: var(--color-primary-neon);
    box-shadow: 0 0 24px rgba(0, 255, 157, 0.4), 0 6px 24px rgba(0, 0, 0, 0.7);
    transform: translateY(-50%) scale(1.08);
  }

  .models-arrow:active {
    transform: translateY(-50%) scale(0.96);
  }

  .models-arrow:focus-visible,
  .model-card:focus-visible {
    outline: 2px solid var(--color-primary-neon);
    outline-offset: 3px;
  }

  .models-arrow-icon--prev {
    display: grid;
    place-items: center;
    transform: rotate(180deg);
  }

  .models-track {
    display: flex;
    gap: 1rem;
    margin: 0;
    /* Padding generoso em cima e embaixo para caber o translateY e os neon shadows sem gerar scroll vertical */
    padding: 1.5rem 0.5rem 4.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.5rem;
    list-style: none;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE e Edge */
  }

  .models-track::-webkit-scrollbar {
    display: none; /* Chrome, Safari e Opera */
  }

  .models-slide {
    flex: 0 0 min(85vw, 22rem);
    width: min(85vw, 22rem);
    scroll-snap-align: start;
  }

  .model-card {
    display: grid;
    height: 100%;
    padding: 1rem;
    gap: 0.55rem;
  }

  :global(.model-card) {
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.35s ease, 
                box-shadow 0.35s ease,
                background 0.35s ease !important;
  }

  /* Cascata com delays para a animação de entrada */
  :global(.model-card.delay-100) { transition-delay: 150ms, 150ms, 0s, 0s, 0s !important; }
  :global(.model-card.delay-200) { transition-delay: 300ms, 300ms, 0s, 0s, 0s !important; }
  :global(.model-card.delay-300) { transition-delay: 450ms, 450ms, 0s, 0s, 0s !important; }
  :global(.model-card.delay-400) { transition-delay: 600ms, 600ms, 0s, 0s, 0s !important; }
  :global(.model-card.delay-500) { transition-delay: 750ms, 750ms, 0s, 0s, 0s !important; }
  :global(.model-card.delay-600) { transition-delay: 900ms, 900ms, 0s, 0s, 0s !important; }
  :global(.model-card.delay-700) { transition-delay: 1050ms, 1050ms, 0s, 0s, 0s !important; }

  :global(.model-card:hover) {
    transform: translateY(-4px) !important;
    border-color: rgba(0, 255, 157, 0.4) !important;
    background: rgba(255, 255, 255, 0.05) !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.12), 0 0 24px rgba(0, 255, 157, 0.15) !important;
    transition-delay: 0s, 0s, 0s, 0s, 0s !important; 
  }

  .model-thumb {
    position: relative;
    display: grid;
    aspect-ratio: 16 / 10;
    width: 100%;
    place-items: center;
    align-content: center;
    gap: 0.4rem;
    border: 1px solid rgba(0, 255, 157, 0.2);
    border-radius: 12px;
    background:
      linear-gradient(160deg, rgba(0, 255, 157, 0.12) 0%, rgba(10, 10, 12, 0.9) 55%),
      repeating-linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.04) 0 8px,
        transparent 8px 16px
      );
    color: var(--color-primary-neon);
    overflow: hidden;
  }

  .model-thumb--image {
    padding: 0;
    background: #0d0d11;
  }

  .model-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: 11px;
    transition: transform 0.3s ease;
  }

  .model-card:hover .model-thumb-img {
    transform: scale(1.04);
  }

  .model-thumb-brand {
    color: var(--color-text-secondary);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .model-niche {
    margin: 0.35rem 0 0;
    color: var(--color-primary-neon);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .model-name {
    margin: 0;
    color: var(--color-text-primary);
    font-size: 1.2rem;
    font-weight: 700;
  }

  .model-focus {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .model-status {
    margin: 0.35rem 0 0;
    justify-self: start;
    padding: 0.25rem 0.7rem;
    border: 1px solid rgba(0, 255, 157, 0.35);
    border-radius: 100px;
    background: rgba(0, 255, 157, 0.08);
    color: var(--color-primary-neon);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .model-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.35rem 0 0;
    justify-self: start;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgba(0, 255, 157, 0.45);
    border-radius: 100px;
    background: rgba(0, 255, 157, 0.12);
    color: var(--color-primary-neon);
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .model-action-btn:hover {
    background: rgba(0, 255, 157, 0.25);
    border-color: var(--color-primary-neon);
    box-shadow: 0 0 15px rgba(0, 255, 157, 0.2);
    transform: translateY(-1px);
  }

  .model-action-btn:focus-visible {
    outline: 2px solid var(--color-primary-neon);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .models-arrow {
      transition: none;
    }
    .models-arrow:hover,
    .models-arrow:active {
      transform: translateY(-50%);
    }
    .model-action-btn,
    .model-thumb-img {
      transition: none;
      transform: none;
    }
    .model-card:hover .model-thumb-img {
      transform: none;
    }
  }
</style>

<script>
  const setupModelsTrack = () => {
    const track = document.getElementById('modelos-track');
    const prev = document.getElementById('modelos-prev');
    const next = document.getElementById('modelos-next');
    if (!track || !prev || !next) return;
    
    // Cleanup de eventos anteriores se o componente for remontado no Astro
    if (track.dataset.autoplayInterval) {
      clearInterval(Number(track.dataset.autoplayInterval));
    }

    if (prev.dataset.bound === 'true') return;
    prev.dataset.bound = 'true';
    next.dataset.bound = 'true';

    const step = () => {
      const card = track.querySelector('.model-card');
      if (!(card instanceof HTMLElement)) return 0;
      const styles = getComputedStyle(track);
      const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const behavior = isReducedMotion ? 'auto' : 'smooth';

    const scrollPrev = () => {
      track.scrollBy({ left: -step(), behavior });
    };

    const scrollNext = () => {
      // Se chegou no final (com uma margem de erro de 10px), volta pro começo
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) {
        track.scrollTo({ left: 0, behavior });
      } else {
        track.scrollBy({ left: step(), behavior });
      }
    };

    prev.addEventListener('click', () => {
      scrollPrev();
      resetAutoplay();
    });
    
    next.addEventListener('click', () => {
      scrollNext();
      resetAutoplay();
    });

    // Autoplay logic
    let autoplayTimer = 0;
    
    const startAutoplay = () => {
      if (isReducedMotion) return; // Regra G2
      stopAutoplay();
      autoplayTimer = setInterval(scrollNext, 3000); // 3 segundos
      track.dataset.autoplayInterval = String(autoplayTimer);
    };

    const stopAutoplay = () => {
      clearInterval(autoplayTimer);
    };

    const resetAutoplay = () => {
      stopAutoplay();
      startAutoplay();
    };

    // Pausa quando o usuário passa o mouse ou interage com os botões/cards
    track.addEventListener('mouseenter', stopAutoplay);
    track.addEventListener('mouseleave', startAutoplay);
    track.addEventListener('touchstart', stopAutoplay, { passive: true });
    track.addEventListener('touchend', startAutoplay, { passive: true });
    track.addEventListener('focusin', stopAutoplay);
    track.addEventListener('focusout', startAutoplay);
    prev.addEventListener('mouseenter', stopAutoplay);
    prev.addEventListener('mouseleave', startAutoplay);
    next.addEventListener('mouseenter', stopAutoplay);
    next.addEventListener('mouseleave', startAutoplay);

    startAutoplay();
  };

  setupModelsTrack();
  document.addEventListener('astro:page-load', () => {
    setupModelsTrack();
  });
</script>
