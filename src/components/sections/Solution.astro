---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import solutionMockup from '../../assets/images/solution-mechanism-mockup.webp';

const mechanismSteps = [
  { num: '01', title: 'CLAREZA', desc: 'O visitante entende rapidamente o que você oferece.' },
  { num: '02', title: 'INTERESSE', desc: 'A página mostra por que sua solução importa para ele.' },
  { num: '03', title: 'CONFIANÇA', desc: 'Argumentos, conteúdo e provas reduzem a insegurança antes do contato.' },
  { num: '04', title: 'AÇÃO', desc: 'O próximo passo fica claro e fácil de executar.' },
];
---

<section id="mecanismo" class="section-solution scrolly-section section-fade-top section-fade-bottom">
  <div class="scrolly scrolly--5">
    <div class="scrolly__stage">
      <div class="neon-glow"></div>

      <div class="container">
        <!-- Ordem scroll: título → sequência de passos → mockup → fechamento -->
        <div class="solution-content">
          <div class="solution-text-col">
            <h2 class="solution-title scrolly-step s-1">
              <span class="solution-title-line">Não é só design</span>
              <span class="solution-title-line text-neon">É uma sequência</span>
            </h2>

            <!-- Diagrama visual do fluxo -->
            <div class="mechanism-flow scrolly-step s-2" aria-label="Sequência de persuasão">
              <span class="flow-tag">CLAREZA</span>
              <span class="flow-arrow"><Icon name="arrow-right" size={14} stroke={2.5} /></span>
              <span class="flow-tag">INTERESSE</span>
              <span class="flow-arrow"><Icon name="arrow-right" size={14} stroke={2.5} /></span>
              <span class="flow-tag">CONFIANÇA</span>
              <span class="flow-arrow"><Icon name="arrow-right" size={14} stroke={2.5} /></span>
              <span class="flow-tag flow-tag--action">AÇÃO</span>
            </div>

            <!-- 4 Passos Conceituais -->
            <div class="mechanism-steps scrolly-step s-3">
              {mechanismSteps.map((step) => (
                <div class="mechanism-item">
                  <span class="step-num-badge">{step.num}</span>
                  <div class="step-info">
                    <strong>{step.title}</strong>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="solution-mockup-col scrolly-step from-scale s-4">
            <div class="solution-mockup-frame">
              <Image
                src={solutionMockup}
                alt="Mockup do mecanismo de conversão: sequência estratégica da visita ao lead qualificado no WhatsApp"
                class="solution-mockup-img"
                widths={[360, 600, 930]}
                sizes="(max-width: 767px) 92vw, (max-width: 1024px) 500px, 600px"
                loading="lazy"
                decoding="async"
                quality={82}
              />
            </div>
          </div>

          <p class="solution-closing scrolly-step s-5">
            Cada seção tem uma função: fazer o visitante <span class="text-neon">continuar, entender, confiar e agir</span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-solution {
    background-color: #030303;
    overflow: clip;
  }

  .neon-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.1) 0%, rgba(0, 0, 0, 0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  .container {
    width: 100%;
    max-width: 1200px;
  }

  .solution-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .solution-content {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto auto;
      align-items: start;
      gap: 1.25rem 3rem;
      text-align: left;
    }

    .solution-text-col {
      grid-column: 1;
      grid-row: 1;
    }

    .solution-mockup-col {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
    }

    .solution-closing {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .solution-text-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .solution-text-col {
      align-items: flex-start;
      gap: 1.25rem;
    }
  }

  .solution-mockup-col {
    width: 100%;
    max-width: 240px;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .solution-mockup-col {
      max-width: none;
      justify-self: stretch;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  .solution-mockup-frame {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.75)) drop-shadow(0 0 40px rgba(0, 255, 157, 0.14));
    transition: transform 0.3s ease;
  }

  .solution-mockup-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1860 / 1103;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .solution-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .solution-title-line {
    display: block;
  }

  @media (min-width: 768px) {
    .solution-title {
      font-size: 2.25rem;
    }
  }

  .solution-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .solution-text {
      font-size: 1.125rem;
    }
  }

  /* Diagrama de fluxo do mecanismo */
  .mechanism-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.25rem 0 0.5rem;
  }

  .flow-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
  }

  .flow-tag--action {
    background: rgba(0, 255, 157, 0.15);
    border-color: rgba(0, 255, 157, 0.4);
    color: var(--color-primary-neon);
  }

  .flow-arrow {
    color: rgba(255, 255, 255, 0.35);
    display: grid;
    place-items: center;
  }

  /* 4 Passos Conceituais */
  .mechanism-steps {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    text-align: left;
  }

  .mechanism-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    transition: border-color 0.2s ease;
  }

  .mechanism-item:hover {
    border-color: rgba(0, 255, 157, 0.3);
  }

  .step-num-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.1);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 157, 0.25);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .step-info strong {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.03em;
    margin-bottom: 0.15rem;
  }

  .step-info p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .mechanism-steps {
      gap: 0.85rem;
    }
    .mechanism-item {
      padding: 0.85rem 1rem;
    }
    .step-info strong {
      font-size: 0.95rem;
    }
    .step-info p {
      font-size: 0.9rem;
    }
    .flow-tag {
      font-size: 0.8rem;
      padding: 0.3rem 0.75rem;
    }
  }

  .solution-closing {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .solution-closing {
      font-size: 1.125rem;
      max-width: none;
    }
  }

  /* Mobile: proporção equilibrada e segura para dispositivo físico (iPhone 15) */
  @media (max-width: 767px) {
    .section-solution .scrolly__stage {
      padding-top: max(calc(env(safe-area-inset-top, 0px) + 2.75rem), 3.5rem);
      padding-bottom: max(calc(env(safe-area-inset-bottom, 0px) + 3.25rem), 4rem);
      padding-left: 1rem;
      padding-right: 1rem;
      justify-content: center;
    }

    .neon-glow {
      width: 260px;
      height: 260px;
    }

    .solution-content {
      width: 100%;
      height: auto;
      margin: auto 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: clamp(0.35rem, 1.2vh, 0.65rem);
    }

    .solution-text-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(0.3rem, 1vh, 0.55rem);
      width: 100%;
    }

    .solution-title {
      font-size: clamp(1.15rem, 3.5vw, 1.35rem);
      line-height: 1.18;
      text-align: center;
      margin: 0;
    }

    .mechanism-flow {
      margin: 0.1rem 0 0.2rem;
      gap: 0.25rem;
      justify-content: center;
    }

    .flow-tag {
      font-size: 0.65rem;
      padding: 0.18rem 0.45rem;
      letter-spacing: 0.04em;
    }

    .flow-arrow {
      transform: scale(0.8);
      opacity: 0.6;
    }

    /* Grid 2x2 para os 4 passos no mobile */
    .mechanism-steps {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.45rem;
      width: 100%;
      margin: 0;
    }

    .mechanism-item {
      padding: 0.45rem 0.6rem;
      gap: 0.45rem;
      border-radius: 7px;
      align-items: flex-start;
    }

    .step-num-badge {
      font-size: 0.65rem;
      padding: 0.12rem 0.35rem;
    }

    .step-info strong {
      font-size: 0.78rem;
      margin-bottom: 0.08rem;
    }

    .step-info p {
      font-size: 0.68rem;
      line-height: 1.24;
    }

    .solution-mockup-col {
      max-width: none;
      width: 100%;
      display: flex;
      justify-content: center;
      margin: 0.15rem 0;
    }

    .solution-mockup-frame {
      width: 100%;
      max-width: min(100%, 315px);
    }

    .solution-mockup-img {
      width: 100%;
      height: auto;
      aspect-ratio: 1860 / 1103;
    }

    .solution-closing {
      font-size: 0.78rem;
      line-height: 1.32;
      text-align: center;
      padding: 0;
      margin: 0.15rem 0 0;
      max-width: 95%;
    }
  }
</style>
