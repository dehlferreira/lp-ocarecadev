<script>
  const setupSolutionCascade = () => {
    // Respeita preferência de redução de movimento (G2)
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const section = document.getElementById('mecanismo');
    const content = document.getElementById('solution-content');
    if (!section || !content) return;

    content.classList.add('solution-anim-ready');
    // Remove qualquer is-revealed global pré-existente
    content.querySelectorAll('.is-revealed').forEach((el) => el.classList.remove('is-revealed'));

    let isTriggered = false;
    let cachedSectionHeight = section.offsetHeight;

    window.addEventListener('resize', () => {
      cachedSectionHeight = section.offsetHeight;
    }, { passive: true });

    const checkAndTrigger = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const sectionHeight = cachedSectionHeight || section.offsetHeight;

      // Dispara quando descer cerca de ~42% ou 340px da seção
      const visibleFromTop = windowHeight - rect.top;
      const triggerThreshold = Math.min(sectionHeight * 0.42, 340);
      const resetThreshold = Math.max(triggerThreshold - 120, 80);

      // Ao descer o scroll e atingir o triggerThreshold: dispara sequência de energia
      if (visibleFromTop >= triggerThreshold && rect.bottom > 80) {
        if (!isTriggered) {
          isTriggered = true;
          content.classList.add('is-solution-in');
        }
      } else if (visibleFromTop < resetThreshold || rect.top > windowHeight - 40) {
        // Ao voltar o scroll para cima: desfaz a animação inteira suavemente
        if (isTriggered) {
          isTriggered = false;
          content.classList.remove('is-solution-in');
          content.querySelectorAll('.is-revealed').forEach((el) => el.classList.remove('is-revealed'));
        }
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          checkAndTrigger();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    checkAndTrigger();
  };

  setupSolutionCascade();
  document.addEventListener('astro:page-load', setupSolutionCascade);
</script>
