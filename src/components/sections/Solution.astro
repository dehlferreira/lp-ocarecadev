    /* Remove backdrop-filter dos mechanism-item: cada um cria uma camada de composição separada */
    .mechanism-item {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      background: rgba(18, 22, 28, 0.72) !important;
