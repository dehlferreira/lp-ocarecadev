---
import HeroMockup from '../ui/HeroMockup.astro';
import Icon from '../ui/Icon.astro';
---

<section id="solucao" class="section-solution scrolly-section section-fade-top section-fade-bottom">
  <div class="scrolly scrolly--5" style="--scrolly-track: 340vh; --scrolly-track-mobile: 190vh;">
    <div class="scrolly__stage">
      <div class="neon-glow"></div>

      <div class="container">
        <!-- Ordem scroll (SPEC-009): título → texto → highlight → mockup → fechamento -->
        <div class="solution-content">
          <div class="solution-text-col">
            <h2 class="solution-title scrolly-step s-1">
              <span class="solution-title-line">Agora imagina ter uma página</span>
              <span class="solution-title-line">que trabalha por você todos os dias</span>
            </h2>

            <p class="solution-text scrolly-step s-2">
              Na OCARECADEV, nós não criamos "sites bonitos".
            </p>

            <p class="solution-highlight scrolly-step from-scale s-3">
              <span class="highlight-icon"><Icon name="arrow-right" size={18} stroke={2.5} /></span>
              <span>Nós criamos páginas pensadas para gerar <span class="text-neon">clientes</span>.</span>
            </p>
          </div>

          <div class="solution-mockup-col scrolly-step from-scale s-4">
            <HeroMockup compact />
          </div>

          <p class="solution-closing scrolly-step s-5">
            Cada detalhe é feito para fazer o visitante clicar e virar <span class="text-neon">cliente</span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-solution {
    background-color: #030303;
    overflow: clip;
  }

  .neon-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.1) 0%, rgba(0, 0, 0, 0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  .container {
    width: 100%;
    max-width: 1200px;
  }

  .solution-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .solution-content {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto auto;
      align-items: start;
      gap: 1.25rem 3rem;
      text-align: left;
    }

    .solution-text-col {
      grid-column: 1;
      grid-row: 1;
    }

    .solution-mockup-col {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
    }

    .solution-closing {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .solution-text-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .solution-text-col {
      align-items: flex-start;
      gap: 1.25rem;
    }
  }

  .solution-mockup-col {
    width: 100%;
    max-width: 240px;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .solution-mockup-col {
      max-width: none;
      justify-self: stretch;
    }
  }

  .solution-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .solution-title-line {
    display: block;
  }

  @media (min-width: 768px) {
    .solution-title {
      font-size: 2.25rem;
    }
  }

  .solution-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .solution-text {
      font-size: 1.125rem;
    }
  }

  .solution-highlight {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    background: rgba(0, 255, 157, 0.05);
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    border: 1px solid rgba(0, 255, 157, 0.2);
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    text-align: left;
    max-width: 100%;
  }

  .solution-highlight .highlight-icon {
    display: inline-flex;
    color: var(--color-primary-neon);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  @media (min-width: 768px) {
    .solution-highlight {
      font-size: 1.35rem;
      padding: 1.25rem 1.5rem;
      gap: 0.6rem;
    }
  }

  .solution-closing {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .solution-closing {
      font-size: 1.125rem;
      max-width: none;
    }
  }

  /* Mobile: comprime tudo para caber no palco pinado (100svh) */
  @media (max-width: 767px) {
    .neon-glow {
      width: 280px;
      height: 280px;
    }

    .solution-content {
      gap: 0.9rem;
    }

    .solution-text-col {
      gap: 0.75rem;
    }

    .solution-title {
      font-size: 1.1rem;
    }

    .solution-text {
      font-size: 0.875rem;
    }

    .solution-highlight {
      font-size: 0.875rem;
      padding: 0.55rem 0.75rem;
      justify-content: center;
      text-align: center;
    }

    .solution-highlight .highlight-icon {
      display: none;
    }

    .solution-mockup-col {
      max-width: none;
    }

    .solution-closing {
      font-size: 0.85rem;
      padding: 0 0.25rem;
    }
  }
</style>
