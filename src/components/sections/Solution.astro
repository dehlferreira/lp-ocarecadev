  /* Ajuste das direções para mobile + otimizações de performance */
  @media (max-width: 767px) {
    #solution-content.solution-anim-ready:not(.is-solution-in) .mechanism-item,
    .solution-content.solution-anim-ready:not(.is-solution-in) .mechanism-item {
