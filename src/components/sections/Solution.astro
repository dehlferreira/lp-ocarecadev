---
import HeroMockup from '../ui/HeroMockup.astro';
import Icon from '../ui/Icon.astro';

const mechanismSteps = [
  { num: '01', title: 'CLAREZA', desc: 'O visitante entende rapidamente o que você oferece.' },
  { num: '02', title: 'INTERESSE', desc: 'A página mostra por que sua solução importa para ele.' },
  { num: '03', title: 'CONFIANÇA', desc: 'Argumentos, conteúdo e provas reduzem a insegurança antes do contato.' },
  { num: '04', title: 'AÇÃO', desc: 'O próximo passo fica claro e fácil de executar.' },
];
---

<section id="mecanismo" class="section-solution scrolly-section section-fade-top section-fade-bottom">
  <div class="scrolly scrolly--5" style="--scrolly-track: 340vh; --scrolly-track-mobile: 190vh;">
    <div class="scrolly__stage">
      <div class="neon-glow"></div>

      <div class="container">
        <!-- Ordem scroll: título → sequência de passos → mockup → fechamento -->
        <div class="solution-content">
          <div class="solution-text-col">
            <h2 class="solution-title scrolly-step s-1">
              <span class="solution-title-line">Não é só design</span>
              <span class="solution-title-line text-neon">É uma sequência</span>
            </h2>

            <!-- Diagrama visual do fluxo -->
            <div class="mechanism-flow scrolly-step s-2" aria-label="Sequência de persuasão">
              <span class="flow-tag">CLAREZA</span>
              <span class="flow-arrow"><Icon name="arrow-right" size={14} stroke={2.5} /></span>
              <span class="flow-tag">INTERESSE</span>
              <span class="flow-arrow"><Icon name="arrow-right" size={14} stroke={2.5} /></span>
              <span class="flow-tag">CONFIANÇA</span>
              <span class="flow-arrow"><Icon name="arrow-right" size={14} stroke={2.5} /></span>
              <span class="flow-tag flow-tag--action">AÇÃO</span>
            </div>

            <!-- 4 Passos Conceituais -->
            <div class="mechanism-steps scrolly-step s-3">
              {mechanismSteps.map((step) => (
                <div class="mechanism-item">
                  <span class="step-num-badge">{step.num}</span>
                  <div class="step-info">
                    <strong>{step.title}</strong>
                    <p>{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="solution-mockup-col scrolly-step from-scale s-4">
            <HeroMockup compact />
          </div>

          <p class="solution-closing scrolly-step s-5">
            Cada seção tem uma função: fazer o visitante <span class="text-neon">continuar, entender, confiar e agir</span>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-solution {
    background-color: #030303;
    overflow: clip;
  }

  .neon-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.1) 0%, rgba(0, 0, 0, 0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  .container {
    width: 100%;
    max-width: 1200px;
  }

  .solution-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .solution-content {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto auto;
      align-items: start;
      gap: 1.25rem 3rem;
      text-align: left;
    }

    .solution-text-col {
      grid-column: 1;
      grid-row: 1;
    }

    .solution-mockup-col {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: stretch;
    }

    .solution-closing {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .solution-text-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .solution-text-col {
      align-items: flex-start;
      gap: 1.25rem;
    }
  }

  .solution-mockup-col {
    width: 100%;
    max-width: 240px;
    min-width: 0;
  }

  @media (min-width: 768px) {
    .solution-mockup-col {
      max-width: none;
      justify-self: stretch;
    }
  }

  .solution-title {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.2;
  }

  .solution-title-line {
    display: block;
  }

  @media (min-width: 768px) {
    .solution-title {
      font-size: 2.25rem;
    }
  }

  .solution-text {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .solution-text {
      font-size: 1.125rem;
    }
  }

  /* Diagrama de fluxo do mecanismo */
  .mechanism-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.25rem 0 0.5rem;
  }

  .flow-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.85);
  }

  .flow-tag--action {
    background: rgba(0, 255, 157, 0.15);
    border-color: rgba(0, 255, 157, 0.4);
    color: var(--color-primary-neon);
  }

  .flow-arrow {
    color: rgba(255, 255, 255, 0.35);
    display: grid;
    place-items: center;
  }

  /* 4 Passos Conceituais */
  .mechanism-steps {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    width: 100%;
    text-align: left;
  }

  .mechanism-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    transition: border-color 0.2s ease;
  }

  .mechanism-item:hover {
    border-color: rgba(0, 255, 157, 0.3);
  }

  .step-num-badge {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.1);
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 255, 157, 0.25);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .step-info strong {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.03em;
    margin-bottom: 0.15rem;
  }

  .step-info p {
    margin: 0;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .mechanism-steps {
      gap: 0.85rem;
    }
    .mechanism-item {
      padding: 0.85rem 1rem;
    }
    .step-info strong {
      font-size: 0.95rem;
    }
    .step-info p {
      font-size: 0.9rem;
    }
    .flow-tag {
      font-size: 0.8rem;
      padding: 0.3rem 0.75rem;
    }
  }

  .solution-closing {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.45;
    max-width: 100%;
  }

  @media (min-width: 768px) {
    .solution-closing {
      font-size: 1.125rem;
      max-width: none;
    }
  }

  /* Mobile: ocupa todo o espaço vertical liberado com espaçamento confortável */
  @media (max-width: 767px) {
    .neon-glow {
      width: 280px;
      height: 280px;
    }

    .solution-content {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 0.65rem;
    }

    .solution-text-col {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .solution-title {
      font-size: 1.35rem;
      line-height: 1.2;
    }

    .mechanism-flow {
      margin: 0.2rem 0 0.4rem;
      gap: 0.35rem;
    }

    .flow-tag {
      font-size: 0.72rem;
      padding: 0.22rem 0.6rem;
    }

    .flow-arrow {
      transform: scale(0.9);
    }

    /* Grid 2x2 para os 4 passos no mobile */
    .mechanism-steps {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.55rem;
    }

    .mechanism-item {
      padding: 0.6rem 0.75rem;
      gap: 0.55rem;
      border-radius: 8px;
    }

    .step-num-badge {
      font-size: 0.72rem;
      padding: 0.15rem 0.4rem;
    }

    .step-info strong {
      font-size: 0.85rem;
      margin-bottom: 0.1rem;
    }

    .step-info p {
      font-size: 0.74rem;
      line-height: 1.3;
    }

    .solution-mockup-col {
      max-width: none;
    }

    .solution-closing {
      font-size: 0.88rem;
      line-height: 1.4;
      padding: 0.25rem 0;
    }
  }
</style>
