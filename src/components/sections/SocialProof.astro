---
import GlassCard from '../ui/GlassCard.astro';
import Icon from '../ui/Icon.astro';

const benefits = [
  'Mais mensagens no WhatsApp',
  'Mais pedidos de orcamento',
  'Mais <span class="text-neon">clientes</span> entrando todos os dias',
];

const testimonials = [
  {
    initials: 'RA',
    tone: 'tone-neon',
    name: 'Roberto Almeida',
    role: 'CEO, TechGrowth',
    text: '"Nossas conversoes dobraram na primeira semana apos o lancamento. O design e a velocidade da pagina sao absurdos."',
  },
  {
    initials: 'MC',
    tone: 'tone-blue',
    name: 'Mariana Costa',
    role: 'Mentora de Vendas',
    text: '"Sempre sofri com sites lentos que perdiam clientes no meio do caminho. A OCARECADEV resolveu isso e entregou uma verdadeira maquina de vendas."',
  },
  {
    initials: 'CM',
    tone: 'tone-coral',
    name: 'Carlos Moura',
    role: 'Socio, Agencia XYZ',
    text: '"Ter um codigo limpo e analytics injetado certinho nos botoes me economizou muito tempo. O tracking funciona perfeitamente."',
  },
];
---

<section id="social-proof" class="section-social section-fade-top section-fade-bottom" style="--fade-from: #010101;">
  <div class="container">
    <div class="proof-content">
      <header class="section-header">
        <h2 class="section-title"><span class="text-neon">Resultados</span> falam mais que qualquer promessa</h2>
        <ul class="section-subtitle-list">
          {benefits.map((benefit) => (
            <li>
              <span class="check-icon"><Icon name="check" size={15} stroke={3} /></span>
              <span set:html={benefit} />
            </li>
          ))}
        </ul>
      </header>

      <div class="proof-grid">
        {testimonials.map((testimonial) => (
          <GlassCard class="proof-card" padding="1.4rem">
            <div class="proof-author">
              <div class:list={['avatar-placeholder', testimonial.tone]}>{testimonial.initials}</div>
              <div class="author-info">
                <h3>{testimonial.name}</h3>
                <span>{testimonial.role}</span>
              </div>
            </div>
            <p class="proof-text">{testimonial.text}</p>
            <div class="stars" role="img" aria-label="Avaliação: 5 de 5 estrelas">
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={17} />)}
            </div>
          </GlassCard>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section-social { position: relative; padding: 5.5rem 0; background: #010101; }
  .proof-content { width: 100%; }
  .section-header { max-width: 860px; margin: 0 auto 2.5rem; text-align: center; }
  .section-title { margin: 0; color: var(--color-text-primary); font-size: 2.6rem; font-weight: 800; line-height: 1.12; }
  .section-subtitle-list { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.65rem 1.6rem; padding: 0; margin: 1.35rem 0 0; color: var(--color-text-secondary); font-size: 0.98rem; list-style: none; }
  .section-subtitle-list li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .check-icon { display: grid; width: 22px; height: 22px; place-items: center; flex: 0 0 22px; border: 1px solid rgba(0, 255, 157, 0.3); border-radius: 50%; color: var(--color-primary-neon); background: rgba(0, 255, 157, 0.08); }
  .proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  :global(.proof-card) { display: flex; min-width: 0; flex-direction: column; border-radius: 8px; }
  .proof-author { display: flex; align-items: center; gap: 0.75rem; }
  .avatar-placeholder { display: grid; width: 42px; height: 42px; place-items: center; flex: 0 0 42px; border-radius: 50%; color: #07120d; font-size: 0.83rem; font-weight: 900; }
  .tone-neon { background: var(--color-primary-neon); }
  .tone-blue { color: #fff; background: #2673e8; }
  .tone-coral { color: #1b0a05; background: #ff875d; }
  .author-info h3 { margin: 0; color: var(--color-text-primary); font-size: 1rem; line-height: 1.2; }
  .author-info span { display: block; margin-top: 0.16rem; color: var(--color-text-secondary); font-size: 0.78rem; }
  .proof-text { flex: 1; margin: 1.1rem 0 0; color: #e7e7e7; font-size: 0.92rem; font-style: italic; line-height: 1.55; }
  .stars { display: flex; gap: 3px; margin-top: 1.1rem; color: var(--color-primary-neon); }
  @media (max-width: 767px) { .section-social { padding: 4rem 0; } .section-header { margin-bottom: 1.75rem; text-align: left; } .section-title { font-size: 1.75rem; } .section-subtitle-list { display: grid; justify-content: start; gap: 0.55rem; margin-top: 1.1rem; font-size: 0.9rem; } .proof-grid { grid-template-columns: 1fr; gap: 0.85rem; } :global(.proof-card) { padding: 1.15rem !important; } .proof-text { margin-top: 0.9rem; font-size: 0.88rem; } }
</style>
