---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import proofVinicius from '../../assets/images/proof-whatsapp-vinicius.webp';
import proofCarrera from '../../assets/images/proof-instagram-carrera.webp';
import proofRenato from '../../assets/images/proof-whatsapp-renato.webp';

const benefits = [
  'Mais clareza na apresentação da sua oferta',
  'Mais mensagens qualificadas no WhatsApp',
  'Experiência profissional elogiada por quem já contratou',
];

// Barras da waveform em pixels fixos (4px a 28px) garantindo renderização 100% confiável
const waveformPixels1 = [
  6, 10, 16, 8, 22, 28, 24, 18, 26, 20, 14, 25, 28, 22, 18, 26, 22, 16,
  24, 28, 20, 15, 25, 20, 15, 22, 18, 12, 18, 14, 10, 16, 10, 8, 6, 4
];

const waveformPixels2 = [
  5, 9, 15, 20, 24, 28, 22, 27, 24, 18, 26, 28, 24, 19, 25, 27, 21, 16,
  25, 28, 23, 17, 26, 22, 17, 23, 19, 13, 20, 15, 11, 17, 10, 8, 6, 4
];
---

<section id="social-proof" class="section-social section-fade-top section-fade-bottom" style="--fade-from: #010101;">
  <div class="container">
    <div class="proof-wrapper">
      <header class="section-header">
        <h2 class="section-title">Não acredita no Careca? <span class="text-neon">Pergunta pra quem já contratou</span></h2>
        <ul class="section-subtitle-list">
          {benefits.map((benefit) => (
            <li>
              <span class="check-icon"><Icon name="check" size={15} stroke={3} /></span>
              <span set:html={benefit} />
            </li>
          ))}
        </ul>
      </header>

      <!-- GRUPO 1: ÁUDIOS REAIS DO WHATSAPP COM PLAYER NATIVO ESTILO WHATSAPP -->
      <div class="proof-group">
        <div class="group-header">
          <span class="group-badge">
            <span class="pulse-dot"></span>
            Mensagens de Voz Autênticas
          </span>
          <p class="group-desc">Ouça feedbacks reais enviados por clientes e parceiros no WhatsApp</p>
        </div>

        <div class="proof-grid">
          <!-- CARD ÁUDIO 1: CLIENTE (30s) -->
          <div class="proof-card audio-card">
            <div class="card-header">
              <div class="user-info">
                <div class="avatar-circle avatar-whatsapp" aria-hidden="true">
                  <Icon name="whatsapp" size={22} />
                </div>
                <div class="user-text">
                  <h3 class="user-name">Áudio de Cliente</h3>
                  <span class="user-sub">Áudio verificado • 0:30</span>
                </div>
              </div>
              <span class="pill-tag">Recomendação</span>
            </div>

            <blockquote class="card-quote">
              &ldquo;Depois não esquece de agradecer o André lá pelo projeto... ficou muito top!&rdquo;
            </blockquote>

            <!-- PLAYER WHATSAPP REFINADO -->
            <div class="wa-audio-balloon" data-audio-player="player-1">
              <div class="wa-balloon-inner">
                <!-- Avatar com indicador de microfone -->
                <div class="wa-mic-avatar" aria-hidden="true">
                  <div class="wa-mic-icon-circle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                      <line x1="12" y1="19" x2="12" y2="23"></line>
                      <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                  </div>
                  <span class="wa-mic-status-dot" title="Mensagem de voz"></span>
                </div>

                <!-- Botão Play/Pause estilo WhatsApp Neon -->
                <button
                  type="button"
                  class="wa-play-btn"
                  aria-label="Reproduzir áudio do cliente"
                  title="Reproduzir áudio"
                >
                  <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <polygon points="6 3 20 12 6 21 6 3"></polygon>
                  </svg>
                  <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display: none;">
                    <rect x="6" y="4" width="4" height="16" rx="1"></rect>
                    <rect x="14" y="4" width="4" height="16" rx="1"></rect>
                  </svg>
                </button>

                <!-- Área Central da Onda Sonora do WhatsApp -->
                <div class="wa-track-wrap">
                  <div class="wa-waveform" role="progressbar" aria-label="Progresso do áudio" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" tabindex="0">
                    {waveformPixels1.map((px, i) => (
                      <span
                        class="wa-bar"
                        style={`height: ${px}px;`}
                        data-bar-index={i}
                      ></span>
                    ))}
                  </div>

                  <div class="wa-audio-meta">
                    <span class="wa-time">0:00 / 0:30</span>
                    <span class="wa-check-status" aria-hidden="true" title="Entregue e verificado">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00ff9d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>

                <!-- Botão de Velocidade (1x / 1.5x / 2x) -->
                <button
                  type="button"
                  class="wa-speed-btn"
                  aria-label="Alterar velocidade de reprodução do áudio (atual 1x)"
                  title="Alterar velocidade"
                >
                  1x
                </button>
              </div>

              <!-- Elemento de Áudio Oculto com fallback MP3 e MP4 -->
              <audio class="wa-native-audio" preload="none">
                <source src="/audio/social-proof-audio-1.mp3" type="audio/mpeg" />
                <source src="/videos/social-proof-audio-1.mp4" type="audio/mp4" />
              </audio>
            </div>

            <!-- Transcrição Acessível -->
            <details class="transcript-box">
              <summary class="transcript-summary">
                <span>Ler transcrição do áudio</span>
                <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="transcript-body">
                <p>&ldquo;E aí irmão beleza? Ô deixa eu te falar: depois não esquece de agradecer o André lá hem pelo pelo projeto... o trabalho ficou fera demais!&rdquo;</p>
              </div>
            </details>

            <div class="card-bottom">
              <div class="stars" role="img" aria-label="Avaliação: 5 de 5 estrelas">
                {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
              </div>
              <span class="bottom-label">Áudio no WhatsApp</span>
            </div>
          </div>

          <!-- CARD ÁUDIO 2: PARCEIRO (54s) -->
          <div class="proof-card audio-card">
            <div class="card-header">
              <div class="user-info">
                <div class="avatar-circle avatar-whatsapp" aria-hidden="true">
                  <Icon name="whatsapp" size={22} />
                </div>
                <div class="user-text">
                  <h3 class="user-name">Parceiro de Negócios</h3>
                  <span class="user-sub">Áudio verificado • 0:54</span>
                </div>
              </div>
              <span class="pill-tag">Parceria</span>
            </div>

            <blockquote class="card-quote">
              &ldquo;Dar um feedback sobre o serviço executado pelo nosso parceiro seu André...&rdquo;
            </blockquote>

            <!-- PLAYER WHATSAPP REFINADO -->
            <div class="wa-audio-balloon" data-audio-player="player-2">
              <div class="wa-balloon-inner">
                <!-- Avatar com indicador de microfone -->
                <div class="wa-mic-avatar" aria-hidden="true">
                  <div class="wa-mic-icon-circle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                      <line x1="12" y1="19" x2="12" y2="23"></line>
                      <line x1="8" y1="23" x2="16" y2="23"></line>
                    </svg>
                  </div>
                  <span class="wa-mic-status-dot" title="Mensagem de voz"></span>
                </div>

                <!-- Botão Play/Pause estilo WhatsApp Neon -->
                <button
                  type="button"
                  class="wa-play-btn"
                  aria-label="Reproduzir áudio do parceiro"
                  title="Reproduzir áudio"
                >
                  <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <polygon points="6 3 20 12 6 21 6 3"></polygon>
                  </svg>
                  <svg class="icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display: none;">
                    <rect x="6" y="4" width="4" height="16" rx="1"></rect>
                    <rect x="14" y="4" width="4" height="16" rx="1"></rect>
                  </svg>
                </button>

                <!-- Área Central da Onda Sonora do WhatsApp -->
                <div class="wa-track-wrap">
                  <div class="wa-waveform" role="progressbar" aria-label="Progresso do áudio" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" tabindex="0">
                    {waveformPixels2.map((px, i) => (
                      <span
                        class="wa-bar"
                        style={`height: ${px}px;`}
                        data-bar-index={i}
                      ></span>
                    ))}
                  </div>

                  <div class="wa-audio-meta">
                    <span class="wa-time">0:00 / 0:54</span>
                    <span class="wa-check-status" aria-hidden="true" title="Entregue e verificado">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00ff9d" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                  </div>
                </div>

                <!-- Botão de Velocidade (1x / 1.5x / 2x) -->
                <button
                  type="button"
                  class="wa-speed-btn"
                  aria-label="Alterar velocidade de reprodução do áudio (atual 1x)"
                  title="Alterar velocidade"
                >
                  1x
                </button>
              </div>

              <!-- Elemento de Áudio Oculto com fallback MP3 e MP4 -->
              <audio class="wa-native-audio" preload="none">
                <source src="/audio/social-proof-audio-2.mp3" type="audio/mpeg" />
                <source src="/videos/social-proof-audio-2.mp4" type="audio/mp4" />
              </audio>
            </div>

            <!-- Transcrição Acessível -->
            <details class="transcript-box">
              <summary class="transcript-summary">
                <span>Ler transcrição do áudio</span>
                <svg class="arrow-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="transcript-body">
                <p>&ldquo;Dar um feedback aí pro serviço executado pelo nosso parceiro de negócios aí, seu André... nós ficamos muito satisfeitos com a qualidade e o comprometimento entregue.&rdquo;</p>
              </div>
            </details>

            <div class="card-bottom">
              <div class="stars" role="img" aria-label="Avaliação: 5 de 5 estrelas">
                {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
              </div>
              <span class="bottom-label">Parceria de Longo Prazo</span>
            </div>
          </div>
        </div>
      </div>

      <!-- GRUPO 2: PRINTS E VALIDAÇÕES EM MOLDURA DE SMARTPHONE VERTICAL 9:16 -->
      <div class="proof-group">
        <div class="group-header">
          <span class="group-badge">
            <span class="pulse-dot dot-blue"></span>
            Conversas & Validações Públicas
          </span>
          <p class="group-desc">Comprovações visuais de entregas rápidas e autoridade no mercado em tela cheia</p>
        </div>

        <div class="proof-grid proof-grid--prints">
          <!-- CARD PRINT 1: INSTAGRAM STORIES 9:16 -->
          <div class="proof-card print-card">
            <div class="card-header">
              <div class="user-info">
                <div class="avatar-circle avatar-instagram" aria-hidden="true">
                  <Icon name="instagram" size={22} />
                </div>
                <div class="user-text">
                  <h3 class="user-name">Grupo Carrera Consórcio</h3>
                  <span class="user-sub">@grupocarreraconsorcio • Instagram Stories</span>
                </div>
              </div>
              <span class="pill-tag">Autoridade</span>
            </div>

            <blockquote class="card-quote">
              &ldquo;landing Page construída Pelo excelente profissional <span class="text-neon">@ocarecadev</span>. Parabéns pelo trabalho. Ficou extraordinário.&rdquo;
            </blockquote>

            <!-- MOLDURA DE SMARTPHONE REALISTA 9:16 -->
            <div class="phone-mockup-wrapper">
              <div class="phone-frame-916">
                <!-- Dynamic Island / Speaker -->
                <div class="phone-island" aria-hidden="true"></div>

                <!-- Tela do Smartphone -->
                <div class="phone-screen">
                  <Image
                    src={proofCarrera}
                    alt="Story do Grupo Carrera Consórcio elogiando o trabalho da OCARECADEV"
                    class="phone-img"
                    loading="lazy"
                    width={320}
                    height={568}
                  />
                  <!-- Home Indicator Bar -->
                  <div class="phone-home-indicator" aria-hidden="true"></div>
                </div>

                <!-- Botão de Ampliação Flutuante na Base -->
                <button
                  type="button"
                  class="phone-zoom-overlay-btn mockup-zoom-btn"
                  data-dialog-src={proofCarrera.src}
                  data-dialog-alt="Story do Grupo Carrera Consórcio elogiando o trabalho da OCARECADEV"
                  data-dialog-caption="Grupo Carrera Consórcio (@grupocarreraconsorcio) via Instagram Stories"
                  aria-label="Ampliar print do Grupo Carrera Consórcio em tela cheia"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  <span>Toque para ver em alta resolução</span>
                </button>
              </div>
            </div>

            <div class="card-bottom">
              <div class="stars" role="img" aria-label="Avaliação: 5 de 5 estrelas">
                {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
              </div>
              <span class="bottom-label">Projeto no Ar</span>
            </div>
          </div>

          <!-- CARD PRINT 2: WHATSAPP CONVERSA 9:16 -->
          <div class="proof-card print-card">
            <div class="card-header">
              <div class="user-info">
                <div class="avatar-circle avatar-whatsapp" aria-hidden="true">
                  <Icon name="whatsapp" size={22} />
                </div>
                <div class="user-text">
                  <div class="name-with-verified">
                    <h3 class="user-name">Vinicius Oliveira</h3>
                    <span class="verified-icon" role="img" title="Cliente verificado" aria-label="Cliente verificado">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="#00ff9d" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    </span>
                  </div>
                  <span class="user-sub">Cliente Verificado • WhatsApp</span>
                </div>
              </div>
              <span class="pill-tag">Agilidade</span>
            </div>

            <blockquote class="card-quote">
              &ldquo;O site voltou pro ar normal e as alterações ficaram ótimas, obrigado pela rapidez. Vou ja fazer os anúncios pro adwords!!&rdquo;
            </blockquote>

            <!-- MOLDURA DE SMARTPHONE REALISTA 9:16 -->
            <div class="phone-mockup-wrapper">
              <div class="phone-frame-916">
                <!-- Dynamic Island / Speaker -->
                <div class="phone-island" aria-hidden="true"></div>

                <!-- Tela do Smartphone -->
                <div class="phone-screen">
                  <Image
                    src={proofVinicius}
                    alt="Print de mensagem no WhatsApp de Vinicius Oliveira agradecendo agilidade e alterações"
                    class="phone-img"
                    loading="lazy"
                    width={320}
                    height={568}
                  />
                  <!-- Home Indicator Bar -->
                  <div class="phone-home-indicator" aria-hidden="true"></div>
                </div>

                <!-- Botão de Ampliação Flutuante na Base -->
                <button
                  type="button"
                  class="phone-zoom-overlay-btn mockup-zoom-btn"
                  data-dialog-src={proofVinicius.src}
                  data-dialog-alt="Print de mensagem no WhatsApp de Vinicius Oliveira agradecendo agilidade e alterações"
                  data-dialog-caption="Vinicius Oliveira via WhatsApp comprovando velocidade de entrega e início de campanhas no Google AdWords"
                  aria-label="Ampliar print de Vinicius Oliveira em tela cheia"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  <span>Toque para ver em alta resolução</span>
                </button>
              </div>
            </div>

            <div class="card-bottom">
              <div class="stars" role="img" aria-label="Avaliação: 5 de 5 estrelas">
                {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
              </div>
              <span class="bottom-label">Alterações em 5 min</span>
            </div>
          </div>

          <!-- CARD PRINT 3: WHATSAPP CONVERSA 9:16 (RENATO FARIAS) -->
          <div class="proof-card print-card">
            <div class="card-header">
              <div class="user-info">
                <div class="avatar-circle avatar-whatsapp" aria-hidden="true">
                  <Icon name="whatsapp" size={22} />
                </div>
                <div class="user-text">
                  <div class="name-with-verified">
                    <h3 class="user-name">Renato Farias</h3>
                    <span class="verified-icon" role="img" title="Cliente verificado" aria-label="Cliente verificado">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="#00ff9d" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                    </span>
                  </div>
                  <span class="user-sub">Cliente Verificado • WhatsApp</span>
                </div>
              </div>
              <span class="pill-tag">Parceria & Entrega</span>
            </div>

            <blockquote class="card-quote">
              &ldquo;Pescou de primeira a ideia e traduziu numa página animal! A navegação ficou leve, rápida e <span class="text-neon">rodando liso no celular</span>. Até meus sócios ficaram impactados.&rdquo;
            </blockquote>

            <!-- MOLDURA DE SMARTPHONE REALISTA 9:16 -->
            <div class="phone-mockup-wrapper">
              <div class="phone-frame-916">
                <!-- Dynamic Island / Speaker -->
                <div class="phone-island" aria-hidden="true"></div>

                <!-- Tela do Smartphone -->
                <div class="phone-screen">
                  <Image
                    src={proofRenato}
                    alt="Print de mensagem no WhatsApp de Renato Farias elogiando a velocidade no celular, organização e parceria na entrega do site"
                    class="phone-img"
                    loading="lazy"
                    width={320}
                    height={568}
                  />
                  <!-- Home Indicator Bar -->
                  <div class="phone-home-indicator" aria-hidden="true"></div>
                </div>

                <!-- Botão de Ampliação Flutuante na Base -->
                <button
                  type="button"
                  class="phone-zoom-overlay-btn mockup-zoom-btn"
                  data-dialog-src={proofRenato.src}
                  data-dialog-alt="Print de mensagem no WhatsApp de Renato Farias elogiando a velocidade no celular, organização e parceria na entrega do site"
                  data-dialog-caption="Renato Farias via WhatsApp destacando a rapidez no celular, cumprimento de prazos e impacto positivo com os sócios"
                  aria-label="Ampliar print de Renato Farias em tela cheia"
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  <span>Toque para ver em alta resolução</span>
                </button>
              </div>
            </div>

            <div class="card-bottom">
              <div class="stars" role="img" aria-label="Avaliação: 5 de 5 estrelas">
                {Array.from({ length: 5 }).map(() => <Icon name="star" size={15} />)}
              </div>
              <span class="bottom-label">Rodando liso no celular</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- LIGHTBOX NATIVO COM <dialog> -->
  <dialog id="proof-lightbox" class="lightbox-modal" aria-label="Visualização em alta resolução">
    <div class="lightbox-dialog-inner">
      <button type="button" id="lightbox-close" class="lightbox-close-btn" aria-label="Fechar visualização">&times;</button>
      <div class="lightbox-image-wrap">
        <img id="lightbox-modal-img" class="lightbox-modal-img" src="" alt="" />
        <p id="lightbox-modal-caption" class="lightbox-modal-caption"></p>
      </div>
    </div>
  </dialog>
</section>

<script is:inline>
  (() => {
    // -------------------------------------------------------------
    // CONTROLE DOS PLAYERS DE ÁUDIO DO WHATSAPP
    // -------------------------------------------------------------
    const audioPlayers = document.querySelectorAll('[data-audio-player]');
    const allAudios = [];

    const formatTime = (seconds) => {
      if (isNaN(seconds) || seconds < 0) return '0:00';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    };

    audioPlayers.forEach((balloon) => {
      const audio = balloon.querySelector('.wa-native-audio');
      const playBtn = balloon.querySelector('.wa-play-btn');
      const iconPlay = balloon.querySelector('.icon-play');
      const iconPause = balloon.querySelector('.icon-pause');
      const timeDisplay = balloon.querySelector('.wa-time');
      const speedBtn = balloon.querySelector('.wa-speed-btn');
      const waveform = balloon.querySelector('.wa-waveform');
      const bars = balloon.querySelectorAll('.wa-bar');

      if (!audio || !playBtn || !waveform) return;

      allAudios.push(audio);

      let isPlaying = false;
      const speeds = [1, 1.5, 2];
      let currentSpeedIdx = 0;

      const setPlayState = (playing) => {
        isPlaying = playing;
        if (playing) {
          iconPlay.style.display = 'none';
          iconPause.style.display = 'block';
          playBtn.setAttribute('aria-label', 'Pausar áudio');
          playBtn.classList.add('is-playing');
        } else {
          iconPlay.style.display = 'block';
          iconPause.style.display = 'none';
          playBtn.setAttribute('aria-label', 'Reproduzir áudio');
          playBtn.classList.remove('is-playing');
        }
      };

      const updateProgress = () => {
        const duration = audio.duration || (balloon.getAttribute('data-audio-player') === 'player-1' ? 30.2 : 54.5);
        const current = audio.currentTime || 0;
        const pct = Math.min(Math.max(current / duration, 0), 1);

        waveform.setAttribute('aria-valuenow', Math.round(pct * 100).toString());

        // Atualiza barras ativas
        const activeCount = Math.floor(pct * bars.length);
        bars.forEach((bar, idx) => {
          if (idx <= activeCount) {
            bar.classList.add('is-active');
          } else {
            bar.classList.remove('is-active');
          }
        });

        if (timeDisplay) {
          timeDisplay.textContent = `${formatTime(current)} / ${formatTime(duration)}`;
        }
      };

      // Alternar Play / Pause
      playBtn.addEventListener('click', () => {
        if (isPlaying) {
          audio.pause();
          setPlayState(false);
        } else {
          // Pausa outros áudios tocando
          allAudios.forEach((otherAudio) => {
            if (otherAudio !== audio && !otherAudio.paused) {
              otherAudio.pause();
              otherAudio.dispatchEvent(new Event('pause'));
            }
          });

          audio.play().then(() => {
            setPlayState(true);
          }).catch(() => {
            setPlayState(false);
          });
        }
      });

      audio.addEventListener('play', () => setPlayState(true));
      audio.addEventListener('pause', () => setPlayState(false));

      audio.addEventListener('timeupdate', updateProgress);

      audio.addEventListener('ended', () => {
        setPlayState(false);
        audio.currentTime = 0;
        updateProgress();
      });

      // Clique na waveform para scrub/pular
      waveform.addEventListener('click', (e) => {
        const rect = waveform.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const pct = Math.min(Math.max(clickX / rect.width, 0), 1);
        const duration = audio.duration || (balloon.getAttribute('data-audio-player') === 'player-1' ? 30.2 : 54.5);
        audio.currentTime = pct * duration;
        updateProgress();
      });

      // Ciclo de velocidade (1x -> 1.5x -> 2x)
      if (speedBtn) {
        speedBtn.addEventListener('click', () => {
          currentSpeedIdx = (currentSpeedIdx + 1) % speeds.length;
          const nextSpeed = speeds[currentSpeedIdx];
          audio.playbackRate = nextSpeed;
          speedBtn.textContent = `${nextSpeed}x`;
          speedBtn.setAttribute('aria-label', `Alterar velocidade de reprodução (atual ${nextSpeed}x)`);
        });
      }
    });

    // -------------------------------------------------------------
    // CONTROLE DO LIGHTBOX MODAL (<dialog>)
    // -------------------------------------------------------------
    const dialog = document.getElementById('proof-lightbox');
    const modalImg = document.getElementById('lightbox-modal-img');
    const modalCaption = document.getElementById('lightbox-modal-caption');
    const closeBtn = document.getElementById('lightbox-close');

    if (!dialog || !modalImg || !modalCaption || !closeBtn) return;

    const zoomButtons = document.querySelectorAll('.mockup-zoom-btn');
    zoomButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-dialog-src');
        const alt = btn.getAttribute('data-dialog-alt') || '';
        const caption = btn.getAttribute('data-dialog-caption') || '';

        if (!src) return;

        modalImg.setAttribute('src', src);
        modalImg.setAttribute('alt', alt);
        modalCaption.textContent = caption;

        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      });
    });

    const closeModal = () => {
      if (typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
      modalImg.setAttribute('src', '');
    };

    closeBtn.addEventListener('click', closeModal);

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        closeModal();
      }
    });

    dialog.addEventListener('cancel', () => {
      modalImg.setAttribute('src', '');
    });
  })();
</script>

