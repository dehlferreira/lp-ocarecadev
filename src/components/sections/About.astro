---
import GlassCard from '../ui/GlassCard.astro';
import Icon from '../ui/Icon.astro';
import { Image } from 'astro:assets';
import perfilImage from '../../assets/images/perfil-novo.webp';

const instagramUrl = import.meta.env.INSTAGRAM_URL || 'https://www.instagram.com/ocarecadev';
const tiktokUrl = import.meta.env.TIKTOK_URL || 'https://www.tiktok.com/@ocarecadev';

const paragraphs = [
  'Eu sou <strong>André Luiz Ferreira</strong>, desenvolvedor e criador do <span class="text-neon">OCARECADEV</span>. Criei a marca com uma ideia simples: empreendedor nenhum deveria precisar entender de código para ter uma presença digital profissional.',
  'Meu trabalho é juntar desenvolvimento, design, UX e estratégia para criar páginas fáceis de entender, boas de usar e construídas com um próximo passo claro. Sem enrolação. Sem site só pra dizer que tem site.',
];
---

<section id="about" class="section-about scrolly-section section-fade-top section-fade-bottom">
  <!-- Conector Luminoso de Transição Fluida -->
  <div class="transition-beam" aria-hidden="true"></div>
  <div class="transition-ambient-glow" aria-hidden="true"></div>

  <!-- Desktop: grid 2 colunas, 5 passos -->
  <div class="about-desktop">
    <div class="scrolly scrolly--5">
      <div class="scrolly__stage">
        <div class="container">
          <div class="about-grid">
            <div class="about-image scrolly-step from-left s-1">
              <div class="image-wrapper">
                <Image src={perfilImage} alt="André da OCARECADEV" class="profile-img" />
                <div class="neon-glow"></div>
              </div>
            </div>

            <div class="about-content">
              <h2 class="section-title scrolly-step about-reveal s-2">O Careca por trás dos sites</h2>

              <p class="about-desc scrolly-step about-reveal s-3" set:html={paragraphs[0]} />

              <p class="about-desc scrolly-step about-reveal s-4" set:html={paragraphs[1]} />

              <div class="about-footer scrolly-step about-reveal from-scale s-5">
                <div class="stats-grid">
                  <GlassCard class="stat-card stat-card--single" padding="1rem">
                    <h3>+50</h3>
                    <span>Projetos Lançados</span>
                  </GlassCard>
                </div>
              </div>
              <div class="about-social scrolly-step about-reveal s-5">
                <a href={instagramUrl} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Seguir no Instagram">
                  <Icon name="instagram" size={20} stroke={2} />
                  <span>Instagram</span>
                </a>
                <a href={tiktokUrl} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Seguir no TikTok">
                  <Icon name="tiktok" size={20} stroke={2} />
                  <span>TikTok</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile: uma sequência — foto, título, texto, stats e social juntos -->
  <div class="about-mobile">
    <div class="scrolly scrolly--5 about-mobile-unified">
      <div class="scrolly__stage">
        <div class="container">
          <div class="about-mobile-stack">
            <div class="about-image scrolly-step from-scale s-1">
              <div class="image-wrapper">
                <Image src={perfilImage} alt="André da OCARECADEV" class="profile-img" />
                <div class="neon-glow"></div>
              </div>
            </div>

            <h2 class="section-title scrolly-step about-reveal s-2">O Careca por trás dos sites</h2>

            <p class="about-desc scrolly-step about-reveal s-3" set:html={paragraphs[0]} />

            <p class="about-desc scrolly-step about-reveal s-4" set:html={paragraphs[1]} />

            <div class="about-footer scrolly-step about-reveal from-scale s-5">
              <div class="stats-grid">
                <GlassCard class="stat-card stat-card--single" padding="1rem">
                  <h3>+50</h3>
                  <span>Projetos Lançados</span>
                </GlassCard>
              </div>
            </div>
            <div class="about-social scrolly-step about-reveal s-5">
              <a href={instagramUrl} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Seguir no Instagram">
                <Icon name="instagram" size={20} stroke={2} />
                <span>Instagram</span>
              </a>
              <a href={tiktokUrl} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Seguir no TikTok">
                <Icon name="tiktok" size={20} stroke={2} />
                <span>TikTok</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-about {
    padding: 4rem 0;
    position: relative;
    overflow: clip;
    background-color: #0a0a0a;
  }

  @media (min-width: 768px) {
    .section-about {
      padding: 6rem 0;
    }
  }

  /* Conector de Transição Fluida */
  .transition-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 157, 0.04) 15%,
      rgba(0, 255, 157, 0.45) 50%,
      rgba(0, 255, 157, 0.04) 85%,
      transparent 100%
    );
    z-index: 10;
    pointer-events: none;
  }

  .transition-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 800px;
    height: 250px;
    background: radial-gradient(
      ellipse at top center,
      rgba(0, 255, 157, 0.07) 0%,
      transparent 70%
    );
    z-index: 6;
    pointer-events: none;
  }

  .about-desktop {
    display: none;
  }

  .about-mobile {
    display: block;
  }

  @media (min-width: 768px) {
    .about-desktop {
      display: block;
    }

    .about-mobile {
      display: none;
    }
  }

  .section-about .scrolly__stage {
    justify-content: center;
    overflow: visible;
  }

  @media (min-width: 768px) {
    .about-desktop .scrolly__stage {
      justify-content: center;
      padding-top: 0;
      padding-bottom: 0;
    }
  }

  /* Passos colapsados até revelar — evita reservar altura fantasma */
  .about-reveal {
    padding: 20px;
    margin: -20px;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: contain)) {
      .about-reveal {
    padding: 20px;
    margin: -20px;
        animation-name: about-reveal !important;
      }

      .about-reveal.from-scale {
        animation-name: about-reveal-scale !important;
      }
    }
  }

  @keyframes about-reveal {
    from {
      opacity: 0;
      transform: translateY(24px);
      max-height: 0;
      overflow: hidden;
    }

    to {
      opacity: 1;
      transform: none;
      max-height: 420px;
      overflow: visible;
    }
  }

  @keyframes about-reveal-scale {
    from {
      opacity: 0;
      transform: scale(0.94);
      max-height: 0;
      overflow: hidden;
    }

    to {
      opacity: 1;
      transform: none;
      max-height: 420px;
      overflow: visible;
    }
  }

  .about-grid {
    display: grid;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: minmax(260px, 300px) 1fr;
      gap: 3.5rem;
      align-items: center;
    }

    .about-desktop .image-wrapper {
      width: 280px;
      height: 280px;
    }

    .about-desktop .section-title {
      font-size: 2.5rem;
      margin-bottom: 1.25rem;
    }

    .about-desktop .about-desc {
      font-size: 1.125rem;
      line-height: 1.8;
      margin-bottom: 1.25rem;
    }

    .about-desktop .about-footer {
      margin-top: 0.5rem;
    }

    .about-desktop .about-footer + .about-social {
      margin-top: 1.25rem;
    }

    .about-desktop .stats-grid {
      gap: 1.15rem;
    }

    .about-desktop :global(.stat-card) {
      padding: 1.25rem !important;
    }

    .about-desktop :global(.stat-card h3) {
      font-size: 2rem;
    }

    .about-desktop :global(.stat-card span) {
      font-size: 0.875rem;
    }

    .about-desktop .social-link {
      font-size: 0.925rem;
      padding: 0.65rem 1.15rem;
    }

    .about-desktop .social-link :global(.icon) {
      width: 22px;
      height: 22px;
    }
  }

  .about-image {
    display: flex;
    justify-content: center;
  }

  .image-wrapper {
    position: relative;
    width: 200px;
    height: 200px;
    border-radius: 50%;
  }


  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    border-radius: 50%;
    position: relative;
    z-index: 10;
    border: 3px solid var(--glass-border);
    animation: profile-float 6s ease-in-out infinite;
  }

  @keyframes profile-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  .neon-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background-color: var(--color-primary-neon);
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.3;
    z-index: 6;
    animation: neon-pulse 4s ease-in-out infinite;
  }

  @keyframes neon-pulse {
    0%, 100% { opacity: 0.2; transform: translate(-50%, -50%) scale(0.9); filter: blur(50px); }
    50% { opacity: 0.45; transform: translate(-50%, -50%) scale(1.1); filter: blur(70px); }
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
    line-height: 1.2;
  }


  .about-desc {
    color: var(--color-text-secondary);
    font-size: 1rem;
    margin: 0 0 1rem;
    line-height: 1.7;
  }


  .about-footer {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .stats-grid {
    display: flex;
    gap: 0.85rem;
  }

  :global(.stat-card--single) {
    flex: 1;
    max-width: 240px;
  }


  :global(.stat-card) {
    text-align: center;
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease !important;
  }

  :global(.stat-card:hover) {
    transform: translateY(-4px) !important;
    border-color: rgba(0, 255, 157, 0.4) !important;
    background: rgba(255, 255, 255, 0.05) !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.12), 0 0 24px rgba(0, 255, 157, 0.15) !important;
  }

  :global(.stat-card h3) {
    font-size: 1.5rem;
    color: var(--color-primary-neon);
    margin: 0 0 0.25rem;
  }


  :global(.stat-card span) {
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .about-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    position: relative;
    z-index: 11;
  }

  .about-footer + .about-social {
    margin-top: 1rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: 100px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    transition: border-color 0.25s ease, color 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
  }

  .social-link:hover {
    border-color: var(--color-primary-neon);
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.06);
    box-shadow: 0 0 20px rgba(0, 255, 157, 0.12);
    transform: translateY(-2px);
  }

  .social-link :global(.icon) {
    color: var(--color-primary-neon);
  }

  /* Mobile: tudo num bloco só, centralizado */
  @media (max-width: 767px) {
    .about-mobile-unified .scrolly__stage {
      justify-content: center;
      padding-top: max(calc(env(safe-area-inset-top, 0px) + 2rem), 2.5rem);
      padding-bottom: max(calc(env(safe-area-inset-bottom, 0px) + 3rem), 3.5rem);
    }

    .about-mobile-unified .container {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    .about-mobile-stack {
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 0.75rem;
      width: 100%;
      max-width: 390px;
      margin: 0 auto;
    }

    .about-mobile-stack .image-wrapper {
      width: 125px;
      height: 125px;
    }

    .about-mobile-stack .section-title {
      font-size: 1.35rem;
      margin: 0;
    }

    .about-mobile-stack .about-desc {
      font-size: 0.88rem;
      line-height: 1.55;
      margin: 0;
      text-align: left;
      max-width: 100%;
    }

    .about-mobile-stack .about-footer {
      margin-top: 0.35rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
    }

    .about-mobile-stack .stats-grid {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    .about-mobile-stack :global(.stat-card--single) {
      margin: 0 auto;
      width: 100%;
      max-width: 230px;
    }

    .about-mobile-stack :global(.stat-card h3) {
      font-size: 1.35rem;
      margin: 0 0 0.15rem;
    }

    .about-mobile-stack :global(.stat-card span) {
      font-size: 0.8rem;
    }

    .about-mobile-stack :global(.stat-card) {
      padding: 0.65rem 1rem !important;
    }

    .about-mobile-stack .about-social {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.65rem;
      width: 100%;
      margin: 0 auto;
    }

    .about-mobile-stack .social-link {
      background: rgba(255, 255, 255, 0.1);
      padding: 0.45rem 0.95rem;
      font-size: 0.82rem;
    }

    .about-mobile-unified .about-image.scrolly-step {
      animation-name: about-photo-enter !important;
    }

    .about-mobile-unified .about-reveal {
    padding: 20px;
    margin: -20px;
      animation-name: about-reveal-mobile !important;
    }

    .about-mobile-unified .about-footer.about-reveal {
    padding: 20px;
    margin: -20px;
      animation-name: about-reveal-footer-mobile !important;
    }

    @keyframes about-photo-enter {
      from {
        opacity: 0;
        transform: scale(0.92);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes about-reveal-mobile {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }

    @keyframes about-reveal-footer-mobile {
      from {
        opacity: 0;
        transform: scale(0.94);
      }

      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
