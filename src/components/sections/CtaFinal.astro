---
import Button from '../ui/Button.astro';
const whatsappNumber = import.meta.env.WHATSAPP_NUMBER || '5511999999999';
---

<section id="cta-final" class="section-cta section-fade-top">
  <div class="neon-glow-large"></div>
  
  <div class="container container--narrow">
    <div class="cta-content scroll-animate anim-scale">
      <h2 class="cta-title">
        Seu próximo cliente pode chegar pelo Instagram, pelo Google ou por <span class="text-neon">indicação</span>
      </h2>
      
      <p class="cta-desc">
        Quando ele chegar ao seu site, o que ele vai encontrar?<br/>
        Tenha uma página que explica seu valor e deixa claro qual é o próximo passo.
      </p>
      
      <Button
        type="primary"
        class="btn-large pulse-animation"
        href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent('Olá! Quero conversar sobre meu projeto com a OCARECADEV.')}`}
        data-track-event="lead"
        data-track-location="final_cta"
      >
        Quero conversar sobre meu projeto
      </Button>
    </div>
  </div>
</section>

<style>
  .section-cta {
    padding: 4rem 0;
    position: relative;
    background-color: #0A0A0A;
    overflow: hidden;
    text-align: center;
  }

  @media (min-width: 768px) {
    .section-cta {
      padding: 8rem 0;
    }
  }

  .neon-glow-large {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(0, 255, 157, 0.15) 0%, rgba(0,0,0,0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.2;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 3.5rem;
    }
  }

  .cta-desc {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  @media (min-width: 768px) {
    .cta-desc {
      font-size: 1.25rem;
    }
  }

  :global(.pulse-animation) {
    position: relative;
  }

  :global(.pulse-animation)::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(0, 255, 157, 0.4);
    z-index: -1;
    pointer-events: none;
    animation: pulse-ring 2.4s cubic-bezier(0.25, 0.8, 0.25, 1) infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70% {
      transform: scale(1.12);
      opacity: 0;
    }
    100% {
      transform: scale(1.12);
      opacity: 0;
    }
  }

  :global(.btn-large) {
    font-size: 1.25rem !important;
    padding: 18px 40px !important;
  }

  @media (max-width: 767px) {
    .neon-glow-large {
      width: 100%;
      max-width: 400px;
      height: 400px;
    }
    .cta-title {
      font-size: 1.65rem;
    }
    .cta-desc {
      font-size: 1rem;
      margin-bottom: 2rem;
    }
    :global(.section-cta .btn-large) {
      width: 100%;
      font-size: 1rem !important;
      padding: 14px 24px !important;
    }
  }
</style>
