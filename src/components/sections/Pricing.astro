---
import GlassCard from '../ui/GlassCard.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const whatsappNumber = import.meta.env.WHATSAPP_NUMBER || '5511999999999';
---

<section id="pricing" class="section-pricing section-fade-top">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title scroll-animate">Escolha o plano ideal para o seu momento</h2>
    </div>

    <div class="pricing-grid">
      <!-- Plano 1 -->
      <GlassCard class="scroll-animate anim-left delay-200 pricing-card">
        <h3 class="plan-name">OCARECADEV EXPRESS</h3>
        <p class="plan-desc">Para quem precisa entrar no ar rápido.</p>
        <div class="plan-price">
          R$ 297<span>/único</span>
        </div>
        <p class="plan-installments">ou 12x de R$ 24,75 sem juros</p>
        <ul class="plan-features">
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Landing page simples</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Template validado</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Personalização básica</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Botão direto para WhatsApp</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Entrega em até 48h</li>
        </ul>
        <Button type="ghost" class="btn-full btn-pricing-cta" href={`https://wa.me/${whatsappNumber}?text=Olá, tenho interesse no plano EXPRESS`}>
          Quero começar já
        </Button>
      </GlassCard>

      <!-- Plano 2 (Destaque) -->
      <GlassCard class="scroll-animate anim-scale delay-300 pricing-card" highlight={true}>
        <div class="recommended-badge">Recomendado</div>
        <h3 class="plan-name">LANDING QUE VENDE</h3>
        <p class="plan-desc">Para quem quer gerar <span class="text-neon">clientes</span> de verdade.</p>
        <div class="plan-price text-gradient">
          R$ 997<span>/único</span>
        </div>
        <p class="plan-installments highlight-installments">ou 12x de R$ 83,08 sem juros</p>
        <ul class="plan-features text-bright">
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Estrutura focada em conversão</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Design premium</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>CTA estratégico</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Integração WhatsApp e Analytics</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Tracking de cliques e leads</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>1 revisão estratégica</li>
        </ul>
        <Button type="primary" class="btn-full btn-pricing-cta" href={`https://wa.me/${whatsappNumber}?text=Olá, tenho interesse no plano LANDING QUE VENDE`}>
          Quero gerar clientes
        </Button>
      </GlassCard>

      <!-- Plano 3 -->
      <GlassCard class="scroll-animate anim-right delay-400 pricing-card">
        <h3 class="plan-name">MÁQUINA DE CLIENTES</h3>
        <p class="plan-desc">Para quem quer presença profissional e escala.</p>
        <div class="plan-price">
          R$ 2.497<span>/único</span>
        </div>
        <p class="plan-installments">ou 12x de R$ 208,08 sem juros</p>
        <ul class="plan-features">
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>3 a 5 páginas completas</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Estrutura estratégica</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Integrações e tracking</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Pronto para tráfego pago</li>
          <li><span class="feat-check"><Icon name="check" size={14} stroke={3} /></span>Otimização de conversão</li>
        </ul>
        <Button type="ghost" class="btn-full btn-pricing-cta" href={`https://wa.me/${whatsappNumber}?text=Olá, tenho interesse no plano MÁQUINA DE CLIENTES`}>
          Quero escalar
        </Button>
      </GlassCard>
    </div>
  </div>
</section>

<style>
  .section-pricing {
    padding: 4rem 0;
    position: relative;
    background-color: #030303;
  }

  @media (min-width: 768px) {
    .section-pricing {
      padding: 6rem 0;
    }
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 3rem;
    }
  }

  .pricing-grid {
    display: grid;
    gap: 2rem;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: center;
    }
  }

  /* Cards Internos */
  :global(.pricing-card) {
    display: flex;
    flex-direction: column;
    position: relative;
    height: 100%;
  }

  @media (min-width: 768px) {
    :global(.pricing-card) {
      height: auto;
    }

    :global(.pricing-card:not(.highlight-card)) {
      min-height: 34.5rem;
      align-self: center;
    }
  }

  .recommended-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, var(--color-primary-neon), #00A666);
    color: var(--color-bg-dark);
    padding: 0.4rem 1.2rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    box-shadow: 0 4px 15px rgba(0, 255, 157, 0.3);
    white-space: nowrap;
    z-index: 10;
  }

  :global(.highlight-card) {
    z-index: 2;
  }

  @media (min-width: 768px) {
    :global(.pricing-card.highlight-card) {
      transform: scale(1.07);
      padding: 3.25rem 2.35rem !important;
      min-height: 41rem;
      align-self: center;
      border-color: rgba(0, 255, 157, 0.45) !important;
      background: rgba(0, 255, 157, 0.07) !important;
      box-shadow:
        0 0 0 1px rgba(0, 255, 157, 0.22),
        0 14px 44px rgba(0, 255, 157, 0.2),
        0 28px 72px rgba(0, 0, 0, 0.45);
    }

    :global(.pricing-card.highlight-card:hover) {
      transform: scale(1.07) translateY(-5px);
      border-color: rgba(0, 255, 157, 0.65) !important;
      background: rgba(0, 255, 157, 0.1) !important;
      box-shadow:
        0 0 0 1px rgba(0, 255, 157, 0.35),
        0 18px 52px rgba(0, 255, 157, 0.3),
        0 32px 80px rgba(0, 0, 0, 0.5);
    }

    :global(.highlight-card) .plan-name {
      font-size: 1.65rem;
    }

    :global(.highlight-card) .plan-price {
      font-size: 2.75rem;
    }

    .recommended-badge {
      padding: 0.5rem 1.4rem;
      font-size: 0.8rem;
      box-shadow: 0 6px 22px rgba(0, 255, 157, 0.45);
    }
  }

  @media (max-width: 767px) {
    :global(.pricing-card.highlight-card) {
      border-color: rgba(0, 255, 157, 0.4) !important;
      background: rgba(0, 255, 157, 0.05) !important;
      box-shadow: 0 8px 36px rgba(0, 255, 157, 0.16);
    }
  }

  .plan-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .plan-desc {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .plan-price {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 1.5rem 0;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .plan-price {
      font-size: 2.5rem;
    }
  }

  .plan-installments {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: 2.5rem;
    font-weight: 500;
  }

  .highlight-installments {
    color: var(--color-primary-neon);
    font-weight: 600;
  }

  .plan-price span {
    font-size: 1.125rem;
    font-weight: 400;
    color: #9ca3af;
  }

  .text-gradient {
    color: transparent;
    background-image: linear-gradient(to right, var(--color-primary-neon), #00A666);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    flex-grow: 1;
    color: #d1d5db;
  }

  .plan-features li {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .feat-check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.1);
    border: 1px solid rgba(0, 255, 157, 0.25);
  }

  .text-bright li {
    color: #f3f4f6;
    font-weight: 600;
  }

  .plan-features .disabled {
    opacity: 0.4;
  }

  :global(.btn-full) {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }

  @media (max-width: 767px) {
    .section-header {
      margin-bottom: 2.5rem;
    }
    .section-title {
      font-size: 1.65rem;
    }
    .pricing-grid {
      gap: 1.5rem;
      align-items: stretch;
    }
    :global(.pricing-card) {
      padding: 1.5rem !important;
      height: auto;
    }
    .plan-name {
      font-size: 1.25rem;
    }
    .plan-price {
      font-size: 1.75rem;
    }
    .plan-installments {
      margin-bottom: 1.5rem;
    }
    .plan-features li {
      margin-bottom: 0.75rem;
      font-size: 0.9rem;
    }
  }
</style>
