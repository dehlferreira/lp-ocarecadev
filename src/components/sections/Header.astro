---
import Button from "../ui/Button.astro";
import GlassCard from "../ui/GlassCard.astro";
import { Image } from "astro:assets";
import logoHorizontal from "../../assets/images/logo-ocareca-horizontal.webp";

const whatsappNumber = import.meta.env.WHATSAPP_NUMBER || '5511999999999';
const whatsappMessage = import.meta.env.WHATSAPP_MESSAGE_DEFAULT || 'Olá, tenho interesse.';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<header class="main-header" id="main-header">
  <div class="container">
    <GlassCard class="header-card">
      <div class="logo">
        <a href="/" aria-label="OCARECADEV Página Inicial">
          <Image
            src={logoHorizontal}
            alt="OCARECADEV Logo"
            width={140}
            height={44}
            loading="eager"
            decoding="async"
          />
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="nav">
        <a data-track-event="select_content" data-track-location="header_nav" data-track-item="inicio" href="#hero">Início</a>
        <a data-track-event="select_content" data-track-location="header_nav" data-track-item="resultados" href="#social-proof">Resultados</a>
        <a data-track-event="select_content" data-track-location="header_nav" data-track-item="modelos" href="#modelos">Modelos</a>
        <a data-track-event="select_content" data-track-location="header_nav" data-track-item="planos" href="#pricing">Planos</a>
      </nav>

      <div class="cta-and-menu">
        <div class="cta desktop-cta">
          <Button
            type="primary"
            href={whatsappUrl}
            id="btn-header-cta"
            class="btn-small"
            text="Falar com Consultor"
            data-track-event="lead"
            data-track-location="header"
          />
        </div>
        <button class="mobile-menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </GlassCard>
  </div>

  <!-- Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobile-menu" aria-label="Menu de navegação mobile">
    <div class="mobile-menu-header">
      <div class="mobile-menu-logo">
        <Image
          src={logoHorizontal}
          alt="OCARECADEV Logo"
          width={130}
          height={40}
          loading="eager"
          decoding="async"
        />
      </div>
      <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Fechar menu">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="mobile-nav">
      <a data-track-event="select_content" data-track-location="header_mobile_nav" data-track-item="inicio" href="#hero" class="mobile-nav-link">Início</a>
      <a data-track-event="select_content" data-track-location="header_mobile_nav" data-track-item="resultados" href="#social-proof" class="mobile-nav-link">Resultados</a>
      <a data-track-event="select_content" data-track-location="header_mobile_nav" data-track-item="modelos" href="#modelos" class="mobile-nav-link">Modelos</a>
      <a data-track-event="select_content" data-track-location="header_mobile_nav" data-track-item="planos" href="#pricing" class="mobile-nav-link">Planos</a>
    </nav>

    <div class="mobile-menu-cta">
      <Button
        type="primary"
        href={whatsappUrl}
        id="btn-header-cta-mobile"
        class="btn-large mobile-menu-cta-btn"
        text="Falar com Consultor"
        data-track-event="lead"
        data-track-location="header_mobile"
      />
    </div>
  </div>
</header>

<style is:global>
  .header-card {
    padding: 0.75rem 1.25rem !important;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 100px !important;
    backdrop-filter: blur(20px) !important;
    -webkit-backdrop-filter: blur(20px) !important;
    z-index: 51;
    position: relative;
  }

  @media (min-width: 768px) {
    .header-card {
      padding: 0.8rem 1.5rem !important;
    }
  }

  .btn-small {
    padding: 8px 14px !important;
    font-size: 0.8rem !important;
  }

  @media (min-width: 768px) {
    .btn-small {
      padding: 8px 16px !important;
      font-size: 0.875rem !important;
    }
  }
</style>

<style>
  .main-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    padding: 1rem 0;
    transition: padding 0.3s ease;
  }

  .main-header.menu-open {
    z-index: 95;
  }

  .main-header.menu-open :global(.header-card) {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  :global(.header-card) {
    transition: opacity 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .main-header {
      transition: none !important;
    }
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 36px !important; /* Maior no mobile */
    width: auto !important;
    object-fit: contain;
    margin-left: -6px; /* Compensa o espaço transparente intrínseco do arquivo da logo para alinhamento ótico perfeito */
  }

  @media (min-width: 768px) {
    .logo img {
      height: 40px !important;
      margin-left: -7px;
    }
  }

  /* Desktop Nav */
  .nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .nav {
      display: flex;
    }
  }

  .nav a {
    color: var(--color-text-secondary, #a1a1aa);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .nav a:hover {
    color: var(--color-text-primary, #ffffff);
  }

  .nav a:focus-visible,
  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--color-primary-neon, #00ff9d);
    outline-offset: 4px;
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .nav {
      gap: 0.75rem;
    }

    .nav a {
      font-size: 0.8125rem;
    }
  }

  .cta-and-menu {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .desktop-cta {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-cta {
      display: block;
    }
    .cta-and-menu {
      gap: 1rem;
    }
  }

  /* Hamburger Menu Button */
  .mobile-menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 52;
    position: relative;
  }

  /* Área de toque acessível de 44x44px sem alterar o alinhamento visual (G1) */
  .mobile-menu-toggle::before {
    content: "";
    position: absolute;
    inset: -13px -10px;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background-color: var(--color-text-primary, #ffffff);
    border-radius: 2px;
    transition: all 0.3s ease;
    transform-origin: left center;
  }

  @media (min-width: 768px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  /* Hamburger Active State */
  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: rotate(45deg);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: rotate(-45deg);
  }

  /* Mobile Menu Overlay Drawer */
  .mobile-menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    background: #080a0f;
    z-index: 100;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem 1.25rem 2rem;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
    transform: translateY(-100%);
  }

  .mobile-menu-overlay.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-menu-logo {
    display: flex;
    align-items: center;
  }

  .mobile-menu-logo img {
    height: 32px !important;
    width: auto !important;
    object-fit: contain;
  }

  .mobile-menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: var(--color-text-primary, #ffffff);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .mobile-menu-close:active {
    background: rgba(0, 255, 157, 0.15);
    border-color: rgba(0, 255, 157, 0.4);
    transform: scale(0.95);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    text-align: center;
    margin: auto 0;
  }

  .mobile-nav-link {
    color: var(--color-text-primary, #ffffff);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:active {
    color: var(--color-primary-neon, #00ff9d);
    transform: scale(1.05);
  }

  .mobile-menu-cta {
    width: 100%;
    padding-top: 1rem;
  }

  .mobile-menu-cta :global(.btn) {
    width: 100%;
    justify-content: center;
    font-size: 1rem !important;
    padding: 14px 20px !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-overlay {
      transition: none !important;
    }
  }
</style>

<script>
  // Mobile Menu Logic
  const setupMobileMenu = () => {
    const header = document.getElementById("main-header");
    const mobileMenuToggle = document.querySelector(".mobile-menu-toggle");
    const mobileMenuOverlay = document.getElementById("mobile-menu");
    const mobileMenuClose = document.getElementById("mobile-menu-close");
    const mobileNavLinks = document.querySelectorAll(".mobile-nav-link");
    const mobileCta = document.getElementById("btn-header-cta-mobile");

    if (mobileMenuToggle && mobileMenuOverlay && mobileMenuToggle.parentNode) {
      // Remove evt listeners prev to avoid multiple bindings
      const newToggle = mobileMenuToggle.cloneNode(true) as HTMLElement;
      mobileMenuToggle.parentNode.replaceChild(newToggle, mobileMenuToggle);

      const closeMenu = () => {
        newToggle.classList.remove("active");
        newToggle.setAttribute("aria-expanded", "false");
        mobileMenuOverlay.classList.remove("active");
        header?.classList.remove("menu-open");
        document.body.style.overflow = "";
      };

      const openMenu = () => {
        newToggle.classList.add("active");
        newToggle.setAttribute("aria-expanded", "true");
        mobileMenuOverlay.classList.add("active");
        header?.classList.add("menu-open");
        document.body.style.overflow = "hidden";
      };

      const toggleMenu = () => {
        const isOpen = mobileMenuOverlay.classList.contains("active");
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      };

      newToggle.addEventListener("click", toggleMenu);

      if (mobileMenuClose) {
        mobileMenuClose.addEventListener("click", closeMenu);
      }

      mobileNavLinks.forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      if (mobileCta) {
        mobileCta.addEventListener("click", closeMenu);
      }

      // Fechar com tecla Escape (Acessibilidade G1)
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && mobileMenuOverlay.classList.contains("active")) {
          closeMenu();
        }
      });
    }
  };

  // Run on first load
  setupMobileMenu();

  // Run on Astro view transitions
  document.addEventListener("astro:page-load", () => {
    setupMobileMenu();
  });
</script>
