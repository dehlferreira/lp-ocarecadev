---
import Icon from '../ui/Icon.astro';

const pains = [
  'Seu site não gera <span class="text-neon">leads</span>',
  'Ninguém clica no seu botão',
  'Você depende de indicação',
  'E quando não indicam… você não vende',
];
---

<section id="problema" class="section-problem scrolly-section section-fade-top section-fade-bottom">
  <div class="scrolly scrolly--7" style="--scrolly-track: 300vh; --scrolly-track-mobile: 220vh;">
    <div class="scrolly__stage">
      <div class="container container--narrow">
        <div class="problem-content">
          <h2 class="problem-title scrolly-step s-1">
            Se você já tem um site e ele não te traz <span class="text-neon">clientes</span>,
            ele não serve pra nada.
          </h2>

          <p class="problem-desc scrolly-step s-2">A verdade é simples:</p>

          <ul class="problem-list">
            {pains.map((pain, i) => (
              <li class={`scrolly-step from-left s-${i + 3}`}>
                <span class="pain-icon"><Icon name="x" size={16} stroke={2.5} /></span>
                <span set:html={pain} />
              </li>
            ))}
          </ul>

          <p class="problem-highlight scrolly-step from-scale s-7">
            <span class="highlight-icon"><Icon name="arrow-right" size={20} stroke={2.5} /></span>
            você nem sabe o que está errado
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-problem {
    background-color: #030303;
  }

  .container {
    text-align: center;
  }

  .problem-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.2;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .problem-title {
      font-size: 3rem;
    }
  }

  .problem-desc {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .problem-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 2.5rem;
    display: inline-flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
    font-size: 1.125rem;
    color: #e5e5e5;
  }

  .problem-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  /* Badge circular para o "x" — vermelho dessaturado, sóbrio (não emoji) */
  .pain-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
    border: 1px solid rgba(255, 107, 107, 0.25);
  }

  .problem-highlight {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
  }

  .highlight-icon {
    display: inline-flex;
    color: var(--color-primary-neon);
  }

  @media (min-width: 768px) {
    .problem-highlight {
      font-size: 1.5rem;
    }
  }

  /* Mobile: compacta para caber no palco pinado (100svh) */
  @media (max-width: 767px) {
    .problem-title {
      font-size: 1.45rem;
      margin-bottom: 0.75rem;
      line-height: 1.15;
    }
    .problem-desc {
      font-size: 1rem;
      margin-bottom: 0.65rem;
    }
    .problem-list {
      gap: 0.55rem;
      margin-bottom: 1rem;
      font-size: 0.9rem;
    }
    .problem-list li {
      gap: 0.6rem;
    }
    .pain-icon {
      width: 22px;
      height: 22px;
    }
    .problem-highlight {
      font-size: 1rem;
      gap: 0.45rem;
    }
  }
</style>
