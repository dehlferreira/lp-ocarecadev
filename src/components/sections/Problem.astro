---
import Icon from '../ui/Icon.astro';
import ProblemMockup from '../ui/ProblemMockup.astro';

const points = [
  '<strong>1. O que você faz:</strong> sem jargão e sem enrolação.',
  '<strong>2. Por que escolher você:</strong> diferencial perceptível.',
  '<strong>3. Qual é o próximo passo:</strong> botão e direcionamento óbvio.',
];
---

<section id="problema" class="section-problem scrolly-section section-fade-top section-fade-bottom">
  <div class="scrolly scrolly--7" style="--scrolly-track: 300vh; --scrolly-track-mobile: 180vh;">
    <div class="scrolly__stage">
      <div class="container problem-container">
        <div class="problem-content">
          <div class="problem-left">
            <h2 class="problem-title scrolly-step s-1">
              Seu site recebe pessoas, mas deixa claro o que elas devem fazer <span class="text-neon">depois</span>?
            </h2>

            <div class="problem-copy">
              <p class="problem-desc scrolly-step s-2">Um visitante precisa entender rapidamente três coisas:</p>

              <ul class="problem-list">
                {points.map((point, i) => (
                  <li class={`scrolly-step from-left s-${i + 3}`}>
                    <span class="pain-icon"><Icon name="check" size={16} stroke={2.5} /></span>
                    <span set:html={point} />
                  </li>
                ))}
              </ul>

              <div class="problem-punchline scrolly-step s-6">
                <p class="punchline-text">
                  Quando isso não fica claro, a pessoa entra, olha e vai embora.
                </p>
                <p class="punchline-highlight">
                  Se sua página não ajuda o visitante a avançar, ela vira só mais um <span class="text-neon">custo</span>.
                </p>
              </div>
            </div>
          </div>

          <div class="problem-mockup-col scrolly-step from-right s-7">
            <ProblemMockup compact />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-problem {
    background-color: #030303;
  }

  .container {
    text-align: center;
  }

  .problem-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    width: 100%;
  }

  .problem-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.2;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .problem-title {
      font-size: 3rem;
    }
  }

  .problem-desc {
    font-size: 1.25rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .problem-list {
    list-style: none;
    padding: 0;
    margin: 0 auto 2.5rem;
    display: inline-flex;
    flex-direction: column;
    gap: 1rem;
    text-align: left;
    font-size: 1.125rem;
    color: #e5e5e5;
  }

  .problem-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  /* Badge circular para os 3 pontos */
  .pain-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.1);
    border: 1px solid rgba(0, 255, 157, 0.25);
  }

  .problem-punchline {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: left;
  }

  .punchline-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0 0 0.5rem;
  }

  .punchline-highlight {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .problem-mockup-col {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .problem-container {
      max-width: 1200px;
    }

    .problem-content {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: 3.5rem;
      align-items: stretch;
      text-align: left;
    }

    .problem-left {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .problem-title {
      margin: 0 0 1.5rem;
      text-align: left;
    }

    .problem-list {
      margin: 0;
    }

    .problem-mockup-col {
      grid-column: 2;
      grid-row: 1;
      max-width: none;
      margin: 0;
      height: 100%;
    }
  }

  /* Mobile: ocupa a tela com harmonia e proporção visual equilibrada */
  @media (max-width: 767px) {
    .problem-container {
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
    }
    .problem-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      width: 100%;
    }
    .problem-left {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 0;
      width: 100%;
    }
    .problem-title {
      font-size: 1.35rem;
      margin-bottom: 0.4rem;
      line-height: 1.2;
    }
    .problem-desc {
      font-size: 0.92rem;
      margin-bottom: 0.4rem;
    }
    .problem-list {
      gap: 0.45rem;
      margin-bottom: 0.6rem;
      font-size: 0.88rem;
    }
    .problem-list li {
      gap: 0.55rem;
    }
    .pain-icon {
      width: 22px;
      height: 22px;
    }
    .problem-punchline {
      margin-top: 0.55rem;
      padding-top: 0.55rem;
    }
    .punchline-text {
      font-size: 0.85rem;
      margin: 0 0 0.25rem;
    }
    .punchline-highlight {
      font-size: 1.02rem;
    }
    .problem-mockup-col {
      max-width: none;
      width: 100%;
      flex-shrink: 0;
    }
  }
</style>
