---
import GlassCard from '../ui/GlassCard.astro';
import Icon from '../ui/Icon.astro';

const steps = [
  {
    num: '01',
    icon: 'layout-template',
    title: 'Estrutura validada',
    desc: 'Usamos modelos que já funcionam',
  },
  {
    num: '02',
    icon: 'sliders-horizontal',
    title: 'Personalização',
    desc: 'Adaptamos para o seu negócio',
  },
  {
    num: '03',
    icon: 'rocket',
    title: 'Publicação rápida',
    desc: 'Seu site no ar em poucos dias',
  },
  {
    num: '04',
    icon: 'trending-up',
    title: 'Geração de leads',
    desc: 'Visitantes viram contatos no WhatsApp',
  },
];

---

<section id="como-funciona" class="section-how scrolly-section section-fade-top section-fade-bottom">
  <div class="scrolly scrolly--5" style="--scrolly-track: 360vh; --scrolly-track-mobile: 260vh;">
    <div class="scrolly__stage">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title scrolly-step s-1">Um processo simples, direto e focado em <span class="text-neon">resultado</span></h2>
          <span class="how-progress scrolly-progress is-horizontal" aria-hidden="true"></span>
        </div>

        <div class="steps-grid">
          {steps.map((step, i) => (
            <GlassCard class={`step-card scrolly-step from-scale s-${i + 2}`}>
              <div class="step-top">
                <span class="step-icon">
                  <Icon name={step.icon} size={24} />
                </span>
                <span class="step-num">{step.num}</span>
              </div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.desc}</p>
            </GlassCard>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-how {
    background-color: #0A0A0A;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .section-header {
      margin-bottom: 3.5rem;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 3rem;
    }
  }

  /* Barra de progresso que preenche conforme os passos são revelados (scrollytelling) */
  .how-progress {
    display: block;
    width: min(220px, 70%);
    height: 4px;
    margin: 1.5rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-primary-neon), #00A666);
    box-shadow: 0 0 16px rgba(0, 255, 157, 0.45);
    /* fallback (sem scroll-driven): barra cheia */
    transform: scaleX(1);
  }

  .steps-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
    position: relative;
  }

  @media (min-width: 768px) {
    .steps-grid {
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :global(.step-card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem !important;
    position: relative;
    overflow: visible;
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  /* Badge do ícone — quadrado arredondado com tint neon */
  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.25);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08),
      0 4px 16px rgba(0, 255, 157, 0.12);
  }

  /* Número preenchido com gradiente neon (substitui o text-stroke quebrado) */
  .step-num {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: transparent;
    background-image: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18),
      rgba(0, 255, 157, 0.28)
    );
    background-clip: text;
    -webkit-background-clip: text;
    font-variant-numeric: tabular-nums;
  }

  /* Conector horizontal entre os cards (somente desktop 4-col) */
  @media (min-width: 1024px) {
    :global(.step-card)::after {
      content: '';
      position: absolute;
      top: calc(2rem + 26px); /* centro vertical do badge de 52px */
      right: -2rem;
      width: 2rem;
      height: 1px;
      background: linear-gradient(
        to right,
        rgba(0, 255, 157, 0.4),
        rgba(0, 255, 157, 0)
      );
      transform: translateY(-50%);
      pointer-events: none;
    }

    :global(.step-card):last-child::after {
      display: none;
    }
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .step-desc {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  /* Mobile: layout 2x2 compacto para caber na seção pinada (100svh) */
  @media (max-width: 767px) {
    .section-header {
      margin-bottom: 1.25rem;
    }
    .section-title {
      font-size: 1.35rem;
    }
    .how-progress {
      margin-top: 0.85rem;
    }
    :global(.section-how .step-card) {
      padding: 1.25rem !important;
    }
    .step-top {
      margin-bottom: 0.85rem;
    }
    .step-icon {
      width: 42px;
      height: 42px;
      border-radius: 11px;
    }
    .step-num {
      font-size: 2rem;
    }
    .step-title {
      font-size: 1.05rem;
      margin-bottom: 0.35rem;
    }
    .step-desc {
      font-size: 0.85rem;
      line-height: 1.4;
    }
  }
</style>
