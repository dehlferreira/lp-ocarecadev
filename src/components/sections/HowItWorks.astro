---
import GlassCard from '../ui/GlassCard.astro';
import Icon from '../ui/Icon.astro';

const steps = [
  {
    num: '01',
    icon: 'spark',
    title: 'Entendemos sua oferta',
    desc: 'O que você vende, para quem e qual ação queremos gerar.',
  },
  {
    num: '02',
    icon: 'layout-template',
    title: 'Construímos a página',
    desc: 'Copy, estrutura, design e experiência trabalhando juntos.',
  },
  {
    num: '03',
    icon: 'sliders-horizontal',
    title: 'Ajustamos para o seu negócio',
    desc: 'Identidade, imagens, argumentos e integrações.',
  },
  {
    num: '04',
    icon: 'rocket',
    title: 'Publicamos e medimos',
    desc: 'Página no ar com WhatsApp, Analytics e tracking conforme o plano contratado.',
  },
];

---

<section id="como-funciona" class="section-how section-fade-bottom">
  <!-- Conector Luminoso de Transição Fluida -->
  <div class="transition-beam" aria-hidden="true"></div>
  <div class="transition-ambient-glow" aria-hidden="true"></div>

  <div class="scrolly scrolly--5">
    <div class="scrolly__stage">
      <div class="container">
        <div class="section-header">
          <h2 class="section-title scroll-animate anim-rise-sm">Um processo simples, direto e focado em <span class="text-neon">resultado</span></h2>
          <span class="how-progress scroll-animate" aria-hidden="true"></span>
        </div>

        <div class="steps-grid">
          {steps.map((step, i) => (
            <GlassCard class={`step-card scroll-animate anim-rise-sm delay-${(i + 1) * 100}`}>
              <div class="step-top">
                <span class="step-icon">
                  <Icon name={step.icon} size={24} />
                </span>
                <span class="step-num">{step.num}</span>
              </div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-desc">{step.desc}</p>
            </GlassCard>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const setupHowItWorksRepeat = () => {
    if (typeof IntersectionObserver === 'undefined') return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
        } else {
          // Se o elemento saiu pela parte de baixo da tela (usuário rolou para cima)
          if (entry.boundingClientRect.top > 0) {
            entry.target.classList.remove('is-revealed');
          }
        }
      });
    }, {
      rootMargin: '0px 0px -10% 0px', // Aciona quando 10% da parte inferior ainda não apareceu
      threshold: 0
    });

    const elements = document.querySelectorAll('#como-funciona .scroll-animate');
    elements.forEach(el => observer.observe(el));
  };

  setupHowItWorksRepeat();
  document.addEventListener('astro:page-load', setupHowItWorksRepeat);
</script>

<style>
  .section-how {
    padding: 4rem 0;
    background-color: #0A0A0A;
    position: relative;
    overflow: visible;
  }
  
  @media (min-width: 768px) {
    .section-how {
      padding: 6rem 0;
    }
  }

  /* Conector de Transição Fluida */
  .transition-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 157, 0.04) 15%,
      rgba(0, 255, 157, 0.45) 50%,
      rgba(0, 255, 157, 0.04) 85%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  .transition-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 800px;
    height: 90px;
    background: radial-gradient(
      ellipse 60% 70px at 50% 0%,
      rgba(0, 255, 157, 0.14) 0%,
      rgba(0, 255, 157, 0.03) 55%,
      transparent 100%
    );
    z-index: 10;
    pointer-events: none;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .section-header {
      margin-bottom: 3.5rem;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 3rem;
    }
  }

  /* Barra de progresso animada */
  .how-progress {
    display: block;
    width: min(220px, 70%);
    height: 4px;
    margin: 1.5rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-primary-neon), #00A666);
    box-shadow: 0 0 16px rgba(0, 255, 157, 0.45);
  }

  .how-progress.scroll-animate {
    opacity: 1 !important;
    transform: scaleX(0) !important;
    transform-origin: left;
    transition: transform 1.3s cubic-bezier(0.16, 1, 0.3, 1) 0.3s !important;
  }
  
  .how-progress.scroll-animate.is-revealed {
    transform: scaleX(1) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .how-progress.scroll-animate {
      transform: scaleX(1) !important;
      transition: none !important;
    }
  }

  .steps-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, 1fr);
    position: relative;
  }

  @media (min-width: 768px) {
    .steps-grid {
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  :global(.step-card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem !important;
    position: relative;
    overflow: visible;
    transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), 
                transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), 
                border-color 0.35s ease, 
                box-shadow 0.35s ease !important;
  }

  /* Cascata com delays um pouco mais curtos */
  :global(.step-card.delay-100) { transition-delay: 300ms, 300ms, 0s, 0s !important; }
  :global(.step-card.delay-200) { transition-delay: 500ms, 500ms, 0s, 0s !important; }
  :global(.step-card.delay-300) { transition-delay: 700ms, 700ms, 0s, 0s !important; }
  :global(.step-card.delay-400) { transition-delay: 900ms, 900ms, 0s, 0s !important; }

  :global(.step-card:hover) {
    transform: translateY(-4px) !important;
    border-color: rgba(0, 255, 157, 0.4) !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), inset 0 1px 1px rgba(255, 255, 255, 0.12), 0 0 24px rgba(0, 255, 157, 0.1) !important;
    transition-delay: 0s, 0s, 0s, 0s !important; 
  }

  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 1.5rem;
  }

  /* Badge do ícone — quadrado arredondado com tint neon */
  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.25);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.08),
      0 4px 16px rgba(0, 255, 157, 0.12);
    transition: all 0.3s ease;
  }

  :global(.step-card:hover) .step-icon {
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15), 0 4px 20px rgba(0, 255, 157, 0.35);
    color: #ffffff;
    background: rgba(0, 255, 157, 0.15);
  }

  /* Número preenchido com gradiente neon (substitui o text-stroke quebrado) */
  .step-num {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: transparent;
    background-image: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.18),
      rgba(0, 255, 157, 0.28)
    );
    background-clip: text;
    -webkit-background-clip: text;
    font-variant-numeric: tabular-nums;
  }

  /* Conector horizontal entre os cards (somente desktop 4-col) */
  @media (min-width: 1024px) {
    :global(.step-card)::after {
      content: '';
      position: absolute;
      top: calc(2rem + 26px); /* centro vertical do badge de 52px */
      right: -2rem;
      width: 2rem;
      height: 1px;
      background: linear-gradient(
        to right,
        rgba(0, 255, 157, 0.4),
        rgba(0, 255, 157, 0)
      );
      transform: translateY(-50%);
      pointer-events: none;
    }

    :global(.step-card):last-child::after {
      display: none;
    }
  }

  .step-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .step-desc {
    color: var(--color-text-secondary);
    font-size: 1rem;
  }

  /* Mobile: layout 2x2 com proporção confortável ocupando a tela cheia */
  @media (max-width: 767px) {
    .section-how .container {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding-top: 0.25rem;
      padding-bottom: 0.5rem;
    }
    .section-header {
      margin-bottom: 1rem;
    }
    .section-title {
      font-size: 1.4rem;
      line-height: 1.22;
    }
    .how-progress {
      margin-top: 0.65rem;
      height: 3px;
    }
    .steps-grid {
      gap: 0.75rem;
      flex: 1;
      align-content: center;
    }
    :global(.section-how .step-card) {
      padding: 1.15rem 0.95rem !important;
    }
    .step-top {
      margin-bottom: 0.65rem;
    }
    .step-icon {
      width: 38px;
      height: 38px;
      border-radius: 10px;
    }
    .step-icon :global(.icon) {
      width: 20px;
      height: 20px;
    }
    .step-num {
      font-size: 1.85rem;
    }
    .step-title {
      font-size: 0.98rem;
      margin-bottom: 0.25rem;
      line-height: 1.25;
    }
    .step-desc {
      font-size: 0.8rem;
      line-height: 1.38;
    }
  }
</style>
