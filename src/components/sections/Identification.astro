---
import Icon from '../ui/Icon.astro';

const categories = [
  { name: 'Prestadores de Serviço', icon: 'wrench' },
  { name: 'Clínicas & Saúde', icon: 'heart-pulse' },
  { name: 'Escritórios & Consultorias', icon: 'briefcase' },
  { name: 'Negócios Locais', icon: 'map-pin' },
  { name: 'Profissionais Liberais', icon: 'user-check' },
];
---

<section id="identificacao" class="section-identification section-fade-bottom">
  <!-- Conector Luminoso de Transição Fluida vindo da Hero -->
  <div class="transition-beam" aria-hidden="true"></div>
  <div class="transition-ambient-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="identification-card" id="identification-card">
      <div class="identification-header">
        <span class="identification-badge">
          <span class="badge-dot"></span>
          Para quem é OCARECADEV
        </span>
        <h2 class="identification-title">
          Feita para negócios que precisam transformar atenção em <span class="text-neon">oportunidades</span>
        </h2>
        <p class="identification-desc">
          Para prestadores de serviço, clínicas, escritórios, negócios locais e profissionais que usam Instagram, Google, anúncios ou indicação para atrair novos clientes.
        </p>
      </div>

      <div class="identification-chips" role="list" aria-label="Segmentos atendidos">
        {categories.map((cat) => (
          <div class="chip-item" role="listitem">
            <span class="chip-icon">
              <Icon name={cat.icon} size={15} stroke={2.2} />
            </span>
            <span class="chip-text">{cat.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .section-identification {
    padding: 3rem 0 2.75rem;
    background-color: #050709;
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .section-identification {
      padding: 4rem 0 3.5rem;
    }
  }

  /* Conector de Transição Fluida vindo da Hero (Linha de Feixe + Glow) */
  .transition-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 157, 0.04) 15%,
      rgba(0, 255, 157, 0.45) 50%,
      rgba(0, 255, 157, 0.04) 85%,
      transparent 100%
    );
    z-index: 3;
    pointer-events: none;
  }

  .transition-ambient-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 800px;
    height: 90px;
    background: radial-gradient(
      ellipse 60% 70px at 50% 0%,
      rgba(0, 255, 157, 0.14) 0%,
      rgba(0, 255, 157, 0.03) 55%,
      transparent 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .identification-card {
    background: rgba(18, 22, 28, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.25rem 2rem;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    text-align: center;
    position: relative;
    z-index: 4;
  }

  .identification-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 157, 0.45), transparent);
  }

  .identification-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.25);
    color: var(--color-primary-neon);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.1rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-primary-neon);
    box-shadow: 0 0 8px var(--color-primary-neon);
  }

  .identification-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.3;
    max-width: 720px;
    margin: 0 auto 0.85rem;
  }

  @media (min-width: 768px) {
    .identification-title {
      font-size: 2rem;
    }
  }

  .identification-desc {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 1.75rem;
  }

  .identification-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
  }

  .chip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 999px;
    color: #e0e0e0;
    font-size: 0.84rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .chip-item:hover {
    border-color: rgba(0, 255, 157, 0.35);
    background: rgba(0, 255, 157, 0.06);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .chip-icon {
    color: var(--color-primary-neon);
    display: grid;
    place-items: center;
  }

  @media (max-width: 640px) {
    .identification-card {
      padding: 1.75rem 1.15rem;
    }

    .identification-title {
      font-size: 1.3rem;
    }

    .identification-desc {
      font-size: 0.92rem;
      margin-bottom: 1.25rem;
    }

    .chip-item {
      font-size: 0.78rem;
      padding: 0.4rem 0.75rem;
    }
  }

  /* Animação com efeito de mola disparada quando 40% da seção aparece */
  .identification-card.card-spring-ready {
    opacity: 0;
    visibility: hidden;
    transform: translateX(-130px);
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease, visibility 0.45s ease;
    will-change: transform, opacity;
  }

  .identification-card.card-spring-ready.is-spring-in {
    opacity: 1;
    visibility: visible;
    animation: spring-bounce-in 0.95s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
  }

  @keyframes spring-bounce-in {
    0% {
      opacity: 0;
      visibility: visible;
      transform: translateX(-140px) scale(0.96);
    }
    25% {
      opacity: 1;
    }
    45% {
      /* Batida na mola com compressão à direita (ultrapassa o centro) */
      transform: translateX(38px) scale(1.02);
    }
    63% {
      /* Recuo elástico da mola para a esquerda */
      transform: translateX(-16px) scale(0.99);
    }
    77% {
      /* Segundo rebote elástico */
      transform: translateX(8px) scale(1.004);
    }
    89% {
      /* Amortecimento */
      transform: translateX(-3px) scale(0.998);
    }
    96% {
      transform: translateX(1px);
    }
    100% {
      opacity: 1;
      visibility: visible;
      transform: translateX(0) scale(1);
    }
  }

  @media (max-width: 767px) {
    .identification-card.card-spring-ready {
      transform: translateX(-80px);
    }

    .identification-card.card-spring-ready.is-spring-in {
      animation: spring-bounce-in-mobile 0.9s cubic-bezier(0.18, 0.89, 0.32, 1.28) forwards;
    }

    @keyframes spring-bounce-in-mobile {
      0% {
        opacity: 0;
        visibility: visible;
        transform: translateX(-90px);
      }
      25% {
        opacity: 1;
      }
      45% {
        transform: translateX(24px);
      }
      63% {
        transform: translateX(-11px);
      }
      77% {
        transform: translateX(5px);
      }
      89% {
        transform: translateX(-2px);
      }
      100% {
        opacity: 1;
        visibility: visible;
        transform: translateX(0);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .identification-card.card-spring-ready,
    .identification-card.card-spring-ready.is-spring-in {
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const setupIdentificationSpring = () => {
    // Respeita preferência por redução de movimento (G2)
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return;
    }

    const section = document.getElementById('identificacao');
    const card = document.getElementById('identification-card');
    if (!section || !card) return;

    // Prepara o card para animação (inicia oculto até atingir 40% de visibilidade)
    card.classList.add('card-spring-ready');

    let isTriggered = false;

    const checkAndTrigger = () => {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const sectionHeight = section.offsetHeight;

      // Quantos pixels do topo da seção já entraram na janela
      const visibleFromTop = windowHeight - rect.top;
      const triggerThreshold = sectionHeight * 0.4;
      const resetThreshold = sectionHeight * 0.32;

      // Se desceu o scroll e 40% da seção apareceu: aciona animação de mola
      if (visibleFromTop >= triggerThreshold && rect.bottom > 0) {
        if (!isTriggered) {
          isTriggered = true;
          card.classList.add('is-spring-in');
        }
      } else if (visibleFromTop < resetThreshold || rect.top > windowHeight + 60) {
        // Se subiu/voltou o scroll: desfaz a animação suavemente
        if (isTriggered) {
          isTriggered = false;
          card.classList.remove('is-spring-in');
        }
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          checkAndTrigger();
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    // Checagem imediata caso a página já tenha sido carregada no ponto
    checkAndTrigger();
  };

  setupIdentificationSpring();
  document.addEventListener('astro:page-load', setupIdentificationSpring);
</script>
