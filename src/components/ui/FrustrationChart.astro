---
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['frustration-mockup', { 'frustration-mockup--compact': compact }]}>
  <div class="screen">
    <div class="screen-bar">
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
      <span class="browser-address">suamarca.com.br</span>
    </div>

    <div class="screen-body">
      <div class="dashboard-heading">
        <div>
          <p class="eyebrow">Resumo da semana</p>
          <h3>Visitas sem conversao</h3>
        </div>
        <span class="warning"><Icon name="trending-down" size={14} stroke={2.5} /> Atenção</span>
      </div>

      <div class="metric-grid">
        <div class="metric-card">
          <span>Visitas</span><strong>1.284</strong><small>este mes</small>
        </div>
        <div class="metric-card metric-card--critical">
          <span>Contatos</span><strong>0 contatos</strong><small>nenhuma mensagem</small>
        </div>
      </div>

      <div class="lead-alert">
        <span class="alert-icon"><Icon name="x" size={15} stroke={3} /></span>
        <div>
          <strong>Nenhum lead nesta semana</strong>
          <span>Seu site recebe acessos, mas nao direciona a proxima acao.</span>
        </div>
      </div>

      <div class="page-preview">
        <div class="preview-copy">
          <span>Seu servico</span><b>Uma frase que nao explica o valor</b><i>CTA pouco visivel</i>
        </div>
        <span class="faded-cta">Saiba mais</span>
      </div>
    </div>
  </div>
</div>

<style>
  .frustration-mockup { width: 100%; max-width: 560px; margin: 0 auto; }
  .frustration-mockup--compact { max-width: none; }
  .screen { overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; background: #0d0f12; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 50px rgba(255, 92, 92, 0.12); }
  .screen-bar { display: flex; align-items: center; gap: 0.4rem; padding: 0.7rem 0.9rem; border-bottom: 1px solid rgba(255, 255, 255, 0.06); background: #15181d; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: rgba(255, 255, 255, 0.2); }
  .browser-address { flex: 1; margin-left: 0.55rem; padding: 0.3rem 0.6rem; border-radius: 4px; background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.35); font-size: 0.68rem; }
  .screen-body { padding: 1.25rem; }
  .dashboard-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; }
  .eyebrow, .dashboard-heading h3, .metric-card span, .metric-card small, .lead-alert strong, .lead-alert span, .preview-copy span, .preview-copy b, .preview-copy i { margin: 0; }
  .eyebrow { color: rgba(255, 255, 255, 0.42); font-size: 0.68rem; font-weight: 700; text-transform: uppercase; }
  .dashboard-heading h3 { margin-top: 0.3rem; color: #fff; font-size: 1.2rem; line-height: 1.1; }
  .warning { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.32rem 0.55rem; border: 1px solid rgba(255, 92, 92, 0.3); border-radius: 5px; color: #ff7777; background: rgba(255, 92, 92, 0.1); font-size: 0.7rem; font-weight: 800; white-space: nowrap; }
  .metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1rem; }
  .metric-card { padding: 0.8rem; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 7px; background: rgba(255, 255, 255, 0.035); }
  .metric-card--critical { border-color: rgba(255, 92, 92, 0.3); background: rgba(255, 92, 92, 0.06); }
  .metric-card span, .metric-card small { display: block; color: rgba(255, 255, 255, 0.48); font-size: 0.7rem; }
  .metric-card strong { display: block; margin: 0.3rem 0 0.18rem; color: #fff; font-size: 1.25rem; line-height: 1; }
  .metric-card--critical strong { color: #ff7777; }
  .lead-alert { display: flex; gap: 0.65rem; margin-top: 0.8rem; padding: 0.75rem; border-left: 2px solid #ff5c5c; background: rgba(255, 92, 92, 0.08); }
  .alert-icon { display: grid; width: 22px; height: 22px; flex: 0 0 22px; place-items: center; border-radius: 50%; color: #fff; background: #c94444; }
  .lead-alert strong { display: block; color: #fff; font-size: 0.75rem; }
  .lead-alert span:not(.alert-icon) { display: block; margin-top: 0.16rem; color: rgba(255, 255, 255, 0.56); font-size: 0.68rem; line-height: 1.4; }
  .page-preview { display: flex; align-items: end; justify-content: space-between; gap: 0.8rem; margin-top: 0.8rem; padding: 0.75rem; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 7px; opacity: 0.55; background: #17191c; }
  .preview-copy span, .preview-copy b, .preview-copy i { display: block; }
  .preview-copy span, .preview-copy i { color: rgba(255, 255, 255, 0.5); font-size: 0.62rem; font-style: normal; }
  .preview-copy b { max-width: 11rem; margin: 0.22rem 0; color: rgba(255, 255, 255, 0.82); font-size: 0.76rem; line-height: 1.15; }
  .faded-cta { padding: 0.4rem 0.55rem; border-radius: 4px; color: rgba(255, 255, 255, 0.48); background: rgba(255, 255, 255, 0.1); font-size: 0.62rem; font-weight: 700; white-space: nowrap; }
  @media (max-width: 767px) { .screen-body { padding: 0.9rem; } .screen-bar { padding: 0.5rem 0.65rem; } .dot { width: 7px; height: 7px; } .dashboard-heading h3 { font-size: 1.05rem; } .metric-card { padding: 0.65rem; } .metric-card strong { font-size: 1.05rem; } .lead-alert { padding: 0.6rem; } .page-preview { padding: 0.6rem; } }
</style>
