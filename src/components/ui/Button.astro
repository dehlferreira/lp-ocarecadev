---
export interface Props {
  text?: string;
  href?: string;
  type?: 'primary' | 'ghost';
  class?: string;
  id?: string;
  [x: string]: any;
}

const { text, href, type = 'primary', class: className, id, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag href={href} id={id} class:list={['btn', `btn-${type}`, className]} {...rest}>
  {text ? text : <slot />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: normal;
    padding: 0.8rem 1.8rem;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 100px; /* Formato Pill moderno */
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Animação mais elástica */
    text-transform: uppercase;
    letter-spacing: 1px; /* Reduzi levemente o tracking para caber melhor */
    position: relative;
    overflow: hidden;
    /* Correção para backdrop-filter no Safari Mobile */
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }
  
  .btn:active {
    transform: translateY(1px) scale(0.98);
  }

  /* Ajuste para mobile para não ficar muito grande */
  @media (max-width: 768px) {
    .btn {
      padding: 0.7rem 1.5rem;
      font-size: 1rem;
    }
  }

  /* CTAs dos cards de pricing — uma linha só (escopo do Button vence sobre Pricing) */
  .btn-pricing-cta {
    white-space: nowrap;
    font-size: 0.875rem;
    letter-spacing: 0.03em;
    padding: 0.75rem 1rem;
  }

  @media (min-width: 768px) {
    .btn-pricing-cta {
      font-size: 0.8125rem;
      padding: 0.75rem 0.875rem;
    }
  }

  .btn-primary {
    background: linear-gradient(135deg, rgba(0, 255, 157, 0.35) 0%, rgba(0, 255, 157, 0.12) 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: #ffffff;
    font-weight: 700;
    border: 1px solid rgba(0, 255, 157, 0.55);
    border-top: 1px solid rgba(255, 255, 255, 0.45); /* Luz suave de chanfro */
    border-bottom: 1px solid rgba(0, 255, 157, 0.3);
    box-shadow: 0 4px 25px rgba(0, 255, 157, 0.25), inset 0 1px 1px rgba(255, 255, 255, 0.35), inset 0 -1px 2px rgba(0, 0, 0, 0.25);
    text-shadow: 0 0 10px rgba(0, 255, 157, 0.7), 0 1px 2px rgba(0, 0, 0, 0.8);
    animation: pulse-neon 2.5s infinite alternate;
  }

  @keyframes pulse-neon {
    0% {
      box-shadow: 0 4px 20px rgba(0, 255, 157, 0.2), inset 0 1px 1px rgba(255, 255, 255, 0.3);
    }
    100% {
      box-shadow: 0 6px 32px rgba(0, 255, 157, 0.45), inset 0 1px 2px rgba(255, 255, 255, 0.5);
    }
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, rgba(0, 255, 157, 0.5) 0%, rgba(0, 255, 157, 0.25) 100%);
    border-color: var(--color-primary-neon);
    border-top-color: rgba(255, 255, 255, 0.6);
    box-shadow: 0 0 35px rgba(0, 255, 157, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.5);
    transform: translateY(-3px) scale(1.02) translateZ(0);
    -webkit-transform: translateY(-3px) scale(1.02) translateZ(0);
    animation: none; /* Pausa o pulso no hover */
  }

  /* Fallback progressivo para navegadores sem suporte a backdrop-filter */
  @supports not (backdrop-filter: blur(1px)) {
    .btn-primary {
      background: linear-gradient(135deg, rgba(3, 40, 25, 0.95) 0%, rgba(1, 20, 12, 0.95) 100%);
      border-color: var(--color-primary-neon);
    }
  }

  .btn-ghost {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-text-primary);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2), inset 0 1px 1px rgba(255, 255, 255, 0.1);
  }

  .btn-ghost:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.03) 100%);
    border-color: rgba(255, 255, 255, 0.25);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.15);
    transform: translateY(-3px) scale(1.02) translateZ(0);
    -webkit-transform: translateY(-3px) scale(1.02) translateZ(0);
  }

  /* Brilho diagonal passando pelo botão (Shine effect) */
  .btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);
    transform: skewX(-20deg);
    transition: all 0.7s ease;
  }

  .btn:hover::after {
    left: 150%;
  }
</style>
