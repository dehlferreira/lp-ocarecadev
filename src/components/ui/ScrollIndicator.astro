---
interface Props {
  text?: string;
  class?: string;
}

const { text = "Role para explorar", class: className = "" } = Astro.props;
---

<div id="global-scroll-indicator" class:list={["scroll-indicator", className]} aria-hidden="true">
  <div class="scroll-indicator__mouse">
    <span class="scroll-indicator__wheel"></span>
  </div>
  <span class="scroll-indicator__text">{text}</span>
  <span class="scroll-indicator__chevrons">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </span>
</div>

<style>
  .scroll-indicator {
    position: fixed;
    bottom: max(calc(env(safe-area-inset-bottom, 0px) + 1.25rem), 1.25rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .scroll-indicator--visible {
    opacity: 1;
    visibility: visible;
  }

  .scroll-indicator__mouse {
    width: 20px;
    height: 30px;
    border: 2px solid rgba(0, 255, 157, 0.6);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 5px;
    background: rgba(10, 14, 18, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 0 15px rgba(0, 255, 157, 0.2);
  }

  .scroll-indicator__wheel {
    width: 3px;
    height: 6px;
    background: var(--color-primary-neon, #00ff9d);
    border-radius: 2px;
    animation: scroll-wheel-slide 1.8s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    box-shadow: 0 0 6px rgba(0, 255, 157, 0.8);
  }

  .scroll-indicator__text {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.9);
    background: rgba(10, 14, 18, 0.6);
    padding: 0.15rem 0.5rem;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .scroll-indicator__chevrons {
    color: var(--color-primary-neon, #00ff9d);
    display: grid;
    place-items: center;
    animation: scroll-chevron-pulse 1.8s ease-in-out infinite;
  }

  @keyframes scroll-wheel-slide {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    20% {
      opacity: 1;
    }
    60% {
      opacity: 1;
      transform: translateY(10px);
    }
    100% {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes scroll-chevron-pulse {
    0%, 100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(4px);
    }
  }

  @media (max-width: 767px) {
    .scroll-indicator {
      bottom: max(calc(env(safe-area-inset-bottom, 0px) + 0.85rem), 0.85rem);
    }
    .scroll-indicator__mouse {
      width: 18px;
      height: 26px;
    }
    .scroll-indicator__text {
      font-size: 0.58rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator__wheel,
    .scroll-indicator__chevrons {
      animation: none !important;
    }
  }
</style>

<script>
  const initScrollIndicator = () => {
    const indicator = document.getElementById('global-scroll-indicator');
    if (!indicator) return;

    let ticking = false;

    const updateVisibility = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

          // Visível na página toda conforme solicitado; oculta apenas no rodapé final
          const isNearBottom = scrollY > maxScroll - 160;

          if (!isNearBottom) {
            indicator.classList.add('scroll-indicator--visible');
          } else {
            indicator.classList.remove('scroll-indicator--visible');
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', updateVisibility, { passive: true });
    // Inicia visível para convidar ao scroll
    indicator.classList.add('scroll-indicator--visible');
    updateVisibility();
  };

  initScrollIndicator();
  document.addEventListener('astro:page-load', initScrollIndicator);
</script>
