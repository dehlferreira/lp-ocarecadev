---
import { Image } from 'astro:assets';
import websiteMockup from '../../assets/images/problem-website-mockup.webp';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['problem-mockup', { 'problem-mockup--compact': compact }]}>
  <div class="mockup-frame">
    <Image
      src={websiteMockup}
      alt="Mockup de landing page representando o que você faz sem jargão, diferenciais perceptíveis e botão de ação óbvio"
      class="mockup-img"
      widths={[380, 600, 912]}
      sizes="(max-width: 767px) 92vw, (max-width: 1024px) 600px, 912px"
      loading="lazy"
      decoding="async"
      quality={82}
    />
    <!-- Feixe sutil de scanner de auditoria -->
    <div class="mockup-scanner-beam" aria-hidden="true">
      <span class="scanner-line"></span>
      <span class="scanner-glow"></span>
    </div>
  </div>
</div>

<style>
  .problem-mockup {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .problem-mockup--compact {
    height: 100%;
    max-width: none;
  }

  .mockup-frame {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.75)) drop-shadow(0 0 35px rgba(0, 255, 136, 0.12));
    transition: transform 0.3s ease;
  }

  .mockup-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 912 / 617;
    object-fit: contain;
    image-rendering: -webkit-optimize-contrast;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Scanner de auditoria em tempo real */
  .mockup-scanner-beam {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: 10px;
    z-index: 10;
    transform: translateZ(2px);
  }

  .scanner-line {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 255, 157, 0.3) 12%,
      #00ff9d 50%,
      rgba(0, 255, 157, 0.3) 88%,
      transparent 100%
    );
    box-shadow: 0 0 14px #00ff9d, 0 0 28px rgba(0, 255, 157, 0.85), 0 0 45px rgba(0, 255, 157, 0.45);
    z-index: 12;
    will-change: top;
    animation: scanner-sweep 3.6s ease-in-out infinite alternate;
  }

  .scanner-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 75px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 255, 157, 0.04) 40%,
      rgba(0, 255, 157, 0.22) 100%
    );
    z-index: 11;
    will-change: top;
    animation: scanner-sweep-glow 3.6s ease-in-out infinite alternate;
  }

  @keyframes scanner-sweep {
    0% {
      top: 0%;
      opacity: 0.9;
    }
    50% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 3px);
      opacity: 0.9;
    }
  }

  @keyframes scanner-sweep-glow {
    0% {
      top: -75px;
      opacity: 0.8;
    }
    50% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 75px);
      opacity: 0.8;
    }
  }

  @media (max-width: 767px) {
    .problem-mockup {
      width: 100%;
      max-width: 100%;
    }

    .problem-mockup--compact {
      height: auto;
      max-width: none;
      width: 100%;
    }

    .mockup-frame {
      width: 100%;
    }

    .mockup-img {
      width: 100%;
      height: auto;
      max-height: none;
      aspect-ratio: 912 / 617;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mockup-scanner-beam {
      display: none !important;
    }
  }
</style>
