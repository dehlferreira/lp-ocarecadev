---
import { Image } from 'astro:assets';
import websiteMockup from '../../assets/images/problem-website-mockup.webp';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['problem-mockup', { 'problem-mockup--compact': compact }]}>
  <div class="mockup-frame">
    <Image
      src={websiteMockup}
      alt="Mockup de landing page representando o que você faz sem jargão, diferenciais perceptíveis e botão de ação óbvio"
      class="mockup-img"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .problem-mockup {
    width: 100%;
    max-width: 540px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .problem-mockup--compact {
    height: 100%;
    max-width: none;
  }

  .mockup-frame {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 24px 60px rgba(0, 0, 0, 0.75)) drop-shadow(0 0 35px rgba(0, 255, 136, 0.12));
    transition: transform 0.3s ease;
  }

  .mockup-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1272 / 692;
    object-fit: contain;
  }

  @media (max-width: 767px) {
    .problem-mockup {
      width: 100%;
      max-width: 100%;
    }

    .problem-mockup--compact {
      height: auto;
      max-width: none;
      width: 100%;
    }

    .mockup-frame {
      width: 100%;
    }

    .mockup-img {
      width: 100%;
      height: auto;
      max-height: none;
    }
  }
</style>
