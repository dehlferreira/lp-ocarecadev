---
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['conversion-mockup', { 'conversion-mockup--compact': compact }]}>
  <div class="dashboard">
    <div class="dashboard-bar">
      <span class="brand-mark">O</span>
      <span>Funil de conversao</span>
      <span class="live-state"><i></i> ativo</span>
    </div>

    <div class="dashboard-body">
      <div class="dashboard-heading">
        <div>
          <p>Resultados da semana</p>
          <h3>Da visita ao cliente</h3>
        </div>
        <span class="conversion-rate">14% conversao</span>
      </div>

      <div class="funnel">
        <article class="funnel-step">
          <span class="step-index">01</span>
          <span class="step-icon"><Icon name="layout-template" size={16} stroke={2.2} /></span>
          <strong>Visita na pagina</strong>
          <b>1.284</b>
          <small>pessoas interessadas</small>
        </article>

        <span class="funnel-arrow"><Icon name="arrow-right" size={16} stroke={2.5} /></span>

        <article class="funnel-step funnel-step--active">
          <span class="step-index">02</span>
          <span class="step-icon"><Icon name="trending-up" size={16} stroke={2.2} /></span>
          <strong>Clique no WhatsApp</strong>
          <b>93</b>
          <small>conversas iniciadas</small>
        </article>

        <span class="funnel-arrow"><Icon name="arrow-right" size={16} stroke={2.5} /></span>

        <article class="funnel-step funnel-step--result">
          <span class="step-index">03</span>
          <span class="step-icon"><Icon name="check" size={16} stroke={2.7} /></span>
          <strong>Lead qualificado</strong>
          <b>18</b>
          <small>oportunidades reais</small>
        </article>
      </div>

      <div class="next-action">
        <span><i></i> Novo lead agora</span>
        <strong>Pedido de orcamento recebido</strong>
      </div>
    </div>
  </div>
</div>

<style>
  .conversion-mockup { display: flex; width: 100%; justify-content: center; }
  .dashboard { width: min(100%, 520px); overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px; background: #0c0f11; box-shadow: 0 28px 80px rgba(0, 0, 0, 0.68), 0 0 60px rgba(0, 255, 157, 0.12); }
  .dashboard-bar { display: flex; align-items: center; gap: 0.5rem; padding: 0.65rem 0.8rem; border-bottom: 1px solid rgba(255, 255, 255, 0.07); color: rgba(255, 255, 255, 0.58); background: #15191d; font-size: 0.7rem; font-weight: 700; }
  .brand-mark { display: grid; width: 20px; height: 20px; place-items: center; border-radius: 5px; color: #04120c; background: var(--color-primary-neon); font-size: 0.68rem; font-weight: 900; }
  .live-state { display: inline-flex; align-items: center; gap: 0.3rem; margin-left: auto; color: var(--color-primary-neon); font-size: 0.64rem; }
  .live-state i, .next-action i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary-neon); box-shadow: 0 0 10px rgba(0, 255, 157, 0.8); }
  .dashboard-body { padding: 1rem; }
  .dashboard-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 0.7rem; }
  .dashboard-heading p, .dashboard-heading h3 { margin: 0; }
  .dashboard-heading p { color: rgba(255, 255, 255, 0.42); font-size: 0.65rem; font-weight: 700; text-transform: uppercase; }
  .dashboard-heading h3 { margin-top: 0.24rem; color: #fff; font-size: 1.2rem; line-height: 1.05; }
  .conversion-rate { padding: 0.32rem 0.5rem; border: 1px solid rgba(0, 255, 157, 0.25); border-radius: 5px; color: var(--color-primary-neon); background: rgba(0, 255, 157, 0.08); font-size: 0.63rem; font-weight: 800; white-space: nowrap; }
  .funnel { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 0.35rem; margin-top: 1rem; }
  .funnel-step { min-width: 0; padding: 0.7rem; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: 7px; background: rgba(255, 255, 255, 0.035); }
  .funnel-step--active { border-color: rgba(0, 255, 157, 0.26); background: rgba(0, 255, 157, 0.06); }
  .funnel-step--result { border-color: rgba(0, 255, 157, 0.4); background: rgba(0, 255, 157, 0.1); }
  .step-index { display: block; color: rgba(255, 255, 255, 0.3); font-size: 0.57rem; font-weight: 800; }
  .step-icon { display: grid; width: 25px; height: 25px; margin: 0.4rem 0 0.55rem; place-items: center; border-radius: 5px; color: var(--color-primary-neon); background: rgba(0, 255, 157, 0.12); }
  .funnel-step strong, .funnel-step small { display: block; }
  .funnel-step strong { min-height: 2.25em; color: rgba(255, 255, 255, 0.75); font-size: 0.66rem; line-height: 1.12; }
  .funnel-step b { display: block; margin-top: 0.65rem; color: #fff; font-size: 1.25rem; line-height: 1; }
  .funnel-step--result b { color: var(--color-primary-neon); }
  .funnel-step small { margin-top: 0.25rem; color: rgba(255, 255, 255, 0.4); font-size: 0.57rem; line-height: 1.2; }
  .funnel-arrow { color: var(--color-primary-neon); opacity: 0.8; }
  .next-action { display: flex; align-items: center; justify-content: space-between; gap: 0.7rem; margin-top: 0.85rem; padding: 0.55rem 0.65rem; border-left: 2px solid var(--color-primary-neon); background: rgba(255, 255, 255, 0.035); }
  .next-action span { display: inline-flex; align-items: center; gap: 0.35rem; color: var(--color-primary-neon); font-size: 0.6rem; font-weight: 800; }
  .next-action strong { color: rgba(255, 255, 255, 0.7); font-size: 0.62rem; font-weight: 600; text-align: right; }
  .conversion-mockup--compact { height: 100%; }
  .conversion-mockup--compact .dashboard { width: 100%; height: 100%; }
  .conversion-mockup--compact .dashboard-body { display: flex; flex: 1; flex-direction: column; }
  .conversion-mockup--compact .next-action { margin-top: auto; }
  .conversion-mockup--compact .dashboard-body { padding: 0.75rem; }
  .conversion-mockup--compact .funnel-step { padding: 0.55rem; }
  .conversion-mockup--compact .step-icon { width: 21px; height: 21px; margin: 0.3rem 0 0.4rem; }
  .conversion-mockup--compact .funnel-step b { margin-top: 0.4rem; font-size: 1.02rem; }
  .conversion-mockup--compact .next-action { margin-top: 0.65rem; }
  @media (max-width: 767px) { .dashboard { border-radius: 10px; } .dashboard-bar { padding: 0.5rem 0.6rem; } .dashboard-heading h3 { font-size: 1.05rem; } .funnel { gap: 0.18rem; } .funnel-arrow { display: none; } .funnel { grid-template-columns: repeat(3, minmax(0, 1fr)); } .funnel-step { padding: 0.45rem; } .funnel-step strong { font-size: 0.56rem; } .funnel-step small { font-size: 0.5rem; } .step-index { font-size: 0.5rem; } .step-icon { width: 19px; height: 19px; margin: 0.26rem 0 0.35rem; } .funnel-step b { margin-top: 0.35rem; font-size: 0.95rem; } .next-action strong { display: none; } }
</style>
