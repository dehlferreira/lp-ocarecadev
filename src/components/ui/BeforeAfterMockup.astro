---
import Icon from './Icon.astro';
---

<div class="ba-mockup">
  <figure class="ba-card before">
    <span class="ba-tag tag-before">Antes</span>
    <div class="window window-before">
      <div class="window-bar">
        <span></span><span></span><span></span>
        <div>siteantigo.com.br</div>
      </div>
      <div class="page">
        <p class="mini-label">Hero sem oferta clara</p>
        <h3>Bem-vindo ao nosso site</h3>
        <p class="muted">Texto generico, botao escondido e nenhum motivo forte para chamar no WhatsApp.</p>
        <div class="weak-button">Saiba mais</div>
        <div class="weak-grid">
          <span></span><span></span><span></span>
        </div>
      </div>
    </div>
  </figure>

  <div class="ba-arrow" aria-hidden="true"><Icon name="arrow-right" size={28} stroke={2.5} /></div>

  <figure class="ba-card after">
    <span class="ba-tag tag-after">Depois</span>
    <div class="window window-after">
      <div class="window-bar window-bar-dark">
        <span></span><span></span><span></span>
        <div>paginaquevende.com.br</div>
      </div>
      <div class="page page-after">
        <p class="mini-label mini-label-neon">Oferta clara</p>
        <h3>Receba orcamentos qualificados todos os dias</h3>
        <p>Pagina com promessa direta, prova social e CTA visivel desde o primeiro scroll.</p>
        <div class="strong-button">Quero gerar clientes</div>
        <div class="metric-row">
          <span><strong>+42%</strong> conversao</span>
          <span><strong>18</strong> leads/semana</span>
        </div>
      </div>
    </div>
  </figure>
</div>

<style>
  .ba-mockup {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.1rem;
    width: 100%;
  }

  .ba-card {
    position: relative;
    min-width: 0;
    margin: 0;
  }

  .ba-tag {
    position: absolute;
    top: -13px;
    left: 16px;
    z-index: 3;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tag-before {
    color: rgba(255, 255, 255, 0.68);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .tag-after {
    color: #04120c;
    background: linear-gradient(135deg, var(--color-primary-neon), #00a666);
    box-shadow: 0 8px 26px rgba(0, 255, 157, 0.32);
  }

  .window {
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 22px 56px rgba(0, 0, 0, 0.5);
  }

  .window-before {
    background: #d7d9dc;
    filter: saturate(0.7);
    opacity: 0.88;
  }

  .window-after {
    background: #0c0f11;
    box-shadow:
      0 22px 64px rgba(0, 0, 0, 0.6),
      0 0 52px rgba(0, 255, 157, 0.18);
  }

  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.62rem 0.75rem;
    background: rgba(0, 0, 0, 0.08);
  }

  .window-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.22);
  }

  .window-bar div {
    flex: 1;
    margin-left: 0.35rem;
    color: rgba(0, 0, 0, 0.38);
    font-size: 0.64rem;
  }

  .window-bar-dark {
    background: #15191d;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .window-bar-dark span {
    background: rgba(255, 255, 255, 0.22);
  }

  .window-bar-dark div {
    color: rgba(255, 255, 255, 0.38);
  }

  .page {
    min-height: 230px;
    padding: 1.25rem;
    color: #262a2e;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.65), rgba(255, 255, 255, 0.28)),
      #d7d9dc;
  }

  .page-after {
    color: #fff;
    background:
      radial-gradient(circle at 82% 10%, rgba(0, 255, 157, 0.18), transparent 36%),
      linear-gradient(145deg, #121719, #080909);
  }

  .mini-label {
    display: inline-flex;
    margin: 0 0 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.08);
    color: rgba(0, 0, 0, 0.55);
    font-size: 0.64rem;
    font-weight: 800;
  }

  .mini-label-neon {
    color: var(--color-primary-neon);
    background: rgba(0, 255, 157, 0.08);
    border: 1px solid rgba(0, 255, 157, 0.22);
  }

  .page h3 {
    margin: 0;
    max-width: 18rem;
    font-size: 1.18rem;
    line-height: 1.1;
  }

  .page p:not(.mini-label) {
    margin: 0.65rem 0 0;
    color: rgba(0, 0, 0, 0.58);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .page-after p:not(.mini-label) {
    color: rgba(255, 255, 255, 0.7);
  }

  .weak-button,
  .strong-button {
    display: inline-flex;
    margin-top: 1rem;
    padding: 0.55rem 0.82rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 800;
  }

  .weak-button {
    color: rgba(0, 0, 0, 0.6);
    background: rgba(0, 0, 0, 0.12);
  }

  .strong-button {
    color: #04120c;
    background: var(--color-primary-neon);
    box-shadow: 0 0 24px rgba(0, 255, 157, 0.28);
  }

  .weak-grid,
  .metric-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .weak-grid span,
  .metric-row span {
    min-height: 56px;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.08);
  }

  .metric-row {
    grid-template-columns: repeat(2, 1fr);
  }

  .metric-row span {
    padding: 0.7rem;
    min-height: auto;
    color: rgba(255, 255, 255, 0.68);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(0, 255, 157, 0.16);
    font-size: 0.68rem;
  }

  .metric-row strong {
    display: block;
    color: #fff;
    font-size: 0.95rem;
  }

  .ba-arrow {
    display: inline-flex;
    color: var(--color-primary-neon);
    filter: drop-shadow(0 0 10px rgba(0, 255, 157, 0.55));
  }

  @media (max-width: 600px) {
    .ba-mockup {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }

    .ba-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }

    .page {
      min-height: 172px;
      padding: 0.95rem;
    }

    .page h3 {
      font-size: 1rem;
    }

    .weak-grid {
      display: none;
    }
  }
</style>
