---
export interface Props {
  as?: 'div' | 'details';
  class?: string;
  padding?: string;
  highlight?: boolean;
  [x: string]: any;
}

const { as: Tag = 'div', class: className, padding = '2rem', highlight, ...rest } = Astro.props;
---

<Tag class:list={['glass-card', className, { 'highlight-card': highlight }]} style={`padding: ${padding};`} {...rest}>
  <slot />
</Tag>

<style>
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    box-shadow: var(--glass-shadow);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
    will-change: transform;
  }
  
  @media (hover: hover) {
    .glass-card:hover {
      border-color: rgba(0, 255, 157, 0.45);
      background: rgba(255, 255, 255, 0.07);
      box-shadow: 0 10px 35px 0 rgba(0, 255, 157, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.15);
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass-card {
      transition: none !important;
      will-change: auto;
    }
    .glass-card:hover {
      transform: none !important;
    }
  }
</style>
