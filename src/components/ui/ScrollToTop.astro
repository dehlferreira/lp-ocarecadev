---
import Icon from './Icon.astro';
---

<button
  id="btn-scroll-to-top"
  class="scroll-to-top"
  type="button"
  aria-label="Voltar ao topo da página"
  title="Voltar ao topo da página"
>
  <span class="scroll-to-top__icon">
    <Icon name="arrow-up" size={22} stroke={2.5} />
  </span>
</button>

<style>
  .scroll-to-top {
    position: fixed;
    left: 1.5rem;
    bottom: 1.5rem;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(12, 16, 20, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(0, 255, 157, 0.35);
    color: var(--color-primary-neon, #00ff9d);
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 255, 157, 0.15);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(14px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .scroll-to-top:hover {
    border-color: rgba(0, 255, 157, 0.8);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.7), 0 0 25px rgba(0, 255, 157, 0.35);
    transform: translateY(-3px);
  }

  .scroll-to-top:hover .scroll-to-top__icon {
    transform: translateY(-2px);
  }

  .scroll-to-top:active {
    transform: translateY(0);
  }

  .scroll-to-top:focus-visible {
    outline: 2px solid var(--color-primary-neon, #00ff9d);
    outline-offset: 3px;
  }

  .scroll-to-top--visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .scroll-to-top__icon {
    display: grid;
    place-items: center;
    transition: transform 0.2s ease;
  }

  @media (max-width: 767px) {
    .scroll-to-top {
      left: max(calc(env(safe-area-inset-left, 0px) + 1.25rem), 1.25rem);
      bottom: max(calc(env(safe-area-inset-bottom, 0px) + 1.25rem), 1.25rem);
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-to-top {
      transition: none !important;
    }
    .scroll-to-top:hover {
      transform: none !important;
    }
  }
</style>

<script>
  const initScrollToTop = () => {
    const btn = document.getElementById('btn-scroll-to-top');
    if (!btn) return;

    let ticking = false;

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          // Surge quando passar de 320px de scroll (após a Hero)
          if (window.scrollY > 320) {
            btn.classList.add('scroll-to-top--visible');
          } else {
            btn.classList.remove('scroll-to-top--visible');
          }
          ticking = false;
        });
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });
    });
  };

  initScrollToTop();
  document.addEventListener('astro:page-load', initScrollToTop);
</script>
