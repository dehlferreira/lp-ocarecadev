---
import '../styles/global.css';
import WhatsAppFab from '../components/ui/WhatsAppFab.astro';
import ScarcityToast from '../components/ui/ScarcityToast.astro';
import ScrollToTop from '../components/ui/ScrollToTop.astro';
import ScrollIndicator from '../components/ui/ScrollIndicator.astro';
import CookieConsent from '../components/ui/CookieConsent.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "OCARECADEV | Landing Pages e Sites Estratégicos que Convertem" } = Astro.props;

// URLs absolutas evitam versões duplicadas da página em buscadores e previews sociais.
const siteUrl = Astro.site || Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/og-image.jpg', siteUrl);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}#business`,
    name: 'OCARECADEV',
    url: siteUrl.toString(),
    logo: ogImage.toString(),
    image: ogImage.toString(),
    description: 'Criação de landing pages e sites estratégicos para transformar visitantes em contatos e clientes.',
    areaServed: 'Brasil',
    sameAs: [
      'https://www.instagram.com/ocarecadev',
      'https://www.tiktok.com/@ocarecadev',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'OCARECADEV',
    url: siteUrl.toString(),
    inLanguage: 'pt-BR',
    publisher: { '@id': `${siteUrl}#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Já tenho Instagram. Ainda preciso de uma landing page?', acceptedAnswer: { '@type': 'Answer', text: 'O Instagram é ótimo para atrair atenção, mas é limitado para explicar uma oferta completa e fechar. Na landing page, o visitante não se distrai com notificações ou concorrentes: ele encontra sua proposta de valor clara e um botão direto para conversar com você no WhatsApp.' } },
      { '@type': 'Question', name: 'Preciso anunciar para a página funcionar?', acceptedAnswer: { '@type': 'Answer', text: 'Não obrigatoriamente. Uma landing page bem estruturada potencializa qualquer tráfego que você já receba, seja do link da bio do Instagram, indicação de clientes, Google Meu Negócio ou abordagens diretas. Quando você decidir investir em anúncios (Google ou Meta), a página já estará pronta para converter esse tráfego em contatos.' } },
      { '@type': 'Question', name: 'Vocês também fazem os textos da página?', acceptedAnswer: { '@type': 'Answer', text: 'Sim. Nós estruturamos toda a copy (redação persuasiva) com base no seu público, nos seus diferenciais e no objetivo da página. Você só precisa nos passar as informações essenciais sobre o seu negócio e validar o conteúdo antes da publicação.' } },
      { '@type': 'Question', name: 'Domínio e hospedagem estão incluídos?', acceptedAnswer: { '@type': 'Answer', text: 'O domínio (ex.: suaempresa.com.br) é registrado em seu nome para garantir que a propriedade seja sempre sua (custa em média R$ 40/ano no Registro.br). Nós cuidamos de toda a configuração técnica e a hospedagem é feita em infraestrutura moderna, ultrarrápida e com SSL gratuito.' } },
      { '@type': 'Question', name: 'Por que não fazer sozinho no Wix, Canva ou WordPress?', acceptedAnswer: { '@type': 'Answer', text: 'Ferramentas visuais genéricas costumam gerar páginas lentas, pesadas e que quebram no celular. Além disso, a ferramenta não resolve a estratégia: nossa entrega combina código limpo de altíssima velocidade com redação e UX orientadas a fazer o visitante entender e agir.' } },
      { '@type': 'Question', name: 'Qual a diferença entre o Express e a Landing que Vende?', acceptedAnswer: { '@type': 'Answer', text: 'O Express é voltado para quem precisa entrar no ar rápido, utilizando uma estrutura validada com personalização ágil de marca e conteúdo. A Landing que Vende é um projeto 100% estratégico e aprofundado, construído sob medida com copy específica para sua oferta e tracking detalhado de comportamento.' } },
      { '@type': 'Question', name: 'Depois que a página estiver pronta, ela é minha?', acceptedAnswer: { '@type': 'Answer', text: 'Sim, 100% sua. Não cobramos mensalidades obrigatórias de manutenção nem retemos seu projeto. O código e o domínio pertencem exclusivamente ao seu negócio.' } },
      { '@type': 'Question', name: 'O que vocês precisam de mim para começar?', acceptedAnswer: { '@type': 'Answer', text: 'Apenas de um alinhamento inicial: o que você vende, para quem, quais são seus principais diferenciais e seu número de WhatsApp de atendimento. A partir daí, cuidamos da estrutura, redação, design e publicação técnica.' } },
      { '@type': 'Question', name: 'Em quanto tempo minha página fica pronta?', acceptedAnswer: { '@type': 'Answer', text: 'No plano OCARECADEV Express, entregamos em até 48 horas úteis após o envio das informações básicas. Na Landing que Vende e no Site Profissional, o prazo médio é de 5 a 10 dias úteis, dependendo do escopo e do tempo de alinhamento.' } },
    ],
  },
];
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Agentic Browsing & Descoberta por IA (Padrão llmstxt.org) -->
		<link rel="describedby" href="/llms.txt" />
		<link rel="alternate" type="text/markdown" href="/index.md" />

		<!-- Google Fonts: preconnect + carregamento assíncrono (não bloqueia renderização) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" /></noscript>
		<title>{title}</title>

		<!-- Open Graph / Preview Link Settings (WhatsApp, Meta, LinkedIn, Telegram) -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="OCARECADEV" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="André da OCARECADEV - Landing Pages Estratégicas" />

		<!-- Twitter / X Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

	</head>
	<body>
		<div class="glow-orb glow-orb-1"></div>
		<div class="glow-orb glow-orb-2"></div>
		<div class="glow-orb glow-orb-3"></div>
		<slot />
		<WhatsAppFab />
		<ScarcityToast />
		<ScrollToTop />
		<ScrollIndicator />
		<CookieConsent />
		<script>
			import '../scripts/scrollAnimations.js';
		</script>
		<script>
			import { bootTracking } from '../scripts/tracking.js';

			const trackingConfig = {
				gaId: import.meta.env.PUBLIC_GA_ID,
				googleAdsId: import.meta.env.PUBLIC_GOOGLE_ADS_ID,
				googleAdsConversionLabel: import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL,
				metaPixelId: import.meta.env.PUBLIC_META_PIXEL_ID,
			};
			bootTracking(trackingConfig);
			document.addEventListener('astro:page-load', () => bootTracking(trackingConfig), { once: true });
		</script>
	</body>
</html>
