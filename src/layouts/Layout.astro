---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "OCARECADEV - Máquinas de Geração de Clientes" } = Astro.props;

// URLs absolutas evitam versões duplicadas da página em buscadores e previews sociais.
const siteUrl = Astro.site || Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL('/images/logo-vertical.png', siteUrl);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${siteUrl}#business`,
    name: 'OCARECADEV',
    url: siteUrl.toString(),
    logo: ogImage.toString(),
    image: ogImage.toString(),
    description: 'Criação de landing pages e sites estratégicos para transformar visitantes em contatos e clientes.',
    areaServed: 'Brasil',
    sameAs: [
      'https://www.instagram.com/ocarecadev',
      'https://www.tiktok.com/@ocarecadev',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'OCARECADEV',
    url: siteUrl.toString(),
    inLanguage: 'pt-BR',
    publisher: { '@id': `${siteUrl}#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Preciso entender de tecnologia?', acceptedAnswer: { '@type': 'Answer', text: 'Não. Nós cuidamos de tudo.' } },
      { '@type': 'Question', name: 'Em quanto tempo fica pronto?', acceptedAnswer: { '@type': 'Answer', text: 'A partir de 48h no plano Express.' } },
      { '@type': 'Question', name: 'Vou conseguir editar depois?', acceptedAnswer: { '@type': 'Answer', text: 'Sim, você terá acesso.' } },
      { '@type': 'Question', name: 'Isso realmente funciona?', acceptedAnswer: { '@type': 'Answer', text: 'Funciona quando é feito da forma certa — e é isso que fazemos.' } },
    ],
  },
];

const gaId = import.meta.env.PUBLIC_GA_ID;
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;

const isGaEnabled = gaId && gaId !== 'G-XXXXXXXXXX';
const isPixelEnabled = pixelId && pixelId !== '1234567890';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />

		<!-- Google Fonts: preconnect + carregamento assíncrono (não bloqueia renderização) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" /></noscript>
		<title>{title}</title>

		<!-- Open Graph / Preview Link Settings -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content="OCARECADEV" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalUrl} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<!-- Tracking com Partytown (SPEC-005) -->
		{isGaEnabled && (
			<!-- Google Analytics -->
			<script type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
			<script type="text/partytown" define:vars={{ gaId }}>
			  window.dataLayer = window.dataLayer || [];
			  function gtag(){dataLayer.push(arguments);}
			  gtag('js', new Date());
			  gtag('config', gaId);
			</script>
		)}
		
		{isPixelEnabled && (
			<!-- Meta Pixel -->
			<script type="text/partytown" define:vars={{ pixelId }}>
			  !function(f,b,e,v,n,t,s)
			  {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
			  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
			  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
			  n.queue=[];t=b.createElement(e);t.async=!0;
			  t.src=v;s=b.getElementsByTagName(e)[0];
			  s.parentNode.insertBefore(t,s)}(window, document,'script',
			  'https://connect.facebook.net/en_US/fbevents.js');
			  fbq('init', pixelId);
			  fbq('track', 'PageView');
			</script>
		)}
	</head>
	<body>
		<div class="glow-orb glow-orb-1"></div>
		<div class="glow-orb glow-orb-2"></div>
		<div class="glow-orb glow-orb-3"></div>
		<slot />
		<script src="../scripts/scrollAnimations.js"></script>
	</body>
</html>
