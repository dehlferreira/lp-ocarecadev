>
	<Header />
	<main>
		<Hero />
		<Identification />
		<Problem />
		<Solution />
		<QuickProof />
		<HowItWorks />
		<ModelsShowcase />
		<SocialProof />
		<About />
		<Pricing />
		<FAQ />
		<CtaFinal />
